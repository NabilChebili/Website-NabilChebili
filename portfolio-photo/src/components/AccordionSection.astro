---
import PhotoGrid from "./PhotoGrid.astro";

const { id = "section", title = "", photos = [] } = Astro.props;
const previewPhotos = photos.slice(0, 4);
---

<details class="etape" id={id}>
  <summary class="etape-tete">
    <span class="etape-gauche">
      <span class="etape-signe" aria-hidden="true"></span>
      <span class="etape-titre">{title}</span>
      <span class="etape-compte">{photos.length} photos</span>
    </span>
    <span class="etape-apercu" aria-hidden="true">
      {previewPhotos.map((p) => <img src={p} alt="" loading="lazy" decoding="async" />)}
    </span>
  </summary>
  <div class="etape-corps">
    <PhotoGrid photos={photos} name={title} />
  </div>
</details>

<style>
  /* Une etape est une ligne de sommaire, pas une carte : un filet, aucun fond,
     aucun rayon, aucune ombre. Le degrade, les coins arrondis et les ombres
     portees de la version precedente sont ce que le systeme interdit. */
  .etape {
    border-top: 1px solid var(--rule);
  }

  /* La premiere etape ne porte pas de filet : celui de « Les etapes du
     voyage » est juste au-dessus et borne deja la liste. Elle en avait un a
     l'encre — donc deux traits noirs pleine largeur a 23px d'ecart, pour une
     seule frontiere. Le filet de section ferme l'entete, les filets gris
     separent les etapes entre elles ; personne n'a besoin des deux. */
  .etape:first-of-type {
    border-top: none;
  }

  .etape-tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }
  .etape-tete::-webkit-details-marker {
    display: none;
  }

  .etape-gauche {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-width: 0;
  }

  /* Un signe + qui devient − a l'ouverture. Dessine en CSS : deux filets, donc
     rien a charger et une rotation nette. */
  .etape-signe {
    position: relative;
    flex: 0 0 auto;
    width: 11px;
    height: 11px;
    align-self: center;
  }
  .etape-signe::before,
  .etape-signe::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--ink);
    transition: transform var(--duree) var(--sortie);
  }
  .etape-signe::after {
    transform: rotate(90deg);
  }
  .etape[open] .etape-signe::after {
    transform: rotate(0deg);
  }

  .etape-titre {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }

  .etape-compte {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
    white-space: nowrap;
  }

  .etape-apercu {
    display: flex;
    flex-shrink: 0;
    gap: 6px;
  }
  .etape-apercu img {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: cover;
    background: var(--block);
  }
  .etape[open] .etape-apercu {
    display: none;
  }

  .etape-corps {
    padding-top: 4px;
  }

  @media (max-width: 700px) {
    .etape-titre {
      font-size: 20px;
    }
    .etape-apercu img:nth-child(n + 3) {
      display: none;
    }
  }
</style>
