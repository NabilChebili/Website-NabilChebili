---
// Le contenu de la page Chine une fois ouverte : film, recit, globe, etapes.
// Partage par deux pages :
//   /chine         — apres la sortie, photos du conteneur public (chine.base) ;
//   /chine/apercu  — avant la sortie, photos servies par /api/chine/photo/,
//                    qui ne repond qu'aux adresses IP autorisees dans /admin.
// Seule la base des photos change : le gabarit est le meme, l'apercu montre
// donc exactement ce que la page sera.
import PhotoGrid from "./PhotoGrid.astro";
import AccordionSection from "./AccordionSection.astro";
import BlocVideo from "./BlocVideo.astro";
import CarteVoyage from "./CarteVoyage.astro";
import chine from "../data/chine.json";
import { declarerVignettes, vignetteDe } from "../lib/blobList.js";

const { base, langue } = Astro.props;

const url = (dossier, id) => `${base}${dossier}/${id}.jpg`;

const recit = chine.post.map((p) => ({
  url: url("recit", p.id),
  caption: langue === "en" ? (p.captionEn || p.caption) : p.caption,
}));

// Une entree est un id, ou une rafale { id, serie } : une case qui porte « +N »
// et dont la visionneuse fait defiler les autres prises (voir PhotoGrid).
const photosByKey = Object.fromEntries(
  Object.entries(chine.etapes).map(([cle, items]) => [
    cle,
    items.map((x) =>
      typeof x === "string" ? url(cle, x) : { url: url(cle, x.id), serie: x.serie.map((id) => url(cle, id)) }
    ),
  ])
);

// maj_site.js fabrique une vignette (v/<id>.webp) pour chaque photo de la page,
// et elles partent avec les photos sur le stockage : toutes existent.
declarerVignettes([
  ...recit.map((p) => p.url),
  ...Object.values(photosByKey).flat().flatMap((x) => (typeof x === "string" ? [x] : [x.url, ...x.serie])),
]);

const labels = {
  fr: {
    pekin: "Pékin, la ville",
    muraille: "La Grande Muraille",
    "cite-interdite": "La Cité interdite",
    "temple-du-ciel": "Temple du Ciel et Palais d'été",
    nankin: "Nankin",
    hangzhou: "Hangzhou",
    shaoxing: "Shaoxing",
    shanghai: "Shanghai",
    suzhou: "Suzhou",
  },
  en: {
    pekin: "Beijing, the city",
    muraille: "The Great Wall",
    "cite-interdite": "The Forbidden City",
    "temple-du-ciel": "Temple of Heaven and Summer Palace",
    nankin: "Nanjing",
    hangzhou: "Hangzhou",
    shaoxing: "Shaoxing",
    shanghai: "Shanghai",
    suzhou: "Suzhou",
  },
};

const T = {
  fr: { recit: "Le récit", etapes: "Les étapes du voyage" },
  en: { recit: "The story", etapes: "Stops along the way" },
};
const c = T[langue];
const nomsEtapes = labels[langue];

// Meme regle que /vietnam : la carte fixe l'ordre du voyage, la liste suit.
const surLaCarte = chine.carte.flatMap((p) => p.etapes);
const ordreEtapes = [
  ...surLaCarte.filter((k) => k in chine.etapes),
  ...Object.keys(chine.etapes).filter((k) => !surLaCarte.includes(k)),
];
const points = chine.carte.map((p) => ({
  ...p,
  lieu: langue === "en" ? (p.lieuEn ?? p.lieu) : p.lieu,
  etapes: p.etapes.map((id) => ({ id, titre: nomsEtapes[id] ?? id })),
}));
const couverture = url("recit", chine.couverture.split("/").pop());
---

{(chine.video.id || chine.video.sortie) && (
  <BlocVideo
    id={chine.video.id}
    titre={chine.video.titre}
    lang={langue}
    sortie={chine.video.sortie}
    fond={vignetteDe(couverture) ?? couverture}
  />
)}

<section>
  <div class="section-head" data-reveal data-groupe="recit">
    <span>{c.recit}</span>
    <span>({recit.length})</span>
  </div>
  <div class="galerie">
    <PhotoGrid photos={recit} name="Chine" lang={langue} />
  </div>
</section>

<section>
  <div class="section-head" data-reveal data-groupe="etapes">
    <span>{c.etapes}</span>
    <span>({ordreEtapes.length})</span>
  </div>
  <CarteVoyage points={points} pays="156" lang={langue} />
  <div class="etapes">
    {
      ordreEtapes.map((key) => (
        <AccordionSection
          id={key}
          groupe="etapes"
          numero={chine.carte.findIndex((p) => p.etapes.includes(key)) + 1 || undefined}
          title={nomsEtapes[key] ?? key}
          photos={photosByKey[key]}
          lang={langue}
        />
      ))
    }
  </div>
</section>

<style>
  .galerie,
  .etapes {
    padding: 0 var(--edge);
  }
  .etapes {
    padding-top: var(--pas-3);
  }
</style>
