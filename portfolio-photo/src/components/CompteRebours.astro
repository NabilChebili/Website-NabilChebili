---
// Le gros compteur de /chine tant que la galerie est fermee (lib/chineOuverte.js) :
// toute la largeur, chiffres geants, sur l'image tres floutee de la couverture
// (public/chine-verrou.webp, rien de reconnaissable). Nabil, 24/11 : « un gros
// compteur sur la page, pas juste sur le film ».
const { sortie, lang = "fr" } = Astro.props;
const date = new Date(sortie);

const T = {
  fr: {
    annonce: "Le teaser et la galerie sortent le",
    unites: ["jours", "heures", "minutes", "secondes"],
    fin: "C'est en ligne",
    chaine: "Voir la chaîne YouTube",
  },
  en: {
    annonce: "The teaser and the gallery come out on",
    unites: ["days", "hours", "minutes", "seconds"],
    fin: "It's out",
    chaine: "See the YouTube channel",
  },
};
const c = T[lang] ?? T.fr;
const quand = date.toLocaleString(lang === "en" ? "en-GB" : "fr-FR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "Europe/Paris",
});
---

<section class="compte" data-sortie={date.toISOString()} data-fin={c.fin}>
  <img class="compte-fond" src="/chine-verrou.webp" alt="" decoding="async" />
  <div class="compte-corps">
    <p class="compte-annonce">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <rect x="5" y="10.5" width="14" height="10" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span>{c.annonce} {quand}</span>
    </p>
    <p class="compte-chiffres" aria-live="off">
      {c.unites.map((u) => (
        <span class="compte-case"><b>--</b><small>{u}</small></span>
      ))}
    </p>
    <a class="compte-lien" href="https://www.youtube.com/@Nabs-world" target="_blank" rel="noopener">
      <span>{c.chaine}</span><i aria-hidden="true">&#8599;</i>
    </a>
  </div>
</section>

<script>
  for (const el of document.querySelectorAll<HTMLElement>(".compte[data-sortie]")) {
    const fin = Date.parse(el.dataset.sortie!);
    const cases = [...el.querySelectorAll("b")];
    let minuteur: number | undefined;
    const pas = () => {
      const r = Math.max(0, Math.floor((fin - Date.now()) / 1000));
      if (!r) {
        el.querySelector(".compte-chiffres")!.textContent = el.dataset.fin!;
        clearInterval(minuteur);
        return;
      }
      const v = [Math.floor(r / 86400), Math.floor(r / 3600) % 24, Math.floor(r / 60) % 60, r % 60];
      v.forEach((n, i) => (cases[i].textContent = String(n).padStart(2, "0")));
    };
    pas();
    minuteur = window.setInterval(pas, 1000);
  }
</script>

<style>
  .compte {
    position: relative;
    overflow: hidden;
    margin: var(--pas-3) var(--edge);
    background: var(--ink);
    color: #fff;
  }
  .compte-fond {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }
  .compte-corps {
    position: relative;
    padding: clamp(28px, 6vw, 96px) clamp(18px, 4vw, 56px);
  }
  .compte-annonce {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .compte-chiffres {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: 0 clamp(8px, 2vw, 32px);
    margin: clamp(18px, 3vw, 40px) 0;
    padding: clamp(12px, 2vw, 24px) 0;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(28px, 5vw, 64px);
    font-weight: 800;
    text-transform: uppercase;
  }
  .compte-case {
    display: grid;
    gap: 6px;
  }
  .compte-case b {
    font-size: clamp(64px, 15vw, 240px);
    font-weight: 800;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }
  .compte-case small {
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(10px, 1.1vw, 13px);
    font-weight: 700;
    letter-spacing: 0.09em;
  }
  .compte-lien {
    display: inline-flex;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .compte-lien:hover,
  .compte-lien:focus-visible {
    border-bottom-color: currentColor;
  }
</style>
