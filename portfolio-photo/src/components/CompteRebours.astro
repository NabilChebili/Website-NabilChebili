---
// Le gros compteur de /chine tant que la galerie est fermee (lib/chineOuverte.js).
// Nabil, 24/11 : « un gros compteur sur la page », puis « un meilleur compteur,
// sans le fond ». Donc a l'encre sur le papier, comme le reste du site : quatre
// colonnes separees par des filets, chiffres geants qui roulent a chaque
// changement, et une barre fine qui se remplit jusqu'a la sortie.
const { sortie, debut = "2026-11-24T00:00:00+01:00", lang = "fr" } = Astro.props;
const date = new Date(sortie);

const T = {
  fr: {
    surtitre: "Bientôt",
    annonce: "Le teaser et la galerie sortent le",
    unites: ["Jours", "Heures", "Minutes", "Secondes"],
    fin: "C'est en ligne",
    chaine: "Voir la chaîne YouTube",
  },
  en: {
    surtitre: "Coming soon",
    annonce: "The teaser and the gallery come out on",
    unites: ["Days", "Hours", "Minutes", "Seconds"],
    fin: "It's out",
    chaine: "See the YouTube channel",
  },
};
const c = T[lang] ?? T.fr;
const quand = date.toLocaleString(lang === "en" ? "en-GB" : "fr-FR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "Europe/Paris",
});
---

<section class="compte" data-sortie={date.toISOString()} data-debut={new Date(debut).toISOString()} data-fin={c.fin}>
  <div class="compte-tete">
    <span class="compte-surtitre">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <rect x="5" y="10.5" width="14" height="10" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" fill="none" stroke="currentColor" stroke-width="1.8" />
      </svg>
      {c.surtitre}
    </span>
    <span>{c.annonce} {quand}</span>
  </div>

  <div class="compte-chiffres" role="timer" aria-live="off">
    {c.unites.map((u) => (
      <div class="compte-case">
        <span class="compte-nombre"><span>--</span></span>
        <span class="compte-unite">{u}</span>
      </div>
    ))}
  </div>

  <div class="compte-barre" aria-hidden="true"><span></span></div>

  <a class="compte-lien" href="https://www.youtube.com/@Nabs-world" target="_blank" rel="noopener">
    <span>{c.chaine}</span><i aria-hidden="true">&#8599;</i>
  </a>
</section>

<script>
  for (const el of document.querySelectorAll<HTMLElement>(".compte[data-sortie]")) {
    const fin = Date.parse(el.dataset.sortie!);
    const debut = Date.parse(el.dataset.debut!);
    const nombres = [...el.querySelectorAll<HTMLElement>(".compte-nombre")];
    const barre = el.querySelector<HTMLElement>(".compte-barre span")!;
    const doux = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    let minuteur: number | undefined;

    // Un chiffre qui change monte et sort par le haut, le nouveau arrive du bas.
    const poser = (case_: HTMLElement, texte: string) => {
      const actuel = case_.lastElementChild as HTMLElement;
      if (actuel.textContent === texte) return;
      if (!doux || actuel.textContent === "--") {
        actuel.textContent = texte;
        return;
      }
      const nouveau = document.createElement("span");
      nouveau.textContent = texte;
      nouveau.className = "entre";
      actuel.className = "sort";
      case_.append(nouveau);
      setTimeout(() => actuel.remove(), 450);
    };

    const pas = () => {
      const maintenant = Date.now();
      const r = Math.max(0, Math.floor((fin - maintenant) / 1000));
      barre.style.transform = `scaleX(${Math.min(1, Math.max(0, (maintenant - debut) / (fin - debut)))})`;
      if (!r) {
        el.querySelector(".compte-chiffres")!.textContent = el.dataset.fin!;
        clearInterval(minuteur);
        return;
      }
      const v = [Math.floor(r / 86400), Math.floor(r / 3600) % 24, Math.floor(r / 60) % 60, r % 60];
      v.forEach((n, i) => poser(nombres[i], String(n).padStart(2, "0")));
    };
    pas();
    minuteur = window.setInterval(pas, 1000);
  }
</script>

<style>
  .compte {
    margin: var(--pas-3) var(--edge) var(--pas-4, 96px);
    border-top: 2px solid var(--ink);
    color: var(--ink);
  }

  .compte-tete {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .compte-surtitre {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 7px;
    background: var(--ink);
    color: var(--paper);
  }

  .compte-chiffres {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(40px, 8vw, 96px);
    font-weight: 800;
    text-transform: uppercase;
  }
  .compte-case {
    display: grid;
    gap: 10px;
    padding: clamp(16px, 2.5vw, 32px) clamp(8px, 1.6vw, 24px) clamp(14px, 2vw, 24px);
    border-left: 1px solid var(--rule);
  }
  .compte-case:first-child {
    padding-left: 0;
    border-left: none;
  }

  /* Le nombre : une fenetre d'une ligne, ou les chiffres roulent. */
  .compte-nombre {
    position: relative;
    display: block;
    height: 0.86em;
    overflow: hidden;
    font-size: clamp(64px, 12.5vw, 210px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .compte-nombre span {
    display: block;
  }
  .compte-nombre .sort,
  .compte-nombre .entre {
    position: absolute;
    inset: 0 auto auto 0;
  }
  .compte-nombre .sort {
    animation: compte-sort 0.45s var(--sortie, cubic-bezier(0.2, 0.7, 0.2, 1)) forwards;
  }
  .compte-nombre .entre {
    animation: compte-entre 0.45s var(--sortie, cubic-bezier(0.2, 0.7, 0.2, 1)) both;
  }
  @keyframes compte-sort {
    to {
      transform: translateY(-100%);
      opacity: 0;
    }
  }
  @keyframes compte-entre {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  .compte-unite {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: var(--ink-55);
  }

  /* La barre : du 24/11 a la sortie, elle se remplit a l'encre. */
  .compte-barre {
    height: 2px;
    background: var(--rule);
  }
  .compte-barre span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .compte-lien {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    margin-top: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition: background-size var(--duree-longue, 0.4s) var(--sortie, ease);
  }
  .compte-lien:hover,
  .compte-lien:focus-visible {
    background-size: 100% 1px;
  }
  .compte-lien i {
    font-style: normal;
  }

  @media (max-width: 700px) {
    .compte-chiffres {
      grid-template-columns: repeat(2, 1fr);
    }
    .compte-case:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }
    .compte-case:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
    .compte-nombre {
      font-size: clamp(64px, 27vw, 140px);
    }
  }
</style>
