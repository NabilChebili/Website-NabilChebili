---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import PhotoGrid from "./PhotoGrid.astro";
import { listBlobsFromPublicContainer } from "../lib/blobList.js";

// photo.css n'est plus importee ici : PhotoGrid style lui-meme la grille, les
// cartes, la visionneuse et le bouton de telechargement. Ce qui restait dans
// photo.css etait soit mort, soit nuisible — un `.section-head` qui entrait en
// collision avec celui du systeme editorial, et un `.fade-img { opacity: 0 }`
// qui ne se levait que sous un ancetre `.gallery-section` absent d'ici.

const {
  title,
  description = `Galerie photo : ${title}.`,
  intro = "",
  galleryUrl = "",
  fallback = ["/photos/A7401177.jpg", "/photos/A7401113.jpg", "/photos/A7401167.jpg", "/photos/A7401181.jpg"],
  password = null,
} = Astro.props;

const listed = galleryUrl ? await listBlobsFromPublicContainer(galleryUrl) : [];
const photos = listed.length ? listed : fallback;
---

<Layout title={title} description={description} mainClass="page editorial">
  {password ? (
    <div class="password-gate" id="password-gate">
      <div class="password-gate-box">
        <p>Cette galerie est temporairement protégée.</p>
        <input type="password" id="password-gate-input" placeholder="Mot de passe" autocomplete="off" />
        <button id="password-gate-submit" type="button">Voir les photos</button>
        <p class="password-gate-error" id="password-gate-error" hidden>Mot de passe incorrect.</p>
      </div>
    </div>
  ) : null}

  <div class:list={["gated-content", { "is-locked": password }]} id="gated-content">
    <section class="tete-page">
      <a class="retour" href="/photo">← Toutes les galeries</a>
      <h1 class="titre-page" data-reveal data-groupe="tete">{title}</h1>
      {intro ? (
        <div class="prose" data-reveal data-groupe="tete">
          <p>{intro}</p>
        </div>
      ) : null}
    </section>

    <section>
      <div class="section-head" data-reveal data-groupe="galerie">
        <span>Photographies</span>
        <span>({photos.length})</span>
      </div>
      <div class="galerie">
        <PhotoGrid photos={photos} name={title} />
      </div>
    </section>
  </div>

  {password ? (
    <script define:vars={{ password, storageKey: `gate_unlocked_${title}` }}>
      (function () {
        const gate = document.getElementById("password-gate");
        const content = document.getElementById("gated-content");
        const input = document.getElementById("password-gate-input");
        const submit = document.getElementById("password-gate-submit");
        const error = document.getElementById("password-gate-error");
        if (!gate || !content || !input || !submit) return;

        function unlock() {
          gate.style.display = "none";
          content.classList.remove("is-locked");
          try {
            localStorage.setItem(storageKey, "1");
          } catch (e) {}
        }

        try {
          if (localStorage.getItem(storageKey) === "1") unlock();
        } catch (e) {}

        function tryUnlock() {
          if (input.value === password) {
            unlock();
          } else {
            error.hidden = false;
            input.value = "";
            input.focus();
          }
        }

        submit.addEventListener("click", tryUnlock);
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") tryUnlock();
        });
      })();
    </script>
  ) : null}
</Layout>

<style>
  .galerie {
    padding: 0 var(--edge);
  }

  .gated-content.is-locked {
    filter: blur(22px);
    pointer-events: none;
    user-select: none;
  }

  /* Le voile reprend le vocabulaire du systeme : fond papier, filet a l'encre,
     aucun coin arrondi ni ombre portee. */
  .password-gate {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(244, 244, 242, 0.82);
  }

  .password-gate-box {
    width: min(360px, calc(100vw - 2 * var(--edge)));
    padding: var(--pas-3);
    background: var(--paper);
    border: 1px solid var(--ink);
  }

  .password-gate-box p {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  .password-gate-box input {
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 12px;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: var(--paper);
    font: inherit;
    font-size: 15px;
    color: var(--ink);
  }
  .password-gate-box input:focus-visible {
    outline: none;
    border-color: var(--ink);
  }

  .password-gate-box button {
    width: 100%;
    padding: 11px 12px;
    border: none;
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .password-gate-error {
    margin: 10px 0 0;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }
</style>
