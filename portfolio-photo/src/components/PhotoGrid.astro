    gap: 12px;
    margin: 0;
  }

  /* Le masquage ne s'applique que si le script tourne — le drapeau reveal-ok est
     pose par header.astro avant le rendu. Sans JavaScript les 24 cartes d'une
     galerie restaient invisibles pour toujours : la page ne montrait rien. */
  :global(.reveal-ok) .photo-card {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity var(--duree-longue) var(--sortie),
      transform var(--duree-longue) var(--sortie);
    transition-delay: calc(var(--i, 0) * 60ms);
  }
  :global(.reveal-ok) .photo-card.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.reveal-ok) .photo-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .photo-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--block);
    cursor: zoom-in;
  }

  /* La legende est du texte lu, donc Sofia Sans comme .prose — elle heritait
     du mono, ce qui la rendait illisible sur une colonne de 256px : 22
     caracteres par ligne, contre les 45-75 de la fourchette de Bringhurst.

     Et elle etait a 15px, exactement la taille de l'intro de la page : une
     legende aussi forte que le texte qu'elle sert. 13px la remet sous
     l'intro sans descendre au niveau des etiquettes (11px).

     Pas de margin ici : la carte est un flex column a gap 12px, elle en a
     donc deja un. J'avais lu `margin-top: 0` et conclu « collee a la
     photo » sans regarder le conteneur — la marge que j'y avais ajoutee
     s'empilait sur le gap et portait l'ecart a 22px. */
  .photo-card figcaption {
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-55);
  }

  @media (max-width: 700px) {
    .photo-grid-cards {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: var(--pas-3) 12px;
    }
  }

  /* ===================================================================
     Visionneuse

     La visionneuse est un autre mode : le fond sombre y est deliberement
     conserve, c'est ce qui fait exister la photo. Seuls le rayon et l'ombre
     partent.
     =================================================================== */
  .photo-grid .lightbox {
    position: fixed;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* `visibility` differee jusqu'a la fin du fondu : sans elle, les trois vues
       restent composees en permanence sur les onze galeries, et une page comme
       Vietnam en compte une par etape. */
    transition: opacity 180ms var(--sortie), visibility 0s linear 180ms;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    z-index: 2000;
  }
  .photo-grid .lightbox.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 180ms var(--sortie), visibility 0s;
  }

  /* Le fond est une boite a lui, et non l'opacite de la visionneuse entiere :
     pendant la descente il s'efface tout seul, pendant que la photo, elle,
     reste pleinement visible jusqu'a son atterrissage sur la vignette.

     Une vraie boite et non un `::before` : le pseudo-element ne se peint pas
     des que sa couleur est semi-transparente dans le navigateur integre, alors
     qu'il se peint en aplat opaque et qu'un element reel de la meme couleur se
