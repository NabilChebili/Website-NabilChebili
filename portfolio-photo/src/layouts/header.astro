---
import "../styles/layout.css";
import "../styles/editorial.css";

const {
	title = "Nabil Chebili",
	description =
		"Portfolio de Nabil Chebili : Cloud & DevOps (Azure), photographie et musique. Projets, retours d’expérience et galeries.",
	image = "/LogoRond.svg",
	ogType = "website",
	// Les deux familles du systeme editorial. Chargees partout depuis que le
	// style couvre l'ensemble du site : la pile systeme ne ferait plus le
	// travail sur aucune page.
	webfont = true,
	// Classe portee par le <main>. Les pages n'emettent plus le leur : il y en
	// avait deux imbriques sur chaque page, ce que le HTML interdit.
	mainClass = "page",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.nabilchebili.fr");
const canonicalUrl = Astro.url && siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const ogImageUrl = siteUrl ? new URL(image, siteUrl).href : image;

const fullTitle = String(title).includes("Nabil Chebili") ? String(title) : `${title} — Nabil Chebili`;

// Les crochets de la nav signalent une destination. L'entree de la page ouverte
// n'en porte donc pas — on y est deja — et ne se souligne pas au survol. La
// correspondance est exacte : /vietnam ne marque pas /photo comme courant.
const chemin = (Astro.url?.pathname ?? "/").replace(/\/+$/, "") || "/";
const sections = [
	{ href: "/clouddevops", label: "Cloud DevOps" },
	{ href: "/photo", label: "Photo" },
	{ href: "/musique", label: "Musique" },
	{ href: "/gaming", label: "Gaming" },
];

const schemaPerson = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Nabil Chebili",
	url: siteUrl?.href,
	image: ogImageUrl,
	jobTitle: "Ingénieur Cloud / DevOps",
	sameAs: ["https://www.linkedin.com/in/chebili-nabil/"],
};

const schemaWebsite = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Nabil Chebili",
	url: siteUrl?.href,
};
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/LogoRond.svg" />
		<meta name="generator" content={Astro.generator} />

		{
			webfont ? (
				<>
					<link rel="preconnect" href="https://fonts.googleapis.com" />
					<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
					<link
						href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Sofia+Sans:wght@400;600&family=Sofia+Sans+Condensed:wght@800&display=swap"
						rel="stylesheet"
					/>
				</>
			) : null
		}
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow" />
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}

		<meta property="og:site_name" content="Nabil Chebili" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta property="og:type" content={ogType} />
		<meta property="og:image" content={ogImageUrl} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json">{JSON.stringify(schemaPerson)}</script>
		<script type="application/ld+json">{JSON.stringify(schemaWebsite)}</script>
		<script is:inline>
			// Pose avant le rendu : les elements a reveler ne sont masques que si le
			// script tourne. Sans JavaScript, rien n'est cache.
			document.documentElement.classList.add("reveal-ok");
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<div class="brand">
					<a href="/">Nabil Chebili</a>
				</div>
				<div class="nav-wrap">
					<a class="nav-home" href="/" aria-current={chemin === "/" ? "page" : undefined}>Accueil</a>
					<button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Ouvrir le menu">
						<span class="hamburger" aria-hidden="true">☰</span>
					</button>
					<nav id="site-nav" class="site-nav" aria-label="Sections">
						{
							sections.map((s) => (
								// Aucun blanc entre <a> et <span> : Astro ne le supprime pas,
								// et il se voit comme un decalage du libelle sur l entree
								// courante, qui n a pas de crochet pour l absorber.
								<a href={s.href} aria-current={chemin === s.href ? "page" : undefined}><span>{s.label}</span></a>
							))
						}
					</nav>
				</div>
			</div>
		</header>

		<main class={mainClass}>
			<slot />
		</main>

		<section class="section footer-nav">
			<div class="container">
				<nav aria-label="Navigation finale">
				<a href="/photo">Photographie</a> · <a href="/clouddevops">Cloud DevOps</a> · <a
					href="/musique">Musique</a
				> · <a href="/gaming">Gaming</a>
				</nav>
			</div>
		</section>

		<footer class="site-footer">
			<div class="container">© {new Date().getFullYear()} — Nabil Chebili</div>
		</footer>

		<script>
			(function () {
				const btn = document.querySelector('.nav-toggle');
				const nav = document.getElementById('site-nav');
				const wrap = document.querySelector('.nav-wrap');
				if (!btn || !nav || !wrap) return;
				btn.addEventListener('click', () => {
					const expanded = btn.getAttribute('aria-expanded') === 'true';
					btn.setAttribute('aria-expanded', String(!expanded));
					nav.classList.toggle('open');
					wrap.classList.toggle('open');
				});
			})();
		</script>
		<script>
		// Revelation au premier passage, jamais annulee. C'est le motif d'AOS et de
		// Motion : `once: true`. Une timeline de defilement, elle, remet l'element
		// dans son etat initial des qu'il sort de la plage — donc le texte
		// redevenait invisible. Ici l'observateur retire sa surveillance apres le
		// premier passage : plus rien ne peut re-masquer un contenu.
		(function () {
		const cibles = Array.from(document.querySelectorAll("[data-reveal]"));
		if (!cibles.length) return;

		const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const montre = (el) => el.classList.add("vu");

		if (reduit || !("IntersectionObserver" in window)) {
		cibles.forEach(montre);
		return;
		}

		// Cascade de 80ms a l'interieur d'un meme groupe, plafonnee : une liste
		// longue avec un decalage cumulatif finirait par durer plusieurs secondes.
		const rangs = new Map();
		const rang = (el) => {
		const g = el.dataset.groupe || "seul";
		const n = rangs.get(g) || 0;
		rangs.set(g, n + 1);
		return Math.min(n, 5);
		};

		const io = new IntersectionObserver(
		(entrees) => {
		entrees.forEach((e) => {
		if (!e.isIntersecting) return;
		io.unobserve(e.target);
		e.target.style.transitionDelay = rang(e.target) * 80 + "ms";
		// Le texte se revele tout de suite : le prendre en otage d'une image
		// le rendrait invisible pendant tout un chargement lent.
		montre(e.target);
		// L'obturateur, lui, n'attend que son image. Il ne s'ouvre donc
		// jamais sur un cadre vide, et une image en echec l'ouvre quand meme
		// plutot que de laisser un rectangle gris definitif.
		e.target.querySelectorAll("img").forEach((im) => {
		const prete = () => e.target.classList.add("img-prete");
		if (im.complete) return prete();
		im.addEventListener("load", prete, { once: true });
		im.addEventListener("error", prete, { once: true });
		});
		});
		},
		// Zone de detection = la fenetre entiere, sans retrait.
		//
		// Il y avait ici -120px en bas, l'offset par defaut d'AOS. Une marge
		// NEGATIVE retrecit la zone : un element devait etre remonte de 120px
		// au-dessus du bord inferieur pour compter comme visible. Consequence,
		// tout ce qui tombait dans cette bande au chargement restait a
		// l'opacite 0 alors qu'on le voyait a l'ecran — un titre de section
		// pouvait donc laisser une bande blanche tant qu'on n'avait pas
		// defile. Sur l'accueil en 1080px de haut, « Explorer » atterrissait a
		// 83px du bas et disparaissait ainsi.
		//
		// A 0, un element se revele des qu'il touche la fenetre : rien de
		// visible ne reste jamais masque, et la revelation au defilement joue
		// toujours pour ce qui arrive d'en dessous.
		{ rootMargin: "0px", threshold: 0 }
		);

		cibles.forEach((el) => io.observe(el));
		})();
		</script>
	</body>
</html>
