---
import "../../styles/global.css";
import Layout from "../../layouts/header.astro";
import CompteRebours from "../../components/CompteRebours.astro";
import ChineContenu from "../../components/ChineContenu.astro";
import Commentaires from "../../components/Commentaires.astro";
import chine from "../../data/chine.json";
import { cheminLocalise, cheminsDesLangues, langueDepuisParam, traduire } from "../../i18n/ui";
import { chineOuverte } from "../../lib/chineOuverte.js";

export function getStaticPaths() {
  return cheminsDesLangues();
}

const langue = langueDepuisParam(Astro.params.lang);
const t = traduire(langue);

// Contrairement a /vietnam et /indonesie, les fichiers sont listes dans
// chine.json au lieu d'etre lus dans le stockage au build : la selection vient
// de la serie photo notee, et la page se construit (et se previsualise) avant
// meme que les photos soient envoyees. CHINE_PHOTOS_LOCAL=1 au `astro dev` les
// sert depuis public/_apercu-chine/ (dossier ignore par git).
//
// Le contenu lui-meme vit dans components/ChineContenu.astro, partage avec
// /chine/apercu : l'acces anticipe, par adresse IP, avant la sortie.
const base = process.env.CHINE_PHOTOS_LOCAL ? "/_apercu-chine/" : chine.base;

const T = {
  fr: {
    titre: "Chine",
    description:
      "Récit photo de quinze jours en Chine, de Pékin à Shanghai en train : la Grande Muraille, la Cité interdite, Nankin, Hangzhou, Shaoxing et Suzhou.",
    intro:
      "Quinze jours en novembre, de Pékin à Shanghai, en train : la Grande Muraille, les hutongs, Nankin, les lacs de Hangzhou et les canaux de Shaoxing.",
    avantPremiere: "Voir les photos en avant-première",
  },
  en: {
    titre: "China",
    description:
      "A photo story of fifteen days in China, from Beijing to Shanghai by train: the Great Wall, the Forbidden City, Nanjing, Hangzhou, Shaoxing and Suzhou.",
    intro:
      "Fifteen days in November, Beijing to Shanghai by train: the Great Wall, the hutongs, Nanjing, the lakes of Hangzhou and the canals of Shaoxing.",
    avantPremiere: "See the photos ahead of release",
  },
};
const c = T[langue];
---

<Layout title={c.titre} description={c.description} mainClass="page editorial" lang={langue} image={chineOuverte ? `${base}recit/${chine.post[0]?.id}.jpg` : undefined}>
  <section class="tete-page">
    <a class="retour" href={cheminLocalise("/photo", langue)}>{t("retour.galeries")}</a>
    <h1 class="titre-page" data-reveal data-groupe="tete">{c.titre}</h1>
    <div class="prose" data-reveal data-groupe="tete">
      <p>{c.intro}</p>
    </div>
  </section>

  {!chineOuverte && <CompteRebours sortie={chine.video.sortie} lang={langue} />}

  {/* Visible seulement pour une adresse IP autorisee dans /admin : l'API le dit,
      la page ne fait que montrer le chemin. Les photos restent protegees par
      l'API elle-meme, pas par ce bouton. */}
  {!chineOuverte && (
    <div class="avant-premiere" data-avant-premiere hidden>
      <a class="bouton" href={cheminLocalise("/chine/apercu", langue)}>{c.avantPremiere}</a>
    </div>
  )}

  {chineOuverte && <ChineContenu base={base} langue={langue} />}
  {chineOuverte && <Commentaires page="chine" lang={langue} />}
</Layout>

<style>
  .avant-premiere {
    margin: calc(-1 * var(--pas-6)) var(--edge) var(--pas-8);
  }
</style>

<script>
  const lien = document.querySelector<HTMLElement>("[data-avant-premiere]");
  if (lien) {
    fetch("/api/chine/acces")
      .then((r) => (r.ok ? r.json() : null))
      .then((r) => {
        if (r?.acces) lien.hidden = false;
      })
      .catch(() => {});
  }
</script>
