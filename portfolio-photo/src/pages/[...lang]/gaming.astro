---
import "../../styles/global.css";
import Layout from "../../layouts/header.astro";
import Colophon from "../../components/Colophon.astro";
import { cheminLocalise, cheminsDesLangues, langueDepuisParam } from "../../i18n/ui";

export function getStaticPaths() {
	return cheminsDesLangues();
}

const langue = langueDepuisParam(Astro.params.lang);

/* Relevé local, arrêté au 25/08/2026 : localconfig.vdf et appmanifest_*.acf pour
   Steam, manifestes Epic, RiotClientInstalls.json, GOG, .minecraft, et la
   collection de scènes OBS pour ce qui touche au direct.

   La page vend la chaîne, pas le compteur d'heures : les chiffres ne sont là que
   pour appuyer une idée — on n'y joue jamais seul. */

const TWITCH = "https://www.twitch.tv/nabsland";

/* Le défilé du haut : tout ce qui est passé sur cette machine, sans hiérarchie.
   C'est le seul moment de la page — un mur de titres qui ne s'arrête pas. */
const defile = [
	[
		"League of Legends", "Rocket League", "Phasmophobia", "Counter-Strike 2",
		"Minecraft", "Lethal Company", "Among Us", "Valorant", "Fall Guys",
		"Satisfactory", "Garry's Mod", "Content Warning", "Halo Infinite",
		"Brawlhalla", "Overcooked! 2", "Escape the Backrooms", "PEAK",
		"Street Fighter 6", "Teamfight Tactics", "Golf With Your Friends",
		"Chained Together", "DEVOUR", "Portal 2", "Unrailed!", "Moving Out",
		"Demonologist", "Trackmania",
	],
	[
		"Escape Simulator", "The Escapists 2", "Labyrinthine", "Battlefield 6",
		"Ready or Not", "Destiny 2", "Warframe", "Paladins", "SMITE",
		"Lost Ark", "V Rising", "shapez 2", "Civilization VI", "Bendy and the Ink Machine",
		"Orcs Must Die! 3", "Escape Academy", "Doors – Paradox", "PANICORE",
		"Inside the Backrooms", "Backrooms : Escape Together", "Golf It!",
		"Fear the Spotlight", "Sonic Mania", "Toribash", "Besiege", "BroForce",
	],
	[
		"Half-Life: Alyx", "Death Stranding", "The Last of Us Part II",
		"Ghost of Tsushima", "Until Dawn", "A Plague Tale: Requiem",
		"Horizon Zero Dawn", "Kena: Bridge of Spirits", "Ghostrunner 2",
		"Crusader Kings III", "The Sims 4", "FIFA", "Rayman Legends",
		"Ghost Recon Wildlands", "Call of Duty: Modern Warfare", "Just Cause 3",
		"REANIMAL", "Escape Simulator 2", "CloverPit", "911 Operator",
		"Halo: Campaign Evolved", "Delta Force", "Throne and Liberty",
	],
];

const T = {
	fr: {
		description:
			"NabsLand sur Twitch : du League of Legends, du Rocket League et de l'horreur coopérative — en direct depuis 2020, et toujours à plusieurs.",
		statut: "Affilié Twitch",
		depuis: "en direct depuis",
		intro1:
			"Je joue depuis toujours, sans que ça prenne toute la place — mais c'est une des choses qui m'ont façonné. Ce n'est jamais le jeu qui m'a retenu : c'est ce qu'il permet. Se retrouver quelque part, avec des amis de quinze ans comme avec des gens croisés le soir même.",
		intro2a: "Depuis avril 2020, ça se passe en direct sur Twitch, sous le nom de",
		intro2b: ": League of Legends, Rocket League, et beaucoup de jeux d'horreur à plusieurs.",
		regarder: "Regarder la chaîne",
		defileTitre: "Tout ce qui est passé par là",
		titres: "titres",
		chapitre1: "La chaîne",
		chaine1:
			"La chaîne a six ans. Elle n'a jamais eu de plan de carrière : c'était au départ un moyen de garder le contact quand on ne pouvait plus se voir. Depuis, elle sert surtout à agrandir la table — il y a toujours une place libre en vocal, et il n'a jamais fallu être bon pour la prendre.",
		chaine2:
			"Il y a une scène montée pour deux caméras, parce que la moitié des streams se fait à deux. Une autre au format vertical, pour ce qui part sur TikTok. Le reste — alertes, compteur d'abonnés, mur d'émoticônes — c'est de la cuisine interne, mais elle dit assez bien que ce n'est pas improvisé.",
		passer: "Passer sur la chaîne",
		guitare: "— et s'il m'arrive d'y poser une guitare, ça se raconte plutôt du",
		coteMusique: "côté musique",
		suivre: "Suivre NabsLand",
		chapitre2: "On n'y joue jamais seul",
		douzeTitres: "12 titres",
		ensemble1:
			"Le relevé est sans appel : les jeux solo de la bibliothèque sont presque tous abandonnés au bout de quelques heures, pendant que les jeux à plusieurs se comptent en centaines. Ce n'est pas un hasard de goût, c'est la raison d'allumer le PC.",
		ensemble2a:
			"Derrière tout ça il y a un Discord qui tourne depuis des années, où les habitués croisent des gens arrivés la veille. Le jeu n'est souvent qu'un prétexte à la salle vocale :",
		ensemble2b: "attache littéralement les joueurs les uns aux autres — c'est à peu près l'idée.",
		chapitre3: "Ça vient de loin",
		jalonsTexte1: "Onze ans de relevé,",
		jalonsHeures: "4 635 heures",
		jalonsTexte2:
			"sur une centaine de titres. Ce n'est pas un trophée, et ça n'a jamais été un mode de vie : c'est simplement assez long pour compter dans ce qu'on devient. Les jeux ont changé bien plus souvent que les raisons d'y jouer.",
		chaine: [
			{ k: "En direct depuis", v: "Avril 2020" },
			{ k: "Statut", v: "Affilié" },
			{ k: "Scènes montées", v: "9" },
			{ k: "Dernier passage", v: "Halo" },
		],
		auProgramme: [
			{ nom: "League of Legends", note: "Salé#9891 — la plus vieille habitude, jouée hier soir encore" },
			{ nom: "Rocket League", note: "2 440 h au compteur. Des voitures, une balle, aucun plafond" },
			{ nom: "Horreur coopérative", note: "Phasmophobia, Lethal Company, Content Warning — l'intérêt n'est pas d'avoir peur, c'est d'entendre les autres avoir peur" },
			{ nom: "Le reste", note: "Party games, salles d'énigmes, retours en arrière sur des jeux Xbox 360" },
		],
		jalons: [
			{ an: "2015", fait: "Minecraft en 1.8.9, et les premières heures de Rocket League" },
			{ an: "2020", fait: "Ouverture de la chaîne Twitch, en avril" },
			{ an: "2024", fait: "Montage des VOD, passage au format vertical pour TikTok" },
			{ an: "2026", fait: "Plus de jeu principal : de l'horreur à plusieurs, du Rocket League, un Halo de 2007 — ce qui fait envie sur le moment" },
		],
	},
	en: {
		description:
			"NabsLand on Twitch: League of Legends, Rocket League and co-op horror — live since 2020, and never on my own.",
		statut: "Twitch Affiliate",
		depuis: "live since",
		intro1:
			"I've always played, without it taking over — but it is one of the things that shaped me. It was never the game that held me: it's what the game makes possible. Being somewhere together, with friends of fifteen years and with people met that same evening.",
		intro2a: "Since April 2020 it happens live on Twitch, under the name",
		intro2b: ": League of Legends, Rocket League, and a great deal of co-op horror.",
		regarder: "Watch the channel",
		defileTitre: "Everything that has been through here",
		titres: "titles",
		chapitre1: "The channel",
		chaine1:
			"The channel is six years old. It never had a career plan: it started as a way to stay in touch when we couldn't see each other. Since then it mostly serves to make the table bigger — there is always a free seat in voice chat, and you have never had to be good to take it.",
		chaine2:
			"There is a scene built for two cameras, because half the streams are done in pairs. Another one vertical, for whatever goes to TikTok. The rest — alerts, follower counter, emote wall — is back-of-house, but it says well enough that none of this is improvised.",
		passer: "Drop by the channel",
		guitare: "— and if a guitar occasionally turns up there, that story belongs on the",
		coteMusique: "music side",
		suivre: "Follow NabsLand",
		chapitre2: "Never played alone",
		douzeTitres: "12 titles",
		ensemble1:
			"The log is unambiguous: nearly every single-player game in the library is dropped after a few hours, while the multiplayer ones run into the hundreds. That is not a quirk of taste, it is the reason to turn the PC on.",
		ensemble2a:
			"Behind all of it there is a Discord that has been running for years, where the regulars meet people who showed up yesterday. The game is often just a pretext for the voice room:",
		ensemble2b: "literally ties the players to one another — which is roughly the idea.",
		chapitre3: "It goes back a while",
		jalonsTexte1: "Eleven years of logs,",
		jalonsHeures: "4,635 hours",
		jalonsTexte2:
			"across a hundred-odd titles. It is not a trophy, and it was never a way of life: it is simply long enough to count in who you turn into. The games changed far more often than the reasons for playing them.",
		chaine: [
			{ k: "Live since", v: "April 2020" },
			{ k: "Status", v: "Affiliate" },
			{ k: "Scenes built", v: "9" },
			{ k: "Last on", v: "Halo" },
		],
		auProgramme: [
			{ nom: "League of Legends", note: "Salé#9891 — the oldest habit, played again last night" },
			{ nom: "Rocket League", note: "2,440 h logged. Cars, a ball, no ceiling" },
			{ nom: "Co-op horror", note: "Phasmophobia, Lethal Company, Content Warning — the point is not being scared, it is hearing everyone else be scared" },
			{ nom: "The rest", note: "Party games, escape rooms, and going back to Xbox 360 titles" },
		],
		jalons: [
			{ an: "2015", fait: "Minecraft on 1.8.9, and the first hours of Rocket League" },
			{ an: "2020", fait: "The Twitch channel opens, in April" },
			{ an: "2024", fait: "Editing the VODs, moving to vertical for TikTok" },
			{ an: "2026", fait: "No main game any more: co-op horror, Rocket League, a Halo from 2007 — whatever appeals that evening" },
		],
	},
};
const c = T[langue];
const chaine = c.chaine;
const auProgramme = c.auProgramme;

const ensemble = [
	{ nom: "Phasmophobia", h: "177 h" },
	{ nom: "Among Us", h: "79 h" },
	{ nom: "Fall Guys", h: "72 h" },
	{ nom: "Lethal Company", h: "44 h" },
	{ nom: "Content Warning", h: "22 h" },
	{ nom: "Escape the Backrooms", h: "17 h" },
	{ nom: "PEAK", h: "17 h" },
	{ nom: "Escape Simulator", h: "14 h" },
	{ nom: "Portal 2", h: "11 h" },
	{ nom: "Unrailed!", h: "9,8 h" },
	{ nom: "Chained Together", h: "9,6 h" },
	{ nom: "Golf With Your Friends", h: "GOG" },
];

/* Compte tenu a partir du tableau, pas ecrit en dur : le libelle du bandeau
   suivait sinon a la main chaque titre ajoute au defile. */
const nbTitres = defile.flat().length;

const jalons = c.jalons;
---

<Layout
	title="Gaming"
	description={c.description}
	mainClass="page editorial"
	lang={langue}
>
	<section class="tete-page">
		{/* La chaine est annoncee avant le titre : c'est ce que la page vend, et
		    le mot « Gaming » seul ne le dit pas. */}
		<div class="meta-row meta-tete" data-reveal data-groupe="tete">
			<span>Twitch &middot; <b>NabsLand</b></span>
			<span><b>{c.statut}</b> &middot; {c.depuis} <b>2020</b></span>
		</div>
		<h1 class="titre-page" data-reveal data-groupe="tete">Gaming</h1>
		<div class="prose" data-reveal data-groupe="tete">
			<p>{c.intro1}</p>
			<p>{c.intro2a} <b>NabsLand</b>{c.intro2b}</p>
		</div>
		<a class="bouton bouton-tete" href={TWITCH} target="_blank" rel="noopener"
			data-reveal data-groupe="tete">{c.regarder} &#8599;</a>
	</section>

	{/* --------------------------------------------------------------- defile ---
	    Le moment de la page. Tout ce qui est passé sur cette machine défile en
	    continu, sans classement et sans chiffre : la quantité est le propos, pas
	    le palmarès. Trois rangs, deux sens, trois vitesses.

	    La bande sort du retrait --edge — c'est la seule rupture de gabarit de la
	    page, et elle est volontaire : un ruban qui s'arrête à 40px du bord montre
	    le truc au lieu de donner l'impression que ça continue. */}
	<section class="defile-bloc" data-reveal data-groupe="defile">
		<div class="defile-intitule">
			<span>{c.defileTitre}</span>
			<span>{nbTitres} {c.titres}</span>
		</div>

		<div class="defile">
			{
				defile.map((rang, r) => (
					<div class="defile-rang" style={`--vitesse:${[72, 88, 64][r]}s`}>
						<ul class="defile-piste">
							{rang.map((j) => (
								<li><span>{j}</span><i aria-hidden="true"></i></li>
							))}
						</ul>
						<ul class="defile-piste" aria-hidden="true">
							{rang.map((j) => (
								<li><span>{j}</span><i></i></li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section>
		<div class="section-head grande" data-reveal data-groupe="chaine">
			<span><i class="section-num">01</i>{c.chapitre1}</span>
			<span>twitch.tv/nabsland</span>
		</div>

		<div class="duo bloc-chaine">
			<div class="prose" data-reveal data-groupe="chaine">
				<p>{c.chaine1}</p>
				<p>{c.chaine2}</p>
				<p>
					<a class="lien" href={TWITCH} target="_blank" rel="noopener">{c.passer}</a>
					{c.guitare}
					<a class="lien" href={cheminLocalise("/musique", langue)}>{c.coteMusique}</a>.
				</p>
			</div>

			<div class="cote" data-reveal data-groupe="chaine">
				<div class="reperes reperes-cote">
					{
						chaine.map((s) => (
							<div class="repere">
								<span class="repere-k">{s.k}</span>
								<span class="repere-v">{s.v}</span>
							</div>
						))
					}
				</div>
				<a class="bouton" href={TWITCH} target="_blank" rel="noopener">{c.suivre} &#8599;</a>
			</div>
		</div>

		<ul class="programme">
			{
				auProgramme.map((p) => (
					<li class="programme-ligne" data-reveal data-groupe="programme">
						<span class="programme-nom">{p.nom}</span>
						<span class="programme-note">{p.note}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head grande" data-reveal data-groupe="ensemble">
			<span><i class="section-num">02</i>{c.chapitre2}</span>
			<span>{c.douzeTitres}</span>
		</div>

		<div class="prose bloc-prose" data-reveal data-groupe="ensemble">
			<p>{c.ensemble1}</p>
			<p>{c.ensemble2a} <b>Chained Together</b> {c.ensemble2b}</p>
		</div>

		<ul class="jeux">
			{
				ensemble.map((j) => (
					<li class="jeu" data-reveal data-groupe="ensemble-liste">
						<span class="jeu-nom">{j.nom}</span>
						<span class="jeu-h">{j.h}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head grande" data-reveal data-groupe="jalons">
			<span><i class="section-num">03</i>{c.chapitre3}</span>
			<span>2015 &rarr; 2026</span>
		</div>

		<div class="prose bloc-prose" data-reveal data-groupe="jalons">
			<p>{c.jalonsTexte1} <b>{c.jalonsHeures}</b> {c.jalonsTexte2}</p>
		</div>

		<ol class="jalons">
			{
				jalons.map((j) => (
					<li class="jalon" data-reveal data-groupe="jalons-liste">
						<span class="jalon-an">{j.an}</span>
						<span class="jalon-fait">{j.fait}</span>
					</li>
				))
			}
		</ol>
	</section>

	<Colophon lang={langue} />
</Layout>

<style>
	/* Le bandeau porte son propre air : .tete-page cale le titre a --pas-6 du
	   haut, et le titre a un interlignage de 0,86 qui remonte deja les capitales. */
	.meta-tete {
		margin-bottom: 18px;
	}

	.bouton-tete {
		margin-top: var(--pas-3);
	}

	.bloc-prose {
		padding: var(--pas-3) var(--edge) 0;
		margin-top: 0;
	}

	.bloc-chaine {
		grid-template-columns: minmax(0, 1fr) 420px;
	}

	/* Meme respiration que /clouddevops : a --pas-6 les chapitres se collent au
	   bloc precedent et le squelette de la page disparait. */
	.section-head.grande {
		margin-top: var(--pas-10);
	}

	/* --------------------------------------------------------------- defile ---
	   Trois rangs de titres qui glissent en continu, en sens alternes. Aucun
	   degrade, aucune ombre, aucun rayon : de la typo a l'encre et un carre de
	   3px entre deux titres.

	   La boucle tient a la duplication : deux pistes identiques cote a cote, la
	   translation courant de 0 a -50 % de la paire. Le raccord est donc invisible
	   quelle que soit la vitesse. */
	.defile-bloc {
		margin-top: var(--pas-8);
	}

	.defile {
		overflow: hidden;
	}

	.defile-intitule {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 20px;
		padding: 0 var(--edge) 9px;
		border-bottom: 1px solid var(--ink);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.defile-intitule span:last-child {
		color: var(--ink-55);
		font-weight: 500;
	}

	.defile-rang {
		display: flex;
		width: max-content;
		border-bottom: 1px solid var(--rule);
		animation: glisse var(--vitesse, 72s) linear infinite;
	}

	/* Le rang du milieu part dans l'autre sens : trois bandes qui glissent du
	   meme cote se lisent comme un seul bloc qui derive. */
	.defile-rang:nth-child(2) {
		animation-direction: reverse;
	}

	.defile-rang:last-child {
		border-bottom: 0;
	}

	.defile-piste {
		display: flex;
		align-items: center;
		flex: none;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.defile-piste li {
		display: flex;
		align-items: center;
		gap: 22px;
		padding: 14px 0;
	}

	.defile-piste li span {
		font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
		font-size: clamp(26px, 3.4vw, 46px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: var(--ink);
		white-space: nowrap;
		transition: color var(--duree) var(--sortie);
	}

	.defile-piste li i {
		flex: none;
		width: 7px;
		height: 7px;
		margin: 0 22px;
		background: var(--rule);
		transition: background var(--duree) var(--sortie);
	}

	@keyframes glisse {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	/* La bande ne s'arrete plus au survol : elle passait en pause des que la
	   souris la traversait, y compris en allant simplement d'une section a
	   l'autre — un arret non demande, plus genant que le mouvement lui-meme.

	   Le mecanisme d'arret reste assure par `prefers-reduced-motion` plus bas,
	   qui coupe l'animation ET rend la bande defilable a la main.

	   `:focus-within` partait de toute facon a la poubelle : les items sont des
	   <li> sans lien ni bouton, donc rien n'y prend le focus et la regle ne
	   s'est jamais declenchee. */

	.defile-piste li:hover span {
		color: var(--ink);
	}

	.defile-piste li:hover i {
		background: var(--ink);
	}

	/* --------------------------------------------------------------- cote --- */
	.cote {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--pas-3);
	}

	.reperes-cote {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	/* ---------------------------------------------------------- programme --- */
	.programme {
		list-style: none;
		margin: 0;
		padding: var(--pas-6) var(--edge) 0;
	}

	.programme-ligne {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr);
		gap: var(--pas-6);
		align-items: baseline;
		padding: 16px 0;
		border-bottom: 1px solid var(--rule);
	}

	.programme-ligne:first-child {
		border-top: 1px solid var(--ink);
	}

	.programme-nom {
		font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
		font-size: 26px;
		font-weight: 800;
		line-height: 1.05;
		text-transform: uppercase;
		color: var(--ink);
	}

	.programme-note {
		font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
		font-size: 15px;
		line-height: 1.45;
		color: var(--ink-55);
	}

	/* ------------------------------------------------------------- listes --- */
	.jeux {
		list-style: none;
		margin: 0;
		padding: var(--pas-3) var(--edge) 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0 var(--pas-6);
	}

	.jeu {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		padding: 12px 0;
		border-bottom: 1px solid var(--rule);
	}

	.jeu-nom {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.jeu-h {
		flex: none;
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.09em;
		color: var(--ink-55);
	}

	/* ------------------------------------------------------------- jalons --- */
	.jalons {
		list-style: none;
		margin: 0;
		padding: var(--pas-3) var(--edge) 0;
	}

	.jalon {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: var(--pas-6);
		align-items: baseline;
