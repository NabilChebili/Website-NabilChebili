---
import GalleryPage from "../../components/GalleryPage.astro";
import galleries from "../../data/galleries.json";
import { cheminsDesLangues, langueDepuisParam } from "../../i18n/ui";

export function getStaticPaths() {
  return cheminsDesLangues();
}

const langue = langueDepuisParam(Astro.params.lang);

const T = {
  fr: {
    titre: "GR1 (1)",
    description: "Galerie photo : GR1, partie 1.",
    intro: "Premier chapitre du GR1 : les premiers kilomètres du sentier, entre paysages et rencontres.",
  },
  en: {
    titre: "GR1 (1)",
    description: "Photo gallery: GR1, part one.",
    intro: "First leg of the GR1: the opening kilometres of the trail, its landscapes and the people met along it.",
  },
};
const c = T[langue];
---

<GalleryPage
  title={c.titre}
  description={c.description}
  intro={c.intro}
  galleryUrl={galleries.paris}
  lang={langue}
/>
