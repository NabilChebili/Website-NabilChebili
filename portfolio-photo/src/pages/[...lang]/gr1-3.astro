---
import GalleryPage from "../../components/GalleryPage.astro";
import galleries from "../../data/galleries.json";
import { cheminsDesLangues, langueDepuisParam } from "../../i18n/ui";

export function getStaticPaths() {
  return cheminsDesLangues();
}

const langue = langueDepuisParam(Astro.params.lang);

const T = {
  fr: {
    titre: "GR1 (3)",
    description: "Galerie photo : GR1, partie 3.",
    intro: "Troisième et dernière étape du GR1, jusqu'au bout du sentier.",
  },
  en: {
    titre: "GR1 (3)",
    description: "Photo gallery: GR1, part three.",
    intro: "Third and final leg of the GR1, all the way to the end of the trail.",
  },
};
const c = T[langue];
---

<GalleryPage
  title={c.titre}
  description={c.description}
  intro={c.intro}
  galleryUrl={galleries.GR3}
  lang={langue}
/>
