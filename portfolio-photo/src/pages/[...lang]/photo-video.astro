---
// Photo & video : la page « travaillons ensemble » (Nabil, 24/11). Le site
// presente deux metiers a egalite ; celle-ci montre le travail photo/video
// pour des clients : mariage, evenementiel, films, retouche, puis le contact.
// Ton sobre et pro : aucune promesse qu'on ne peut pas montrer.
import "../../styles/global.css";
import Layout from "../../layouts/header.astro";
import { Image } from "astro:assets";
import galleries from "../../data/galleries.json";
import { cheminLocalise, cheminsDesLangues, langueDepuisParam } from "../../i18n/ui";

import suzhouAvant from "../../assets/avant-apres/suzhou-avant.jpg";
import suzhouApres from "../../assets/avant-apres/suzhou-apres.jpg";
import shaoxingAvant from "../../assets/avant-apres/shaoxing-avant.jpg";
import shaoxingApres from "../../assets/avant-apres/shaoxing-apres.jpg";
import nankinAvant from "../../assets/avant-apres/nankin-avant.jpg";
import nankinApres from "../../assets/avant-apres/nankin-apres.jpg";

export function getStaticPaths() {
  return cheminsDesLangues();
}

const langue = langueDepuisParam(Astro.params.lang);
const EMAIL = "nabilchebili1999@gmail.com";

const T = {
  fr: {
    titre: "Photo & vidéo",
    description:
      "Photographe et vidéaste : mariages, événements d’entreprise et films de voyage. Prise de vue, retouche et montage. Contact pour un projet.",
    intro:
      "Je photographie et je filme des mariages, des événements d’entreprise et des voyages. Je fais aussi la retouche et le montage, pour livrer des images prêtes à être publiées.",
    ecrire: "Écrire pour un projet",
    galeries: "Toutes les galeries photo",
    mariage: "Mariage",
    mariageTexte: "La mairie, les proches, le dîner : la journée entière, posée et spontanée.",
    mariageLien: "Voir la galerie du mariage",
    evenement: "Événementiel",
    evenementTexte: "Meetup Databricks chez I-Shane : les intervenants, la salle, les échanges.",
    evenementLien: "Voir la galerie de l’événement",
    films: "Films",
    filmsTexte: "Des films de voyage, du tournage au montage et au son.",
    chaine: "Voir la chaîne YouTube",
    retouche: "Retouche : avant / après",
    retoucheTexte:
      "À gauche, l’image telle que l’appareil la donne ; à droite, la photo terminée. Faites glisser pour comparer.",
    appareil: "Appareil",
    fini: "Retouchée",
    comparer: "Comparer avant et après",
    contact: "Contact",
    contactTitre: "Un projet photo ou vidéo ?",
    contactTexte: "Dites-moi la date, le lieu et ce que vous imaginez. Je réponds généralement sous quelques heures.",
    altMariage: ["Les mariés devant la mairie", "Les mariés et leurs proches", "Les témoins et les alliances", "Le dîner"],
    altEvent: ["Un intervenant devant le public", "Une présentation", "Les intervenants réunis", "Une intervention"],
    voyages: [
      { titre: "Indonésie", href: "/indonesie", id: "_cPEUTOqEoI" },
      { titre: "Vietnam", href: "/vietnam", id: "4ds0mpAiWJw" },
    ],
    paires: ["Suzhou, le canal", "Shaoxing, les murs blancs", "Nankin, la nuit"],
  },
  en: {
    titre: "Photo & video",
    description:
      "Photographer and filmmaker: weddings, corporate events and travel films. Shooting, retouching and editing. Get in touch about a project.",
    intro:
      "I photograph and film weddings, corporate events and travels. I also do the retouching and the editing, so the images are ready to publish.",
    ecrire: "Write about a project",
    galeries: "All photo galleries",
    mariage: "Wedding",
    mariageTexte: "The town hall, the family, the dinner: the whole day, posed and candid.",
    mariageLien: "See the wedding gallery",
    evenement: "Events",
    evenementTexte: "Databricks meetup at I-Shane: the speakers, the room, the conversations.",
    evenementLien: "See the event gallery",
    films: "Films",
    filmsTexte: "Travel films, from shooting to editing and sound.",
    chaine: "See the YouTube channel",
    retouche: "Retouching: before / after",
    retoucheTexte: "Left, the image as the camera gives it; right, the finished photo. Drag to compare.",
    appareil: "Camera",
    fini: "Retouched",
    comparer: "Compare before and after",
    contact: "Contact",
    contactTitre: "A photo or video project?",
    contactTexte: "Tell me the date, the place and what you have in mind. I usually reply within a few hours.",
    altMariage: ["The couple outside the town hall", "The couple and their family", "The best men and the rings", "The dinner"],
    altEvent: ["A speaker facing the audience", "A talk", "The speakers together", "A talk"],
    voyages: [
      { titre: "Indonesia", href: "/indonesie", id: "_cPEUTOqEoI" },
      { titre: "Vietnam", href: "/vietnam", id: "4ds0mpAiWJw" },
    ],
    paires: ["Suzhou, the canal", "Shaoxing, the white walls", "Nanjing, at night"],
  },
};
const c = T[langue];

// Quatre images par galerie, choisies a la main sur planche (24/11).
const mariage = ["DAO07099", "DAO07499", "DAO07547", "DAO07959"].map((n, i) => ({
  src: `${galleries.mariage}${n}.jpg`,
  alt: c.altMariage[i],
}));
const evenement = ["A7405120", "A7405105", "A7405199", "A7405167"].map((n, i) => ({
  src: `${galleries.eventDatabricks}${n}.jpg`,
  alt: c.altEvent[i],
}));
const paires = [
  [suzhouAvant, suzhouApres],
  [shaoxingAvant, shaoxingApres],
  [nankinAvant, nankinApres],
].map(([avant, apres], i) => ({ avant, apres, titre: c.paires[i] }));
---

<Layout title={c.titre} description={c.description} mainClass="page editorial" lang={langue} image={mariage[1].src}>
  <section class="tete-page">
    <h1 class="titre-page" data-reveal data-groupe="tete">{c.titre}</h1>
    <div class="prose" data-reveal data-groupe="tete">
      <p>{c.intro}</p>
    </div>
    <a class="pv-ecrire" href={`mailto:${EMAIL}`} data-reveal data-groupe="tete">
      <span>{c.ecrire}</span><i aria-hidden="true">&#8594;</i>
    </a>
    <a class="pv-lien pv-galeries" href={cheminLocalise("/photo", langue)} data-reveal data-groupe="tete"><span>{c.galeries}</span><i aria-hidden="true">&#8594;</i></a>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="mariage">
      <span><b class="pv-num">01</b>{c.mariage}</span>
      <span>({mariage.length})</span>
    </div>
    <div class="pv-bloc">
      <p class="pv-texte">{c.mariageTexte}</p>
      <div class="pv-grille">
        {mariage.map((p) => (
          <Image src={p.src} alt={p.alt} inferSize widths={[400, 800]} sizes="(max-width: 700px) 50vw, 25vw" loading="lazy" decoding="async" />
        ))}
      </div>
      <a class="pv-lien" href={cheminLocalise("/mariage", langue)}><span>{c.mariageLien}</span><i aria-hidden="true">&#8594;</i></a>
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="evenement">
      <span><b class="pv-num">02</b>{c.evenement}</span>
      <span>({evenement.length})</span>
    </div>
    <div class="pv-bloc">
      <p class="pv-texte">{c.evenementTexte}</p>
      <div class="pv-grille">
        {evenement.map((p) => (
          <Image src={p.src} alt={p.alt} inferSize widths={[400, 800]} sizes="(max-width: 700px) 50vw, 25vw" loading="lazy" decoding="async" />
        ))}
      </div>
      <a class="pv-lien" href={cheminLocalise("/event-databricks", langue)}><span>{c.evenementLien}</span><i aria-hidden="true">&#8594;</i></a>
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="films">
      <span><b class="pv-num">03</b>{c.films}</span>
      <span>({c.voyages.length})</span>
    </div>
    <div class="pv-bloc">
      <p class="pv-texte">{c.filmsTexte}</p>
      <div class="pv-films">
        {c.voyages.map((v) => (
          <a class="pv-film" href={cheminLocalise(v.href, langue)}>
            <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
            <span class="pv-film-titre">{v.titre}</span>
          </a>
        ))}
      </div>
      <a class="pv-lien" href="https://www.youtube.com/@Nabs-world" target="_blank" rel="noopener"><span>{c.chaine}</span><i aria-hidden="true">&#8599;</i></a>
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="retouche">
      <span><b class="pv-num">04</b>{c.retouche}</span>
      <span>({paires.length})</span>
    </div>
    <div class="pv-bloc">
      <p class="pv-texte">{c.retoucheTexte}</p>
      <div class="pv-paires">
        {paires.map((p) => (
          <figure class="pv-paire">
            {/* Deux images empilees ; l'avant est rogne par la gauche selon
                --pos. Le curseur est un vrai <input type=range> : clavier et
                lecteur d'ecran compris, sans rien a reimplementer. */}
            <div class="comparer" style="--pos: 50%">
              <Image src={p.apres} alt={`${p.titre} — ${c.fini}`} widths={[500, 1000]} sizes="(max-width: 700px) 100vw, 33vw" loading="lazy" decoding="async" />
              <Image class="comparer-avant" src={p.avant} alt={`${p.titre} — ${c.appareil}`} widths={[500, 1000]} sizes="(max-width: 700px) 100vw, 33vw" loading="lazy" decoding="async" />
              <span class="comparer-trait" aria-hidden="true"></span>
              <span class="comparer-etiquette gauche" aria-hidden="true">{c.appareil}</span>
              <span class="comparer-etiquette droite" aria-hidden="true">{c.fini}</span>
              <input type="range" min="0" max="100" value="50" aria-label={`${c.comparer} : ${p.titre}`} />
            </div>
            <figcaption>{p.titre}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="pv-contact">
    <div class="section-head" data-reveal data-groupe="contact">
      <span><b class="pv-num">05</b>{c.contact}</span>
      <span></span>
    </div>
    <div class="pv-bloc">
      <h2 class="pv-contact-titre">{c.contactTitre}</h2>
      <p class="pv-texte">{c.contactTexte}</p>
      <a class="pv-ecrire grand" href={`mailto:${EMAIL}`}>
        <span>{EMAIL}</span><i aria-hidden="true">&#8594;</i>
      </a>
    </div>
  </section>
</Layout>

<script>
  for (const boite of document.querySelectorAll<HTMLElement>(".comparer")) {
    const curseur = boite.querySelector("input");
    curseur?.addEventListener("input", () => boite.style.setProperty("--pos", `${curseur.value}%`));
  }
</script>

<style>
  .pv-bloc {
    padding: var(--pas-3) var(--edge) var(--pas-6, 48px);
  }
  .pv-num {
    display: inline-block;
    margin-right: 10px;
    padding: 2px 5px;
    background: var(--ink);
    color: var(--paper);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    line-height: 1.2;
  }
  .pv-texte {
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
    max-width: 60ch;
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }

  .pv-grille {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .pv-grille :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--block);
  }

  .pv-films {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .pv-film {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .pv-film img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--block);
  }
  .pv-film-titre {
    display: block;
    margin-top: 8px;
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 20px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .pv-film:hover .pv-film-titre,
  .pv-film:focus-visible .pv-film-titre {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* Liens : le vocabulaire des cartes Explorer (capitales espacees, fleche,
     filet qui se trace au survol). */
  .pv-lien,
  .pv-ecrire {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    margin-top: 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition: background-size var(--duree-longue) var(--sortie);
  }
  .pv-lien:hover,
  .pv-lien:focus-visible,
  .pv-ecrire:hover,
  .pv-ecrire:focus-visible {
    background-size: 100% 1px;
  }
  .pv-lien i,
  .pv-ecrire i {
    font-style: normal;
    transition: transform var(--duree) var(--sortie);
  }
  .pv-lien:hover i,
  .pv-ecrire:hover i {
    transform: translateX(5px);
  }
  /* L'appel principal : un aplat a l'encre, sans rayon ni ombre. */
  .pv-ecrire {
    margin-top: 22px;
    padding: 12px 18px;
    background-color: var(--ink);
    color: var(--paper);
    background-image: none;
  }
  .pv-ecrire:hover,
  .pv-ecrire:focus-visible {
    background-color: var(--ink);
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }
  @media (min-width: 701px) {
    .pv-galeries {
      margin-left: 24px;
    }
  }
  .pv-ecrire.grand {
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* --- comparateur avant / apres --- */
  .pv-paires {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: start;
  }
  .pv-paire {
    margin: 0;
  }
  .pv-paire figcaption {
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
    margin-top: 8px;
    font-size: 12px;
    color: var(--ink-55);
  }
  .comparer {
    position: relative;
    overflow: hidden;
    background: var(--block);
    touch-action: pan-y;
  }
  .comparer :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .comparer :global(.comparer-avant) {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .comparer-trait {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--paper);
    pointer-events: none;
  }
  .comparer-trait::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    background: var(--paper);
    outline: 1px solid var(--ink);
  }
  .comparer-etiquette {
    position: absolute;
    top: 10px;
    padding: 3px 6px;
    background: var(--ink);
    color: var(--paper);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    pointer-events: none;
  }
  .comparer-etiquette.gauche {
    left: 10px;
  }
  .comparer-etiquette.droite {
    right: 10px;
  }
  .comparer input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .comparer:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .pv-contact-titre {
    margin: 0 0 10px;
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: clamp(28px, 3.4vw, 48px);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .pv-paires {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 700px) {
    .pv-grille {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .pv-films {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pv-lien,
    .pv-ecrire,
    .pv-lien i,
    .pv-ecrire i {
      transition: none;
    }
  }
</style>
