  { titre: "Consultant DevOps chez Cellenza",
    resume: "Plateformes de données, réseaux et conformité, le tout décrit en code." },
  { titre: "Réseaux Azure et GitHub Actions",
    resume: "AZ-700 sur les architectures réseau au printemps, la certification GitHub Actions en juin." },
  { titre: "La Croatie, et un vrai boîtier",
    resume: "Premier voyage avec un hybride plein format : c'est là que la photo commence pour de bon." },
  { titre: "Le GR1, en trois étapes",
    resume: "Le sentier qui fait le tour de Paris, marché de novembre à janvier, appareil en main." },
  { titre: "Londres, pendant les fêtes",
