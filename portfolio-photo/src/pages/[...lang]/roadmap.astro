const parcoursEn = [
  { titre: "A semester in Malta",
    resume: "An exchange at the University of Malta, September to February: the first long stay away from Paris." },
  { titre: "A first game, and a sprinkler",
    resume: "A video game written in Godot for the digital creation course, and an automatic sprinkler driven by an Arduino." },
