---
import "../../styles/global.css";
import Layout from "../../layouts/header.astro";
import { cheminsDesLangues, langueDepuisParam } from "../../i18n/ui";

export function getStaticPaths() {
  return cheminsDesLangues();
}

const langue = langueDepuisParam(Astro.params.lang);

// =========================================================================
//  LA PAGE SE LIT EN DEUX TEMPS
//
//  1. Le parcours — ce qui est fait, date, sur un rail. Il finit sur la
//     derniere livraison, et le trace s'y arrete.
//  2. La suite — ce qui vient, SANS dates, range par theme en colonnes.
//     Un projet qui n'a pas de date ne doit pas en inventer une : le mettre
//     sur une frise le ferait mentir.
//
//  Registre : perso, et le travail a hauteur d'intention — une certification
//  visee, un objectif, une avancee marquante. Rien du detail de ce qui se
//  fait chez un client.
// =========================================================================

// Ce qui ne depend pas de la langue. Separer l'invariant du redige evite le
// piege rencontre sur /clouddevops, ou la pastille tenait au TEXTE francais
// et disparaissait en anglais.
// Sources, pour ne pas les rechercher : mails de Microsoft, Credly, Twitch et
// des compagnies aeriennes (dates exactes), CV et rapports de stage du Bureau,
// noms de fichiers des cameras, depots git, Teams. Aucun client nomme.
const parcoursBase = [
  { horizon: "sept. 2019" },
  { horizon: "déc. 2020" },
  { horizon: "avr. 2021" },
  { horizon: "janv. 2022" },
  { horizon: "févr. 2022" },
  { horizon: "juil. 2022" },
  { horizon: "sept. 2022" },
  { horizon: "oct. 2022" },
  { horizon: "mai 2023" },
  { horizon: "févr. 2024" },
  { horizon: "oct. 2024" },
  { horizon: "févr. 2025" },
  { horizon: "juin 2025" },
  { horizon: "sept. 2025" },
  { horizon: "nov. 2025" },
  { horizon: "déc. 2025" },
  { horizon: "janv. 2026" },
  { horizon: "févr. 2026" },
  { horizon: "avr. 2026" },
  { horizon: "juin 2026" },
  { horizon: "juil. 2026" },
  { horizon: "été 2026" },
  { horizon: "août 2026" },
  { horizon: "août 2026" },
  { horizon: "oct. 2026" },
  { horizon: "oct. 2026" },
  { horizon: "oct. 2026" },
  { horizon: "oct. 2026", dernier: true },
];

const parcoursFr = [
  { titre: "Un semestre à Malte",
    resume: "Échange à l'Université de Malte, de septembre à février : le premier long séjour loin de Paris." },
  { titre: "Un premier jeu, et un arroseur",
    resume: "Un jeu vidéo écrit sous Godot pour le cours de création numérique, et un arroseur automatique piloté par Arduino." },
  { titre: "Stage chez Bouygues Telecom",
    resume: "Cinq mois entre UX et développement full-stack : un tableau de bord pensé avec l'équipe qui allait s'en servir." },
  { titre: "CarLimit, projet de fin d'études",
    resume: "Une application mobile et son serveur, menées de l'idée à la soutenance." },
  { titre: "Stage de fin d'études chez Devoteam",
    resume: "Six mois d'automatisation sur Azure. Le premier pas dans le cloud." },
  { titre: "Diplôme d'ingénieur",
    resume: "ECE Paris, majeure objets connectés, réseaux et services." },
  { titre: "Ingénieur Cloud & DevOps chez Devoteam",
    resume: "Embauché à la sortie du stage. Puis Team Lead et Product Owner d'une équipe dédiée à la sécurité Azure." },
  { titre: "Premières certifications Azure",
    resume: "Azure Fundamentals en septembre, Azure Administrator Associate trois semaines plus tard." },
  { titre: "Affilié Twitch",
