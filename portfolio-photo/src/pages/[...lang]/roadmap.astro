  { titre: "Accompagnement d'architecture Cloud",
    resume: "Passer de la construction à la conception : cadrer les socles, poser les standards, et accompagner les équipes sur les choix qui engagent." },
  { titre: "Un bot musical pour Discord",
    resume: "Écrit en deux jours, hébergé dans le cloud pour le prix d'un café par mois, et redéployé à chaque changement." },
  { titre: "Le film du Vietnam",
    resume: "Monté de bout en bout, et placé au milieu du récit, entre les photos." },
  { titre: "Claude Certified Architect — Foundations",
    resume: "Après le FullStack et le DevOps, l'IA. Et dans la foulée, un examen blanc pour que l'équipe le passe à son tour." },
  { titre: "Drone Racer",
    resume: "Un jeu conçu et servi en direct pour l'I-Share, la journée où l'équipe se retrouve." },
  { titre: "Le site passe en deux langues",
    resume: "Seize pages en français et en anglais, et la bascule dans la barre." },
  { titre: "Le film de l'Indonésie, et quatorze épisodes",
    resume: "Le voyage monté en long pour YouTube, puis redécoupé en quatorze épisodes verticaux pour TikTok, de Sekumpul à Uluwatu." },
