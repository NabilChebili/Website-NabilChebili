  { titre: "Final-year internship at Devoteam",
    resume: "Six months of automation on Azure. The first step into the cloud." },
  { titre: "Engineering degree",
    resume: "ECE Paris, major in connected devices, networks and services." },
  { titre: "Cloud & DevOps engineer at Devoteam",
    resume: "Hired straight out of the internship. Then Team Lead and Product Owner of a team dedicated to Azure security." },
  { titre: "First Azure certifications",
    resume: "Azure Fundamentals in September, Azure Administrator Associate three weeks later." },
  { titre: "Twitch Affiliate",
    resume: "The Nabsland channel goes affiliate, with hand-drawn emotes and badges." },
  { titre: "DevOps Engineer Expert",
    resume: "The certification that closes the loop: designing and running a delivery chain." },
  { titre: "Guitar, on camera",
    resume: "A first recorded take, then a video nearly every month, from Gary Moore to Polyphia." },
  { titre: "DevOps consultant at Cellenza",
    resume: "Data platforms, networking and compliance, all of it written as code." },
  { titre: "Azure networking and GitHub Actions",
    resume: "AZ-700 on network architecture in the spring, the GitHub Actions certification in June." },
  { titre: "Croatia, and a real camera",
    resume: "The first trip with a full-frame mirrorless: that is where photography starts for real." },
  { titre: "The GR1, in three legs",
    resume: "The trail that loops around Paris, walked from November to January, camera in hand." },
  { titre: "London, over the holidays",
    resume: "A few days between Christmas and New Year, and nearly three thousand frames on the way back." },
  { titre: "The site, first version",
    resume: "A portfolio of my own, hand-written, continuously deployed." },
  { titre: "Vietnam",
    resume: "Seventeen days from the south to the centre, from Saigon during Tết to Da Nang. The site's first long story." },
  { titre: "Indonesia",
    resume: "Bali then Lombok, from volcanoes to cliffs. The second long story." },
  { titre: "Joining I-Shane",
    resume: "Cloud & DevOps consultant. Within the month, a Databricks meetup I shot the pictures for." },
  { titre: "A first concert on camera",
    resume: "Apolline on stage with SuperSonic: lights that change without warning, and no second take." },
  { titre: "Cloud architecture work",
    resume: "From building to designing: framing the foundations, setting the standards, and guiding teams through the choices that commit them." },
  { titre: "A music bot for Discord",
    resume: "Written in two days, hosted in the cloud for the price of a coffee a month, and redeployed on every change." },
  { titre: "The Vietnam film",
    resume: "Edited end to end, and set in the middle of the story, between the photos." },
  { titre: "Claude Certified Architect — Foundations",
    resume: "After FullStack and DevOps, AI. And right after, a mock exam so the team could take it in turn." },
  { titre: "Drone Racer",
    resume: "A game built and served live for I-Share, the day the team gets together." },
  { titre: "The site goes bilingual",
    resume: "Sixteen pages in French and English, with the switch up in the bar." },
  { titre: "The Indonesia film, and fourteen episodes",
    resume: "The trip edited long-form for YouTube, then recut into fourteen vertical episodes for TikTok, from Sekumpul to Uluwatu." },
];

const redige = langue === "en" ? parcoursEn : parcoursFr;
const parcours = parcoursBase.map((b, i) => ({ ...b, ...redige[i] }));

// La suite : pas de dates, des themes. L'ordre des colonnes est l'ordre de
// lecture, pas une priorite.
const suiteFr = [
  { theme: "Cloud & DevOps",
    items: ["Renouveler DevOps Engineer Expert", "AZ-305 Solutions Architect", "Publier un module Terraform"] },
  { theme: "IA",
    items: ["Des agents jusqu'en production", "La suite du parcours Claude"] },
  { theme: "Voyages",
    items: ["Le récit de la Chine", "Le film de la Chine, en long et en série"] },
  { theme: "Photo & vidéo",
    items: ["Une vitrine pour des clients", "Le motion design"] },
  { theme: "Musique",
    items: ["Every Piece Matters, de Plini", "Revenir à la composition"] },
  { theme: "Publications",
    items: ["Reprendre les articles de fond", "Écrire plus souvent", "Parler en public une fois"] },
  { theme: "I-Shane",
    items: ["Transmettre ce qui marche", "Rendre visible ce que l'équipe publie", "Le séminaire d'Oslo", "Le prochain I-Share"] },
];

const suiteEn = [
  { theme: "Cloud & DevOps",
    items: ["Renew DevOps Engineer Expert", "AZ-305 Solutions Architect", "Publish a Terraform module"] },
  { theme: "AI",
    items: ["Agents all the way to production", "The rest of the Claude track"] },
  { theme: "Travel",
    items: ["The China story", "The China film, long-form and as a series"] },
  { theme: "Photo & video",
    items: ["A showcase for clients", "Motion design"] },
  { theme: "Music",
    items: ["Every Piece Matters, by Plini", "Back to writing my own"] },
  { theme: "Writing",
    items: ["Back to long-form articles", "Write more often", "Speak in public once"] },
  { theme: "I-Shane",
    items: ["Pass on what works", "Make what the team publishes visible", "The Oslo offsite", "The next I-Share"] },
];

const suite = langue === "en" ? suiteEn : suiteFr;

const T = {
  fr: {
    titre: "Roadmap",
    description:
      "Le parcours de Nabil Chebili et ce qui vient : cloud, voyages, écriture.",
    intro:
      "Ce qui est derrière, jusqu'à la dernière chose livrée. Puis ce qui vient, par thème — sans dates, parce qu'il n'y en a pas encore.",
    parcours: "Le parcours",
    suite: "La suite",
    livre: "Dernière livraison",
    fait: "Fait",
  },
  en: {
    titre: "Roadmap",
    description:
      "Nabil Chebili's track record and what comes next: cloud, travel, writing.",
    intro:
      "What is behind, up to the last thing shipped. Then what comes next, by theme — undated, because there are no dates yet.",
    parcours: "The track record",
    suite: "What comes next",
    livre: "Last shipped",
    fait: "Done",
  },
};
const c = T[langue];
---

<Layout title={c.titre} description={c.description} mainClass="page editorial" lang={langue}>
  {/* L'en-tete reste en haut pendant que la page defile dessous. Il porte un
      fond opaque — sans lui le rail passerait au travers — et un filet, sans
      lequel le contenu glisserait dessous sans frontiere visible. */}
  <section class="tete-page tete-collee">
    <h1 class="titre-page" data-reveal data-groupe="tete">{c.titre}</h1>
    <div class="prose" data-reveal data-groupe="tete">
      <p>{c.intro}</p>
    </div>
  </section>

  <!-- ===================================================== 1 — LE PARCOURS -->
  <section>
    <div class="section-head" data-reveal data-groupe="rail">
      <span>{c.parcours}</span>
      <span>({parcours.length})</span>
    </div>
    <div class="bloc">
      <ol class="rail">
        <span class="trace" aria-hidden="true"></span>
        {
          parcours.map((j) => (
            <li class={`jalon ${j.dernier ? "dernier" : "fait"}`} data-reveal data-groupe="rail">
              <span class="marque" aria-hidden="true" />
              <span class="etiquette horizon">
                {j.horizon}
                {j.dernier ? null : <i class="fini">{c.fait}</i>}
              </span>
              {j.dernier ? <span class="puce">{c.livre}</span> : null}
              <h2>{j.titre}</h2>
              <p>{j.resume}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ======================================================== 2 — LA SUITE -->
  <section>
    <div class="section-head" data-reveal data-groupe="suite">
      <span>{c.suite}</span>
      <span>({suite.length})</span>
    </div>
    <div class="bloc">
      <div class="colonnes">
        {
          suite.map((col, i) => (
            <div class="colonne" data-reveal data-groupe="suite">
              <div class="colonne-tete">
                <i class="colonne-num">{String(i + 1).padStart(2, "0")}</i>
                <span class="etiquette">{col.theme}</span>
              </div>
              <ul class="colonne-liste">
                {col.items.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --------------------------------------------- l'en-tete qui ne bouge pas */
  /* editorial.css donne au <main> un retrait haut de 64px pour une barre qui
     n'en fait que 56. Sur une page ordinaire ces 8px ne se voient pas — du
     papier sur du papier. Ici l'en-tete partirait de 64 et SAUTERAIT a 56 en
     s'accrochant, et le rail defilerait dans la fente. On aligne le retrait
     sur la hauteur reelle de la barre, mesuree et non lue dans la feuille. */
  :global(main.page.editorial) {
    padding-top: 56px;
  }
  .tete-collee {
    position: sticky;
    top: 56px;
    z-index: 5;
    background: var(--paper);
    padding-bottom: var(--pas-3);
    border-bottom: 1px solid var(--rule);
  }
  .tete-collee .prose {
    margin-top: 14px;
    max-width: 62ch;
  }

  .bloc {
    padding: var(--pas-3) var(--edge) var(--pas-10);
  }

  .etiquette {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  /* ------------------------------------------------- 1 — le parcours ------ */
  .rail {
    position: relative;
    margin: 0;
    padding: 0 0 0 var(--pas-6);
    list-style: none;
  }
  /* Le filet est fait de SEGMENTS, un par jalon, et le dernier n'en porte
     pas : le rail s'arrete donc net sur la derniere livraison.

     Un filet unique courant sur toute la hauteur du <ol> pendait sous la
     derniere marque, jusqu'au bas du dernier paragraphe — il annoncait une
     suite qui n'existe pas, puisque ce rail est le passe et que la suite est
     en colonnes plus bas. */
  .jalon::before {
    content: "";
    position: absolute;
    top: 11px;
    left: calc(-1 * var(--pas-6) + 5px);
    width: 1px;
    height: 100%;
    background: var(--rule);
  }
  .jalon:last-child::before {
    content: none;
  }
  .trace {
    position: absolute;
    top: 7px;
    left: 4px;
    width: 3px;
    height: 0;
    background: var(--ink);
    /* Les segments gris appartiennent aux <li>, places APRES le trace dans le
       document : sans cet ordre explicite ils se peignaient par-dessus lui et
       laissaient un lisere clair le long du trait noir. */
    z-index: 1;
  }
  .jalon {
    position: relative;
    padding: 0 0 var(--pas-6);
  }
  .jalon:last-child {
    padding-bottom: 0;
  }
  .horizon {
    display: block;
    margin-bottom: 6px;
  }
  .jalon h2 {
    margin: 0 0 8px;
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .jalon p {
    margin: 0;
    max-width: 68ch;
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  .marque {
    position: absolute;
    top: 6px;
    left: calc(-1 * var(--pas-6) + 1px);
    width: 9px;
    height: 9px;
    background: var(--paper);
    border: 1px solid var(--ink);
    /* Au-dessus du trace, qui passe derriere elles. */
    z-index: 2;
    transition: background-color 240ms cubic-bezier(0.2, 0, 0, 1);
  }
  /* Une marque ne se remplit qu'au passage du trait, jamais avant : c'est le
     script qui pose .franchi. */
  .jalon.franchi .marque {
    background: var(--ink);
  }
  .dernier .marque {
    top: 3px;
    left: calc(-1 * var(--pas-6) - 2px);
    width: 15px;
    height: 15px;
  }
  .fait h2 {
    color: var(--ink-55);
  }
  .dernier h2 {
    font-size: 36px;
  }

  .puce {
    display: inline-block;
    margin-bottom: 8px;
    padding: 3px 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  /* « Fait » se pose a cote de la date, pas sur une ligne a lui : cinq jalons
     portant chacun une pastille feraient une colonne de pastilles. */
  .fini {
    margin-left: 10px;
    padding: 2px 6px;
    border: 1px solid var(--rule);
    font-size: 9px;
    font-style: normal;
    letter-spacing: 0.09em;
    color: var(--ink-55);
  }

  /* ---------------------------------------------------- 2 — la suite ------ */
  /* En colonnes et non sur la frise : ces projets n'ont pas de date, et les
     poser sur un axe du temps leur en inventerait une. Le theme remplace
     l'horizon comme cle de lecture. */
  /* auto-fit plutot qu'un nombre fige : ajouter ou retirer un theme ne
     demande alors aucune retouche de la grille. */
  .colonnes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--pas-6) var(--pas-3);
  }
  .colonne-tete {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }
  .colonne-num {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
    color: var(--rule);
  }
  .colonne-liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .colonne-liste li {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .colonne-liste li:last-child {
    border-bottom: 0;
  }

  @media (max-width: 560px) {
    .colonnes {
      grid-template-columns: 1fr;
      gap: var(--pas-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marque {
      transition: none;
    }
  }
</style>

<script>
  // Deux choses distinctes, souvent confondues :
  //
  //   1. le TRACE suit le defilement — il monte jusqu'a la hauteur ou on lit,
  //      et bute sur la marque de la derniere livraison, jamais au-dela ;
  //   2. a l'ARRIVEE la page descend d'elle-meme jusqu'a ce jalon, une seule
  //      fois, puis rend la main.
  //
  // Le point 2 n'anime pas le trait : il deplace la page, et le trait suit
  // parce qu'il suit toujours.
  (function () {
    const rail = document.querySelector(".rail");
    if (!rail) return;
    const trace = rail.querySelector(".trace");
    const jalons = Array.from(rail.querySelectorAll(".jalon"));
    const dernier = rail.querySelector(".dernier");
    if (!trace || !dernier) return;

    const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // On reprend au navigateur la restauration du defilement. Sans cela il
    // repose la page a l'endroit quitte AVANT que le script ne tourne, et
    // l'arrivee sur la page n'est plus une arrivee. Pose tot, et seulement
    // ici : les autres pages gardent le comportement par defaut.
    if (!reduit && "scrollRestoration" in history) {
      history.scrollRestoration = "manual";
    }

    // Position dans le DOCUMENT, par la chaine des offsetParent.
    //
    // Surtout pas getBoundingClientRect : les blocs a reveler portent une
    // translation tant qu'ils ne sont pas vus, et le rectangle client
    // l'inclut. Mesure ainsi, le plafond tombait 24px trop bas et le trace
    // depassait sa cible. offsetTop donne la position de MISE EN PAGE,
    // insensible aux transformations.
    function hautDansLaPage(el) {
      let y = 0;
      for (let n = el; n; n = n.offsetParent) y += n.offsetTop;
      return y;
    }

    // Hauteur du centre d'une marque, comptee depuis le haut du trace, qui
    // demarre a 7px du haut du rail. La chaine tient parce que .rail et
    // .jalon sont tous deux positionnes : marque -> .jalon -> .rail.
    const centre = (jalon) => {
      const m = jalon.querySelector(".marque");
      return m ? jalon.offsetTop + m.offsetTop + m.offsetHeight / 2 - 7 : Infinity;
    };

    const LECTURE = 0.58; // la ligne de l'oeil, un peu sous le milieu

    let enAttente = false;

    function poser() {
      enAttente = false;
      const depart = hautDansLaPage(rail) + 7;
      const plafond = centre(dernier);
      const lecture = window.scrollY + window.innerHeight * LECTURE;
      const h = Math.max(0, Math.min(plafond, lecture - depart));
      // On lit toutes les positions, PUIS on ecrit : l'inverse forcerait un
      // recalcul de mise en page a chaque jalon.
      const centres = jalons.map(centre);
      trace.style.height = h + "px";
      jalons.forEach((j, i) => j.classList.toggle("franchi", centres[i] <= h + 1));
    }

    function auDefilement() {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(poser);
    }

    poser();
    window.addEventListener("scroll", auDefilement, { passive: true });
    window.addEventListener("resize", auDefilement);
    window.addEventListener("load", auDefilement);

    // ------------------------------------------------ la descente d'arrivee
    // On vise la position ou la derniere livraison arrive a hauteur de
    // lecture : c'est exactement l'endroit ou le trace atteint son plafond.
    // La descente et le remplissage finissent donc ensemble, sans qu'on ait
    // a les synchroniser.
    function cible() {
      const depart = hautDansLaPage(rail) + 7;
      const y = depart + centre(dernier) - window.innerHeight * LECTURE;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      return Math.max(0, Math.min(max, y));
    }

    // Mouvement reduit : aucune descente imposee. La page reste ou elle est.
    if (reduit) return;

    let descente = null;
    // La main rendue au premier geste : une page qui continue de glisser
    // pendant qu'on essaie de remonter est insupportable.
    const guets = ["wheel", "touchstart", "pointerdown", "keydown"];
    const rendreLaMain = () => {
      if (descente) cancelAnimationFrame(descente);
      descente = null;
      guets.forEach((g) => window.removeEventListener(g, rendreLaMain));
    };

    function descendre() {
      // Une ancre est une demande explicite : on ne la contredit pas.
      // En revanche on ne renonce PLUS parce que la page n'est pas en haut.
      //
      // Le garde-fou precedent testait `scrollY > 4` pour respecter une
      // position restauree par le navigateur. Consequence : des le deuxieme
      // chargement, Chrome rendait la main a l'ancienne position — mesure a
      // 701px — et la descente ne se faisait plus jamais. Au rechargement
      // comme au retour arriere, la page ne bougeait plus.
      //
      // L'animation part donc de la position courante, quelle qu'elle soit,
      // et rejoint la derniere livraison.
      if (location.hash) return;
      const depart = window.scrollY;
      const course = cible() - depart;
      if (Math.abs(course) < 8) return;
      // Duree proportionnee a la distance, bornee : une descente de 2000px a
      // la meme vitesse qu'une de 200 paraitrait soit lente soit brutale.
      const duree = Math.max(700, Math.min(1600, Math.abs(course) * 1.6));
      const t0 = performance.now();
      guets.forEach((g) => window.addEventListener(g, rendreLaMain, { passive: true, once: true }));

      (function pas(t) {
        const p = Math.min(1, (t - t0) / duree);
        // Meme sortie que le reste du site : rapide puis posee.
        const e = 1 - Math.pow(1 - p, 3);
        // « instant » explicitement : `html` porte `scroll-behavior: smooth`
        // dans le systeme editorial, et cette regle s'applique AUSSI aux
        // defilements programmes. Chaque appel devenait donc une animation du
        // navigateur, qui tramait derriere la mienne et continuait apres son
        // annulation — un geste ne rendait pas vraiment la main, et la page
        // glissait encore de 70px. Le meme piege est note dans PhotoGrid.
        window.scrollTo({ top: depart + course * e, behavior: "instant" });
        if (p < 1) descente = requestAnimationFrame(pas);
        else rendreLaMain();
      })(t0);
    }

    // La descente attend que la page soit posee : polices, images et
    // revelations deplacent le rail, donc la cible.
    if (document.readyState === "complete") requestAnimationFrame(descendre);
    else window.addEventListener("load", () => requestAnimationFrame(descendre), { once: true });
  })();
</script>
