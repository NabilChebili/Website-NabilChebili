---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import Colophon from "../components/Colophon.astro";

const profile = {
  title: "Cloud DevOps",
  subtitle:
    "Ingénieur Cloud / DevOps spécialisé Azure, IaC et DevSecOps — j’aide les équipes à livrer plus vite, plus proprement, et avec une posture sécurité solide.",
  stats: [
    { k: "Expérience", v: "+4/5 ans" },
    { k: "Spécialités", v: "Azure · CI/CD · IaC" },
    { k: "Approche", v: "Agile (Scrum/SAFe)" },
  ],
};

const expertise = [
  {
    title: "Cloud Azure (IaaS/PaaS)",
    desc: "Landing zones, réseau, services applicatifs, observabilité et standards de déploiement.",
    tags: ["VNet", "Hub & Spoke", "Firewall", "APIM", "WebApp", "Log Analytics"],
  },
  {
    title: "DevOps & IaC",
    desc: "Industrialisation CI/CD, templates, gouvernance et infrastructure as code au service de la productivité.",
    tags: ["Terraform", "Azure DevOps", "GitHub Actions", "GitLab", "YAML"],
  },
  {
    title: "DevSecOps",
    desc: "Sécurisation de la supply chain: scan code/dépendances, secrets, contrôles d’accès et politiques.",
    tags: ["GHAS", "CodeQL", "Secret scanning", "Azure Policy", "Entra ID"],
  },
  {
    title: "Scripting & automatisation",
    desc: "Automatisation pragmatique pour réduire le temps perdu sur les tâches répétitives et fiabiliser les opérations.",
    tags: ["PowerShell", "Bash", "ARM", "Python"],
  },
];

const certifications = [
  { name: "AZ-700", detail: "Designing and Implementing Microsoft Azure Networking Solutions (2025)" },
  { name: "GitHub Actions", detail: "GitHub Actions Certification (2025)" },
  { name: "AZ-400", detail: "Designing and Implementing Microsoft DevOps Solutions (2021)" },
  { name: "AZ-104", detail: "Azure Administrator Associate (2021)" },
  { name: "AZ-900", detail: "Azure Fundamentals (2021)" },
];

const missions = [
  {
    period: "2025 · 1 mois (mission active)",
    client: "RTE",
    clientLogo: "/company_logo/RTE.png",
    role: "Cloud Engineer DevOps — Azure DevOps & Azure",
    summary:
      "Conception, sécurisation et industrialisation d’environnements Azure: landing zones via AVM/Terraform, gouvernance Azure Policy et structuration AZDO.",
    bullets: [
      "Participation à la mise en place de landing zones (Terraform + Azure Verified Modules)",
      "Structuration de projets Azure DevOps: bonnes pratiques CI/CD, permissions, templates",
      "Déploiement/ajustement d’Azure Policies pour sécurité et conformité",
    ],
    stack: ["Azure", "Terraform", "AVM", "Azure DevOps", "Azure Policy", "DevSecOps"],
  },
  {
    period: "2025 · 5 mois",
    client: "Ardian",
    clientLogo: "/company_logo/Ardian.png",
    role: "Cloud Engineer DevOps — GitHub & Azure",
    summary:
      "Modernisation DevOps autour de GitHub Advanced Security et migration progressive d’Azure DevOps vers GitHub Actions, avec un focus DevSecOps.",
    bullets: [
      "Mise en place & exploitation GHAS (CodeQL, secret scanning, dépendances, alerting)",
      "Migration de pipelines Azure DevOps vers GitHub Actions + accompagnement des équipes",
      "Standards et mécanismes de sécurité intégrés aux workflows CI/CD",
    ],
    stack: ["GitHub", "GitHub Actions", "GHAS", "Azure", "Azure DevOps", "Agile"],
  },
  {
    period: "2025 · 7 mois",
    client: "Lemonway",
    clientLogo: "/company_logo/Lemonway.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Déploiement d’une infra data (incl. Databricks) via Terraform, durcissement CI/CD et conformité (PCI DSS), refonte de composants legacy.",
    bullets: [
      "Déploiement infrastructure data sur Azure (Databricks) en IaC",
      "Architecture réseau Hub & Spoke + firewall Azure (IaC)",
      "Sécurisation GitLab: runners, permissions, stratégies de branches, pipelines complexes",
    ],
    stack: ["Azure", "AWS", "GitLab", "Terraform", "Databricks", "Réseau Cloud"],
  },
  {
    period: "2024–2025 · 9 mois",
    client: "SUEZ (One Forge)",
    clientLogo: "/company_logo/Suez.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Expertise Azure DevOps pour livrer des projets ADO prêts à l’emploi: standardisation, automatisation, support et amélioration continue.",
    bullets: [
      "Livraison automatisée de projets Azure DevOps adaptés aux clients",
      "Support/formation, accompagnement des équipes et amélioration continue du produit",
      "Mise en place/optimisation de pipelines CI/CD avec contraintes sécurité",
    ],
    stack: ["Azure", "Azure DevOps", "Terraform", "PowerShell", "Kubernetes", "ServiceNow"],
  },
  {
    period: "2022–2024 · 2 ans",
    client: "Société Générale (Skynet)",
    clientLogo: "/company_logo/SG.png",
    role: "Cloud & DevOps Engineer — Team Lead & PO",
    summary:
      "Pilotage produit et delivery d’un socle de sécurité Azure: gouvernance, automatisation, conformité et exploitation.",
    bullets: [
      "Gestion d’équipe (développement PowerShell), organisation et suivi",
      "Déploiement des règles de sécurité Azure (Policy, Entra ID, Automation Account, Log Analytics…)",
      "Supervision/optimisation de l’infrastructure et gestion Agile",
    ],
    stack: ["Azure", "PowerShell", "Terraform", "Jenkins", "JIRA", "CMMI"],
  },
  {
    period: "2021–2022 · 6 mois",
    client: "Devoteam (Alfun)",
    role: "Cloud & DevOps Engineer — Azure",
    summary:
      "Automatisation de tâches récurrentes (gain de temps, fiabilité), intégration des contraintes sécurité et pont M365 ↔ Azure.",
    bullets: [
      "Scripts/outils d’automatisation (réduction des tâches manuelles)",
      "Sécurité dès la conception + conformité aux politiques internes",
      "Intégration M365 (SharePoint, Teams, OneDrive) avec Azure",
    ],
    stack: ["Azure", "PowerShell", "Azure DevOps", "JIRA", "Git", "M365"],
  },
  {
    period: "2020–2021 · 5 mois",
    client: "Bouygues Telecom",
    clientLogo: "/company_logo/Bouygues.png",
    role: "Designer UX & Développeur FullStack",
    summary:
      "Création d’un outil pour aider une équipe à piloter l’agilité et améliorer la gestion des offres mobiles/box, avec une vision globale de l’avancement.",
    bullets: [
      "Définition et analyse des besoins utilisateurs en contexte Agile",
      "Traduction des besoins en spécifications fonctionnelles claires",
      "Mise en place de réunions d’idéation et animation de sessions de brainstorming",
      "Conception de maquettes et prototypes (itérations selon retours utilisateurs/équipe)",
      "Développement d’un dashboard (front Angular, back Node) et intégration de sources de données",
    ],
    stack: ["TypeScript", "Angular", "Node.js", "Figma", "Adobe XD", "JIRA"],
  },
];

const other = {
  languages: [{ k: "Anglais", v: "Courant (TOEIC 830)" }],
  notes: [
    "J’aime les environnements complexes et la qualité d’exécution (clarté, standards, sécurité).",
    "Je privilégie la documentation courte, utile, et des templates réutilisables pour accélérer les équipes.",
  ],
};
---

<Layout
  title={profile.title}
  description={profile.subtitle}
  mainClass="page editorial"
>
  <section class="tete-page">
    <h1 class="titre-page" data-reveal data-groupe="tete">{profile.title}</h1>
    <div class="prose" data-reveal data-groupe="tete">
      <p>{profile.subtitle}</p>
    </div>
  </section>

  <section class="bandeau">
    <div class="reperes" data-reveal data-groupe="tete">
      {
        profile.stats.map((s) => (
          <div class="repere">
            <span class="repere-k">{s.k}</span>
            <span class="repere-v">{s.v}</span>
          </div>
        ))
      }
    </div>
    <div class="pile" data-reveal data-groupe="tete">
      <span class="rail-titre">Outils</span>
      <span class="pile-marques">
        {
          ["azure", "terraform", "kube", "docker", "git", "ado", "vscode"].map((n) => (
            <img src={"/devops_images/" + n + ".png"} alt="" loading="lazy" decoding="async" />
          ))
        }
      </span>
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="apport">
      <span>Ce que j’apporte</span>
      <span>({expertise.length})</span>
    </div>
    <div class="apport">
      <div class="prose" data-reveal data-groupe="apport">
        <p>
          Je conçois et j’industrialise des plateformes cloud sécurisées, en
          mettant l’accent sur la fiabilité, la gouvernance et la fluidité des
          livraisons. Mon objectif est simple&nbsp;: permettre aux équipes de
          construire et déployer en confiance, avec des standards clairs.
        </p>
      </div>
      <div class="colonnes">
        {
          expertise.map((x) => (
            <article class="bloc" data-reveal data-groupe="expertise">
              <h3>{x.title}</h3>
              <p>{x.desc}</p>
              <ul class="etiquettes" aria-label="Compétences">
                {x.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="missions">
    <div class="section-head" data-reveal data-groupe="missions">
      <span>Missions</span>
      <span>({missions.length})</span>
    </div>
    <div class="missions">
      {
        missions.map((m) => (
          <article class="mission" data-reveal data-groupe="missions">
            <div class="mission-meta">
              <span class="mission-periode">{m.period}</span>
              <span class="mission-client">{m.client}</span>
              <span class="rail-titre">Stack</span>
              <ul class="rail-liste">
                {m.stack.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <div class="mission-corps">
              <h3>{m.role}</h3>
              <p>{m.summary}</p>
              <ul class="puces">
                {m.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="certifs">
      <span>Certifications</span>
      <span>({certifications.length})</span>
    </div>
    <div class="certifs">
      {
        certifications.map((c) => (
          <div class="certif" data-reveal data-groupe="certifs">
            <span class="certif-nom">{c.name}</span>
            <span class="certif-detail">{c.detail}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="reperes">
      <span>Quelques repères</span>
      <span>({other.languages.length + other.notes.length})</span>
    </div>
    <div class="apport">
      <ul class="puces large" data-reveal data-groupe="reperes">
        {
          other.languages.map((l) => (
            <li>
              <strong>{l.k} :</strong> {l.v}
            </li>
          ))
        }
        {other.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <Colophon />
</Layout>

<style>
  /* Bandeau sous le titre : les trois repères, puis la pile technique. Le
     carrousel de logos en orbite et les pastilles en verre dépoli sont retirés
     — un système qui interdit dégradés, lueurs et ombres portées ne peut pas
     les accueillir. Les logos restent, posés à plat. */
  .bandeau {
    padding: var(--pas-6) var(--edge) 0;
  }

  .reperes {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--pas-6);
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .repere {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .repere-k {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .repere-v {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ------------------------------------------------------------- le rail ---
     Une seule mesure de colonne de gauche, 260px, partagee par la pile
     technique, les missions et les certifications : les trois sections
     s'alignent verticalement et la marge de droite devient constante. */
  .rail-titre {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .rail-liste {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.9;
    color: var(--ink);
  }

  .pile {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--pas-6);
    align-items: center;
    margin-top: var(--pas-3);
    padding-top: var(--pas-3);
    border-top: 1px solid var(--rule);
  }
  .pile-marques {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
  }
  /* Chaque logo occupe le meme emplacement : a hauteur egale, des proportions
     tres differentes donnaient des presences optiques inegales. `contain` garde
     le rapport de chacun sans le deformer. */
  .pile img {
    height: 26px;
    width: 44px;
    object-fit: contain;
    object-position: left center;
  }

  .apport,
  .missions,
  .certifs {
    padding: var(--pas-3) var(--edge) 0;
  }

  .colonnes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: var(--pas-6);
  }
  .bloc {
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .bloc h3 {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .bloc p {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  /* Étiquettes : un filet, aucun rayon, aucun fond. */
  .etiquettes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .etiquettes li {
    padding: 3px 7px;
    border: 1px solid var(--rule);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  /* Missions : la période et le client à gauche, le détail à droite, un filet
     par entrée. C’est la mise en page d’un CV imprimé. */
  .mission {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--pas-6);
    padding: var(--pas-3) 0 var(--pas-6);
    border-top: 1px solid var(--rule);
  }
  /* La premiere entree n'a pas de filet : celui de l'en-tete de section est a
     25px au-dessus, les deux se lisaient comme un doublon. */
  .mission:first-of-type,
  .certif:first-of-type {
    border-top: 0;
  }
  .mission-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .mission-meta .rail-titre {
    margin-top: var(--pas-3);
  }
  .mission-periode {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .mission-client {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .mission-corps h3 {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }
  .mission-corps p {
    margin: 0 0 12px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  .puces {
    margin: 0 0 14px;
    padding-left: 18px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }
  .puces li {
    margin-bottom: 4px;
  }
  .puces.large {
    margin: 0;
  }
  .puces strong {
    color: var(--ink);
    font-weight: 700;
  }

  .certif {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--pas-6);
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .certif-nom {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .certif-detail {
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  @media (max-width: 1100px) {
    .colonnes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Le rail de 260px ne tient plus sous 800px : avec la gouttiere il ne laissait
     que 42px au libelle d'une certification, qui en reclame 117 — d'ou un
     debordement horizontal de 55px sur la page. Les trois blocs du rail
     s'empilent. */
  @media (max-width: 800px) {
    .mission,
    .certif,
    .pile {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pas-3);
    }
    .certif {
      gap: 4px;
    }
    .pile {
      gap: 12px;
      align-items: start;
    }
  }
  @media (max-width: 700px) {
    .reperes {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pas-3);
    }
    .colonnes {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pas-3);
    }
    .bandeau {
      padding-top: var(--pas-3);
    }
    .pile {
      gap: 18px;
    }
    .pile img {
      height: 22px;
      width: 38px;
    }
  }
</style>
