---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import Colophon from "../components/Colophon.astro";
import { getImage } from "astro:assets";
import logoAzure from "../assets/devops/azure.png";
import logoTerraform from "../assets/devops/terraform.png";
import logoKube from "../assets/devops/kube.png";
import logoDocker from "../assets/devops/docker.png";
import logoGit from "../assets/devops/git.png";
import logoAdo from "../assets/devops/ado.png";
import logoVscode from "../assets/devops/vscode.png";

const profile = {
  title: "Cloud DevOps",
  subtitle:
    "Ingénieur Cloud / DevOps spécialisé Azure, IaC et DevSecOps — j’aide les équipes à livrer plus vite, plus proprement, et avec une posture sécurité solide.",
  stats: [
    { k: "Expérience", v: "+4/5 ans" },
    { k: "Spécialités", v: "Azure · CI/CD · IaC" },
    { k: "Approche", v: "Agile (Scrum/SAFe)" },
  ],
};

const expertise = [
  {
    title: "Cloud Azure (IaaS/PaaS)",
    desc: "Landing zones, réseau, services applicatifs, observabilité et standards de déploiement.",
    tags: ["VNet", "Hub & Spoke", "Firewall", "APIM", "WebApp", "Log Analytics"],
  },
  {
    title: "DevOps & IaC",
    desc: "Industrialisation CI/CD, templates, gouvernance et infrastructure as code au service de la productivité.",
    tags: ["Terraform", "Azure DevOps", "GitHub Actions", "GitLab", "YAML"],
  },
  {
    title: "DevSecOps",
    desc: "Sécurisation de la supply chain: scan code/dépendances, secrets, contrôles d’accès et politiques.",
    tags: ["GHAS", "CodeQL", "Secret scanning", "Azure Policy", "Entra ID"],
  },
  {
    title: "Scripting & automatisation",
    desc: "Automatisation pragmatique pour réduire le temps perdu sur les tâches répétitives et fiabiliser les opérations.",
    tags: ["PowerShell", "Bash", "ARM", "Python"],
  },
];

const certifications = [
  { name: "AZ-700", detail: "Designing and Implementing Microsoft Azure Networking Solutions (2025)" },
  { name: "GitHub Actions", detail: "GitHub Actions Certification (2025)" },
  { name: "AZ-400", detail: "Designing and Implementing Microsoft DevOps Solutions (2021)" },
  { name: "AZ-104", detail: "Azure Administrator Associate (2021)" },
  { name: "AZ-900", detail: "Azure Fundamentals (2021)" },
];

const missions = [
  {
    period: "2025 · 1 mois (mission active)",
    client: "RTE",
    clientLogo: "/company_logo/RTE.png",
    role: "Cloud Engineer DevOps — Azure DevOps & Azure",
    summary:
      "Conception, sécurisation et industrialisation d’environnements Azure: landing zones via AVM/Terraform, gouvernance Azure Policy et structuration AZDO.",
    bullets: [
      "Participation à la mise en place de landing zones (Terraform + Azure Verified Modules)",
      "Structuration de projets Azure DevOps: bonnes pratiques CI/CD, permissions, templates",
      "Déploiement/ajustement d’Azure Policies pour sécurité et conformité",
    ],
    stack: ["Azure", "Terraform", "AVM", "Azure DevOps", "Azure Policy", "DevSecOps"],
  },
  {
    period: "2025 · 5 mois",
    client: "Ardian",
    clientLogo: "/company_logo/Ardian.png",
    role: "Cloud Engineer DevOps — GitHub & Azure",
    summary:
      "Modernisation DevOps autour de GitHub Advanced Security et migration progressive d’Azure DevOps vers GitHub Actions, avec un focus DevSecOps.",
    bullets: [
      "Mise en place & exploitation GHAS (CodeQL, secret scanning, dépendances, alerting)",
      "Migration de pipelines Azure DevOps vers GitHub Actions + accompagnement des équipes",
      "Standards et mécanismes de sécurité intégrés aux workflows CI/CD",
    ],
    stack: ["GitHub", "GitHub Actions", "GHAS", "Azure", "Azure DevOps", "Agile"],
  },
  {
    period: "2025 · 7 mois",
    client: "Lemonway",
    clientLogo: "/company_logo/Lemonway.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Déploiement d’une infra data (incl. Databricks) via Terraform, durcissement CI/CD et conformité (PCI DSS), refonte de composants legacy.",
    bullets: [
      "Déploiement infrastructure data sur Azure (Databricks) en IaC",
      "Architecture réseau Hub & Spoke + firewall Azure (IaC)",
      "Sécurisation GitLab: runners, permissions, stratégies de branches, pipelines complexes",
    ],
    stack: ["Azure", "AWS", "GitLab", "Terraform", "Databricks", "Réseau Cloud"],
  },
  {
    period: "2024–2025 · 9 mois",
    client: "SUEZ (One Forge)",
    clientLogo: "/company_logo/Suez.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Expertise Azure DevOps pour livrer des projets ADO prêts à l’emploi: standardisation, automatisation, support et amélioration continue.",
    bullets: [
      "Livraison automatisée de projets Azure DevOps adaptés aux clients",
      "Support/formation, accompagnement des équipes et amélioration continue du produit",
      "Mise en place/optimisation de pipelines CI/CD avec contraintes sécurité",
    ],
    stack: ["Azure", "Azure DevOps", "Terraform", "PowerShell", "Kubernetes", "ServiceNow"],
  },
  {
    period: "2022–2024 · 2 ans",
    client: "Société Générale (Skynet)",
    clientLogo: "/company_logo/SG.png",
    role: "Cloud & DevOps Engineer — Team Lead & PO",
    summary:
      "Pilotage produit et delivery d’un socle de sécurité Azure: gouvernance, automatisation, conformité et exploitation.",
    bullets: [
      "Gestion d’équipe (développement PowerShell), organisation et suivi",
      "Déploiement des règles de sécurité Azure (Policy, Entra ID, Automation Account, Log Analytics…)",
      "Supervision/optimisation de l’infrastructure et gestion Agile",
    ],
    stack: ["Azure", "PowerShell", "Terraform", "Jenkins", "JIRA", "CMMI"],
  },
  {
    period: "2021–2022 · 6 mois",
    client: "Devoteam (Alfun)",
    role: "Cloud & DevOps Engineer — Azure",
    summary:
      "Automatisation de tâches récurrentes (gain de temps, fiabilité), intégration des contraintes sécurité et pont M365 ↔ Azure.",
    bullets: [
      "Scripts/outils d’automatisation (réduction des tâches manuelles)",
      "Sécurité dès la conception + conformité aux politiques internes",
      "Intégration M365 (SharePoint, Teams, OneDrive) avec Azure",
    ],
    stack: ["Azure", "PowerShell", "Azure DevOps", "JIRA", "Git", "M365"],
  },
  {
    period: "2020–2021 · 5 mois",
    client: "Bouygues Telecom",
    clientLogo: "/company_logo/Bouygues.png",
    role: "Designer UX & Développeur FullStack",
    summary:
      "Création d’un outil pour aider une équipe à piloter l’agilité et améliorer la gestion des offres mobiles/box, avec une vision globale de l’avancement.",
    bullets: [
      "Définition et analyse des besoins utilisateurs en contexte Agile",
      "Traduction des besoins en spécifications fonctionnelles claires",
      "Mise en place de réunions d’idéation et animation de sessions de brainstorming",
      "Conception de maquettes et prototypes (itérations selon retours utilisateurs/équipe)",
      "Développement d’un dashboard (front Angular, back Node) et intégration de sources de données",
    ],
    stack: ["TypeScript", "Angular", "Node.js", "Figma", "Adobe XD", "JIRA"],
  },
];

// Les logos de la pile technique. Ils passent par astro:assets : sortis en WebP
// de 256px au lieu des PNG d'origine, ou azure.png pesait a lui seul 698 Ko pour
// 1,1 Mo au total. 256px suffit largement, le morphing echantillonne a ~202px.
const brut = [
  { src: logoAzure, nom: "Azure" },
  { src: logoTerraform, nom: "Terraform" },
  { src: logoKube, nom: "Kubernetes" },
  { src: logoDocker, nom: "Docker" },
  { src: logoGit, nom: "GitHub" },
  { src: logoAdo, nom: "Azure DevOps" },
  { src: logoVscode, nom: "VS Code" },
];
const outils = await Promise.all(
  brut.map(async (o) => ({
    nom: o.nom,
    src: (await getImage({ src: o.src, width: 256, format: "webp" })).src,
  }))
);

const other = {
  languages: [{ k: "Anglais", v: "Courant (TOEIC 830)" }],
  notes: [
    "J’aime les environnements complexes et la qualité d’exécution (clarté, standards, sécurité).",
    "Je privilégie la documentation courte, utile, et des templates réutilisables pour accélérer les équipes.",
  ],
};
---

<Layout
  title={profile.title}
  description={profile.subtitle}
  mainClass="page editorial"
>
  <section class="tete-page">
    <div class="tete-texte">
      <h1 class="titre-page" data-reveal data-groupe="tete">{profile.title}</h1>
      <div class="prose" data-reveal data-groupe="tete">
        <p>{profile.subtitle}</p>
      </div>
    </div>

    <figure class="outils-bloc" data-reveal data-groupe="tete">
      <figcaption id="outils-nom">Outils &middot; {outils.length}</figcaption>
      <canvas id="outils-scene" data-outils={JSON.stringify(outils)} aria-hidden="true"
      ></canvas>
    </figure>
  </section>

  <div class="reperes" data-reveal data-groupe="tete">
    {
      profile.stats.map((s) => (
        <div class="repere">
          <span class="repere-k">{s.k}</span>
          <span class="repere-v">{s.v}</span>
        </div>
      ))
    }
  </div>

  <section>
    <div class="section-head grande" data-reveal data-groupe="apport">
      <span><i class="section-num">01</i> Ce que j’apporte</span>
      <span>({expertise.length})</span>
    </div>
    <div class="apport">
      <div class="prose" data-reveal data-groupe="apport">
        <p>
          Je conçois et j’industrialise des plateformes cloud sécurisées, en
          mettant l’accent sur la fiabilité, la gouvernance et la fluidité des
          livraisons. Mon objectif est simple&nbsp;: permettre aux équipes de
          construire et déployer en confiance, avec des standards clairs.
        </p>
      </div>
      <div class="colonnes">
        {
          expertise.map((x) => (
            <article class="bloc" data-reveal data-groupe="expertise">
              <h3>{x.title}</h3>
              <p>{x.desc}</p>
              <ul class="etiquettes" aria-label="Compétences">
                {x.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="missions">
    <div class="section-head grande" data-reveal data-groupe="missions">
      <span><i class="section-num">02</i> Missions</span>
      <span>({missions.length})</span>
    </div>
    <div class="missions">
      {
        missions.map((m) => (
          <article class="mission" data-reveal data-groupe="missions">
            <div class="mission-meta">
              <span class="mission-periode">{m.period}</span>
              <span class="mission-client">{m.client}</span>
              {m.clientLogo ? (
                <img class="mission-logo" src={m.clientLogo} alt={"Logo " + m.client} loading="lazy" />
              ) : null}
              <span class="rail-titre">Stack</span>
              <ul class="rail-liste">
                {m.stack.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <div class="mission-corps">
              <h3>{m.role}</h3>
              <p>{m.summary}</p>
              <ul class="puces">
                {m.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head grande" data-reveal data-groupe="certifs">
      <span><i class="section-num">03</i> Certifications</span>
      <span>({certifications.length})</span>
    </div>
    <div class="certifs">
      {
        certifications.map((c) => (
          <div class="certif" data-reveal data-groupe="certifs">
            <span class="certif-nom">{c.name}</span>
            <span class="certif-detail">{c.detail}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head grande" data-reveal data-groupe="reperes">
      <span><i class="section-num">04</i> Quelques repères</span>
      <span>({other.languages.length + other.notes.length})</span>
    </div>
    <div class="apport">
      <ul class="puces large" data-reveal data-groupe="reperes">
        {
          other.languages.map((l) => (
            <li>
              <strong>{l.k} :</strong> {l.v}
            </li>
          ))
        }
        {other.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <Colophon />

  <script>
    import { morphOutils } from "../scripts/morphOutils.js";

    const toile = document.getElementById("outils-scene");
    if (toile) {
      const outils = JSON.parse(toile.dataset.outils);
      const libelle = document.getElementById("outils-nom");
      const bloc = toile.parentElement;

      // La toile epouse la largeur de sa PISTE de grille, plafonnee a 400px :
      // au-dela, la surface a composer chaque image faisait chuter la cadence
      // de 60 a 34 images/s.
      // On lit la piste resolue et non la boite du bloc : celle-ci depend de la
      // toile qu'elle contient, la mesure etait donc circulaire et donnait 459px
      // pour une piste de 368 — la toile empietait alors sur le texte.
      const calculer = () => {
        const grille = bloc.parentElement;
        const pistes = getComputedStyle(grille).gridTemplateColumns.split(" ").map(parseFloat);
        const dispo = pistes.length > 1 ? pistes[pistes.length - 1] : pistes[0];
        return Math.round(Math.max(240, Math.min(400, dispo)));
      };

      let taille = calculer();
      let arreter = await morphOutils(toile, taille, outils, (nom) => {
        if (libelle) libelle.textContent = nom;
      });

      // Reconstruction seulement si la taille change vraiment : rechantillonner
      // les sept logos coute une cinquantaine de millisecondes.
      let minuteur = 0;
      addEventListener("resize", () => {
        clearTimeout(minuteur);
        minuteur = setTimeout(async () => {
          const t = calculer();
          if (Math.abs(t - taille) < 8) return;
          taille = t;
          arreter && arreter();
          arreter = await morphOutils(toile, taille, outils, (nom) => {
            if (libelle) libelle.textContent = nom;
          });
        }, 250);
      });
    }
  </script>
</Layout>

<style>
  /* Le titre et le nuage sur la meme ligne. Avant, le nuage vivait dans une
     colonne a droite de l'intro : la colonne de gauche s'arretait 180px plus
     haut que lui, le filet des reperes se coupait a 992px alors que tous les
     autres filets de la page vont de bord a bord, et il restait un grand vide
     a droite du titre. Le remonter regle les trois d'un coup. */
  /* Le bloc de texte prend sa largeur naturelle, et le logo se CENTRE dans le
     reliquat. Avec un logo epingle au bord droit, tout le reliquat s'accumulait
     entre les deux : le vide central passait de 125px a 938px avec la largeur
     de la fenetre pendant que la marge droite restait a 34px. Ici l'air est
     rigoureusement egal a gauche et a droite du logo, a toutes les largeurs.
     Gouttiere de colonne a zero : c'est le centrage qui doit produire les deux
     ecarts, une gouttiere s'ajouterait d'un seul cote. */
  .tete-page {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0;
    row-gap: var(--pas-6);
    align-items: start;
  }
  /* Le bloc occupe toute sa piste et la toile se centre dedans : sa taille est
     calculee au chargement depuis la largeur reelle de cette piste, de sorte
     que l'animation grandisse avec l'espace disponible au lieu de rester a une
     taille fixe. Sa legende partage son axe. */
  .tete-page > .outils-bloc {
    width: 100%;
    align-items: center;
  }
  /* Le titre passe sur deux lignes et l'intro le suit dans la meme colonne :
     sans ca le nuage (326px) surplombait le titre (118px) de 290px de blanc.
     Les deux colonnes font desormais des hauteurs comparables. */
  .tete-texte > .prose {
    margin-top: var(--pas-6);
  }

  /* `max-width: min-content` vaut la largeur du mot le plus long : le titre se
     replie donc toujours en CLOUD / DEVOPS, a toutes les largeurs. Sans valeur
     en dur — pas de seuil a maintenir si le corps du titre change.
     La piste, elle, reste en max-content : le plafond de 68 caracteres de
     l'intro borne sa contribution, donc la piste vaut la largeur de l'intro et
     c'est bien ELLE qui definit le bord droit du bloc. Le reliquat se mesure
     donc a partir d'un bord reel, ce qui garde l'air egal autour du logo. */
  .tete-page .titre-page {
    max-width: min-content;
  }

  /* Le morphing des logos. Le dessin est fait en canvas par
     src/scripts/morphOutils.js — voir l'en-tete de ce fichier pour les deux
     regles a ne pas defaire. */
  .outils-bloc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
  }
  #outils-scene {
    display: block;
  }
  .outils-bloc figcaption {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  /* Trois colonnes egales, et le filet court de bord a bord : il est porte par
     un element pleine largeur dont le rembourrage cale le contenu sur --edge,
     exactement comme un en-tete de section. */
  .reperes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--pas-6);
    margin-top: var(--pas-6);
    padding: 12px var(--edge) 0;
    border-top: 1px solid var(--ink);
  }
  .repere {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .repere-k {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .repere-v {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ------------------------------------------------------------- le rail ---
     Une seule mesure de colonne de gauche, 260px, partagee par la pile
     technique, les missions et les certifications : les trois sections
     s'alignent verticalement et la marge de droite devient constante. */
  .rail-titre {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .rail-liste {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.9;
    color: var(--ink);
  }


  .apport,
  .missions,
  .certifs {
    padding: var(--pas-3) var(--edge) 0;
  }

  .colonnes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: var(--pas-6);
  }
  .bloc {
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .bloc h3 {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .bloc p {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  /* Étiquettes : un filet, aucun rayon, aucun fond. */
  .etiquettes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .etiquettes li {
    padding: 3px 7px;
    border: 1px solid var(--rule);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  /* Missions : la période et le client à gauche, le détail à droite, un filet
     par entrée. C’est la mise en page d’un CV imprimé. */
  .mission {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--pas-6);
    padding: var(--pas-3) 0 var(--pas-6);
    border-top: 1px solid var(--rule);
  }
  /* La premiere entree n'a pas de filet : celui de l'en-tete de section est a
     25px au-dessus, les deux se lisaient comme un doublon. */
  .mission:first-of-type,
  .certif:first-of-type {
    border-top: 0;
  }
  .mission-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .mission-meta .rail-titre {
    margin-top: var(--pas-3);
  }
  .mission-periode {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .mission-client {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .mission-logo {
    height: 20px;
    width: 84px;
    object-fit: contain;
    object-position: left center;
    margin-top: 10px;
  }
  :global(.reveal-ok) .mission-logo {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--duree-longue) var(--sortie),
      transform var(--duree-longue) var(--sortie);
    transition-delay: 260ms;
  }
  :global(.reveal-ok) [data-reveal].vu .mission-logo {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.reveal-ok) .mission-logo {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .mission-corps h3 {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }
  .mission-corps p {
    margin: 0 0 12px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  .puces {
    margin: 0 0 14px;
    padding-left: 18px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }
  .puces li {
    margin-bottom: 4px;
  }
  .puces.large {
    margin: 0;
  }
  .puces strong {
    color: var(--ink);
    font-weight: 700;
  }

  .certif {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--pas-6);
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .certif-nom {
