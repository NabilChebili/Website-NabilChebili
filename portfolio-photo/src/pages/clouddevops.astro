---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import Colophon from "../components/Colophon.astro";
import { getImage } from "astro:assets";
import logoAzure from "../assets/devops/azure.png";
import logoTerraform from "../assets/devops/terraform.png";
import logoKube from "../assets/devops/kube.png";
import logoDocker from "../assets/devops/docker.png";
import logoGit from "../assets/devops/git.png";
import logoAdo from "../assets/devops/ado.png";
import logoVscode from "../assets/devops/vscode.png";

const profile = {
  title: "Cloud DevOps",
  subtitle:
    "Ingénieur Cloud / DevOps spécialisé Azure, IaC et DevSecOps — j’aide les équipes à livrer plus vite, plus proprement, et avec une posture sécurité solide.",
  stats: [
    { k: "Expérience", v: "+4/5 ans" },
    { k: "Spécialités", v: "Azure · CI/CD · IaC" },
    { k: "Approche", v: "Agile (Scrum/SAFe)" },
  ],
};

const expertise = [
  {
    title: "Cloud Azure (IaaS/PaaS)",
    desc: "Landing zones, réseau, services applicatifs, observabilité et standards de déploiement.",
    tags: ["VNet", "Hub & Spoke", "Firewall", "APIM", "WebApp", "Log Analytics"],
  },
  {
    title: "DevOps & IaC",
    desc: "Industrialisation CI/CD, templates, gouvernance et infrastructure as code au service de la productivité.",
    tags: ["Terraform", "Azure DevOps", "GitHub Actions", "GitLab", "YAML"],
  },
  {
    title: "DevSecOps",
    desc: "Sécurisation de la supply chain: scan code/dépendances, secrets, contrôles d’accès et politiques.",
    tags: ["GHAS", "CodeQL", "Secret scanning", "Azure Policy", "Entra ID"],
  },
  {
    title: "Scripting & automatisation",
    desc: "Automatisation pragmatique pour réduire le temps perdu sur les tâches répétitives et fiabiliser les opérations.",
    tags: ["PowerShell", "Bash", "ARM", "Python"],
  },
];

const certifications = [
  { name: "AZ-700", detail: "Designing and Implementing Microsoft Azure Networking Solutions (2025)" },
  { name: "GitHub Actions", detail: "GitHub Actions Certification (2025)" },
  { name: "AZ-400", detail: "Designing and Implementing Microsoft DevOps Solutions (2021)" },
  { name: "AZ-104", detail: "Azure Administrator Associate (2021)" },
  { name: "AZ-900", detail: "Azure Fundamentals (2021)" },
];

const missions = [
  {
    period: "2025 · 1 mois (mission active)",
    client: "RTE",
    clientLogo: "/company_logo/RTE.png",
    role: "Cloud Engineer DevOps — Azure DevOps & Azure",
    summary:
      "Conception, sécurisation et industrialisation d’environnements Azure: landing zones via AVM/Terraform, gouvernance Azure Policy et structuration AZDO.",
    bullets: [
      "Participation à la mise en place de landing zones (Terraform + Azure Verified Modules)",
      "Structuration de projets Azure DevOps: bonnes pratiques CI/CD, permissions, templates",
      "Déploiement/ajustement d’Azure Policies pour sécurité et conformité",
    ],
    stack: ["Azure", "Terraform", "AVM", "Azure DevOps", "Azure Policy", "DevSecOps"],
  },
  {
    period: "2025 · 5 mois",
    client: "Ardian",
    clientLogo: "/company_logo/Ardian.png",
    role: "Cloud Engineer DevOps — GitHub & Azure",
    summary:
      "Modernisation DevOps autour de GitHub Advanced Security et migration progressive d’Azure DevOps vers GitHub Actions, avec un focus DevSecOps.",
    bullets: [
      "Mise en place & exploitation GHAS (CodeQL, secret scanning, dépendances, alerting)",
      "Migration de pipelines Azure DevOps vers GitHub Actions + accompagnement des équipes",
      "Standards et mécanismes de sécurité intégrés aux workflows CI/CD",
    ],
    stack: ["GitHub", "GitHub Actions", "GHAS", "Azure", "Azure DevOps", "Agile"],
  },
  {
    period: "2025 · 7 mois",
    client: "Lemonway",
    clientLogo: "/company_logo/Lemonway.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Déploiement d’une infra data (incl. Databricks) via Terraform, durcissement CI/CD et conformité (PCI DSS), refonte de composants legacy.",
    bullets: [
      "Déploiement infrastructure data sur Azure (Databricks) en IaC",
      "Architecture réseau Hub & Spoke + firewall Azure (IaC)",
      "Sécurisation GitLab: runners, permissions, stratégies de branches, pipelines complexes",
    ],
    stack: ["Azure", "AWS", "GitLab", "Terraform", "Databricks", "Réseau Cloud"],
  },
  {
    period: "2024–2025 · 9 mois",
    client: "SUEZ (One Forge)",
    clientLogo: "/company_logo/Suez.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Expertise Azure DevOps pour livrer des projets ADO prêts à l’emploi: standardisation, automatisation, support et amélioration continue.",
    bullets: [
      "Livraison automatisée de projets Azure DevOps adaptés aux clients",
      "Support/formation, accompagnement des équipes et amélioration continue du produit",
      "Mise en place/optimisation de pipelines CI/CD avec contraintes sécurité",
    ],
    stack: ["Azure", "Azure DevOps", "Terraform", "PowerShell", "Kubernetes", "ServiceNow"],
  },
  {
    period: "2022–2024 · 2 ans",
    client: "Société Générale (Skynet)",
    clientLogo: "/company_logo/SG.png",
    role: "Cloud & DevOps Engineer — Team Lead & PO",
    summary:
      "Pilotage produit et delivery d’un socle de sécurité Azure: gouvernance, automatisation, conformité et exploitation.",
    bullets: [
      "Gestion d’équipe (développement PowerShell), organisation et suivi",
      "Déploiement des règles de sécurité Azure (Policy, Entra ID, Automation Account, Log Analytics…)",
      "Supervision/optimisation de l’infrastructure et gestion Agile",
    ],
    stack: ["Azure", "PowerShell", "Terraform", "Jenkins", "JIRA", "CMMI"],
  },
  {
    period: "2021–2022 · 6 mois",
    client: "Devoteam (Alfun)",
    role: "Cloud & DevOps Engineer — Azure",
    summary:
      "Automatisation de tâches récurrentes (gain de temps, fiabilité), intégration des contraintes sécurité et pont M365 ↔ Azure.",
    bullets: [
      "Scripts/outils d’automatisation (réduction des tâches manuelles)",
      "Sécurité dès la conception + conformité aux politiques internes",
      "Intégration M365 (SharePoint, Teams, OneDrive) avec Azure",
    ],
    stack: ["Azure", "PowerShell", "Azure DevOps", "JIRA", "Git", "M365"],
  },
  {
    period: "2020–2021 · 5 mois",
    client: "Bouygues Telecom",
    clientLogo: "/company_logo/Bouygues.png",
    role: "Designer UX & Développeur FullStack",
    summary:
      "Création d’un outil pour aider une équipe à piloter l’agilité et améliorer la gestion des offres mobiles/box, avec une vision globale de l’avancement.",
    bullets: [
      "Définition et analyse des besoins utilisateurs en contexte Agile",
      "Traduction des besoins en spécifications fonctionnelles claires",
      "Mise en place de réunions d’idéation et animation de sessions de brainstorming",
      "Conception de maquettes et prototypes (itérations selon retours utilisateurs/équipe)",
      "Développement d’un dashboard (front Angular, back Node) et intégration de sources de données",
    ],
    stack: ["TypeScript", "Angular", "Node.js", "Figma", "Adobe XD", "JIRA"],
  },
];

// Les logos de la pile technique. Ils passent par astro:assets : sortis en WebP
// de 256px au lieu des PNG d'origine, ou azure.png pesait a lui seul 698 Ko pour
// 1,1 Mo au total. 256px suffit largement, le morphing echantillonne a ~202px.
const brut = [
  { src: logoAzure, nom: "Azure", role: "Cloud" },
  { src: logoTerraform, nom: "Terraform", role: "Infra as code" },
  { src: logoKube, nom: "Kubernetes", role: "Orchestration" },
  { src: logoDocker, nom: "Docker", role: "Conteneurs" },
  { src: logoGit, nom: "GitHub", role: "Sources" },
  { src: logoAdo, nom: "Azure DevOps", role: "CI / CD" },
  { src: logoVscode, nom: "VS Code", role: "Poste de travail" },
];
const outils = await Promise.all(
  brut.map(async (o) => ({
    nom: o.nom,
    role: o.role,
    src: (await getImage({ src: o.src, width: 256, format: "webp" })).src,
  }))
);

const other = {
  languages: [{ k: "Anglais", v: "Courant (TOEIC 830)" }],
  notes: [
    "J’aime les environnements complexes et la qualité d’exécution (clarté, standards, sécurité).",
    "Je privilégie la documentation courte, utile, et des templates réutilisables pour accélérer les équipes.",
  ],
};
---

<Layout
  title={profile.title}
  description={profile.subtitle}
  mainClass="page editorial"
>
  {/* Ouverture au rythme de celle de l'accueil : de petits faits d'abord, qui
      donnent envie de lire, puis le titre bord a bord qui accroche l'oeil, puis
      une seule ligne — la phrase d'intention a gauche, le lien vers la suite a
      droite. Avant, la page ouvrait directement sur un mur d'information. */}
  <section class="ouverture">
    <div class="meta-row" data-reveal data-groupe="tete">
      <span>
        <b>{missions.length}</b> missions &middot; <b>{certifications.length}</b> certifications
      </span>
      <span>Ingénieur Cloud &amp; DevOps &middot; <b>+4</b> ans</span>
    </div>

    <h1 class="titre-geant" data-reveal data-groupe="tete">{profile.title}</h1>

    <div class="ouverture-pied" data-reveal data-groupe="tete">
      <p>{profile.subtitle}</p>
      <a class="jump" href="#missions">Voir les missions &#8595;</a>
    </div>
  </section>

  <div class="reperes" data-reveal data-groupe="tete">
    {
      profile.stats.map((s) => (
        <div class="repere">
          <span class="repere-k">{s.k}</span>
          <span class="repere-v">{s.v}</span>
        </div>
      ))
    }
  </div>

  <section>
    <div class="section-head grande" data-reveal data-groupe="apport">
      <span><i class="section-num">01</i> Ce que j’apporte</span>
      <span>({expertise.length})</span>
    </div>
    <div class="apport">
      <div class="prose" data-reveal data-groupe="apport">
        <p>
          Je conçois et j’industrialise des plateformes cloud sécurisées, en
          mettant l’accent sur la fiabilité, la gouvernance et la fluidité des
          livraisons. Mon objectif est simple&nbsp;: permettre aux équipes de
          construire et déployer en confiance, avec des standards clairs.
        </p>
      </div>
      <div class="colonnes">
        {
          expertise.map((x) => (
            <article class="bloc" data-reveal data-groupe="expertise">
              <h3>{x.title}</h3>
              <p>{x.desc}</p>
              <ul class="etiquettes" aria-label="Compétences">
                {x.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* L'animation a maintenant son chapitre, en face de la liste des outils dont
      l'element courant s'allume avec elle. Elle n'illustre plus rien de vague
      dans un coin : elle EST le contenu de ce chapitre, et elle sert a le lire. */}
  <section id="outils">
    <div class="section-head grande" data-reveal data-groupe="outils">
      <span><i class="section-num">02</i> Outils</span>
      <span>({outils.length})</span>
    </div>
    <div class="outils" data-reveal data-groupe="outils">
      <figure class="outils-bloc">
        <canvas id="outils-scene" data-outils={JSON.stringify(outils)} aria-hidden="true"
        ></canvas>
      </figure>
      <ul class="outils-liste" id="outils-liste">
        {
          outils.map((o) => (
            <li data-nom={o.nom}>
              <span>{o.nom}</span>
              <span class="outils-role">{o.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="missions">
    <div class="section-head grande" data-reveal data-groupe="missions">
      <span><i class="section-num">03</i> Missions</span>
      <span>({missions.length})</span>
    </div>
    <div class="missions">
      {
        missions.map((m) => (
          <article class="mission" data-reveal data-groupe="missions">
            <div class="mission-meta">
              <span class="mission-periode">{m.period.replace(" (mission active)", "")}</span>
              <span class="mission-client">{m.client}</span>
              {m.clientLogo ? (
                <img class="mission-logo" src={m.clientLogo} alt={"Logo " + m.client} loading="lazy" />
              ) : null}
              {m.period.includes("active") ? <span class="mission-encours">En cours</span> : null}
              <span class="rail-titre">Stack</span>
              <ul class="rail-liste">
                {m.stack.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <div class="mission-corps">
              <h3>{m.role}</h3>
              <p>{m.summary}</p>
              <ul class="puces">
                {m.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head grande" data-reveal data-groupe="certifs">
      <span><i class="section-num">04</i> Certifications</span>
      <span>({certifications.length})</span>
    </div>
    <div class="certifs">
      {
        certifications.map((c) => (
          <div class="certif" data-reveal data-groupe="certifs">
            <span class="certif-nom">{c.name}</span>
            <span class="certif-detail">{c.detail}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head grande" data-reveal data-groupe="reperes">
      <span><i class="section-num">05</i> Quelques repères</span>
      <span>({other.languages.length + other.notes.length})</span>
    </div>
    <div class="certifs">
      {
        other.languages.map((l) => (
          <div class="certif" data-reveal data-groupe="reperes">
            <span class="certif-nom">{l.k}</span>
            <span class="certif-detail">{l.v}</span>
          </div>
        ))
      }
      <div class="notes" data-reveal data-groupe="reperes">
        {other.notes.map((n) => <p>{n}</p>)}
      </div>
    </div>
  </section>

  <Colophon />

  <script>
    import { morphOutils } from "../scripts/morphOutils.js";

    const toile = document.getElementById("outils-scene");
    if (toile) {
      const outils = JSON.parse(toile.dataset.outils);
      const liste = document.getElementById("outils-liste");
      const bloc = toile.parentElement;

      // L'element courant de la liste s'allume avec l'animation : c'est ce qui
      // relie le morphing au contenu au lieu d'en faire un ornement.
      const allumer = (nom) => {
        if (!liste) return;
        for (const li of liste.children) {
          li.classList.toggle("actif", li.dataset.nom === nom);
        }
      };

      // La toile epouse la largeur de sa piste de grille, plafonnee a 400px : la
      // composition est en O(L²) et au-dela la cadence tombait de 60 a 34
      // images/s. On lit la piste resolue et non la boite du bloc, dont la
      // largeur depend de la toile qu'elle contient — la mesure serait circulaire.
      const calculer = () => {
        // Depuis le viewport, PAS depuis la piste de grille : celle-ci est en
        // max-content, donc sa largeur est celle de la toile qu'elle contient.
        // La mesure serait circulaire et la toile resterait a sa taille par
        // defaut de 300px.
        const l = document.documentElement.clientWidth;
        return Math.round(Math.max(240, Math.min(400, l * 0.28)));
      };

      let taille = calculer();
      let arreter = await morphOutils(toile, taille, outils, allumer);

      let minuteur = 0;
      addEventListener("resize", () => {
        clearTimeout(minuteur);
        minuteur = setTimeout(async () => {
          const t = calculer();
          if (Math.abs(t - taille) < 8) return;
          taille = t;
          arreter && arreter();
          arreter = await morphOutils(toile, taille, outils, allumer);
        }, 250);
      });
    }
  </script>
</Layout>

<style>
  /* ------------------------------------------------------------ ouverture ---
     Reprend le registre de l'accueil : le titre bord a bord est l'unique moment
     display de la page, sa taille pilotee par la largeur du viewport et non par
     l'echelle de pas. Les regles sont locales a cette page : celles de l'accueil
     vivent dans home-editorial.css et n'ont pas a etre partagees pour l'instant. */
  .ouverture {
    overflow: clip;
    padding: 8px var(--edge) 0;
  }
  .titre-geant {
    overflow: clip;
    margin: 26px 0 0;
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    /* Le 18,7vw de l'accueil coupait ce titre : « CLOUD DEVOPS » fait 5,356
       fois son corps en largeur contre 4,927 pour « NABIL CHEBILI » — des O, U
       et D contre des I et L. A 1440px, 82px depassaient et le S final etait
       rogne. On divise donc la largeur DISPONIBLE (viewport moins les deux
       retraits de bord) par ce rapport mesure : le titre tient exactement, a
       toute largeur.
       Diviseur porte de 5,4 a 7,8 pour suivre la meme reduction que le titre
       de l'accueil (18,7vw -> 13vw, environ -30%) : a 1440px le titre passe de
       252px a 174px. Le rapport texte/corps (5,356) ne change pas, donc la
       marge de non-rognage grandit d'autant — aucun risque de recoupe. */
    font-size: clamp(44px, calc((100vw - 2 * var(--edge)) / 7.8), 300px);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .ouverture-pied {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
    margin-top: 22px;
    padding-bottom: 4px;
  }
  .ouverture-pied p {
    margin: 0;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-55);
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
  }

  /* Les trois reperes, centres en bloc sous un filet qui court de bord a bord.
     Avant, c'etait une grille de trois colonnes egales : les valeurs ont des
     largeurs tres inegales (103, 210 et 227px), donc chacune se collait a
     gauche de son tiers et le bloc s'arretait a 234px du bord droit alors qu'il
     partait a 40px du gauche. Il avait l'air aligne a gauche sans l'etre.

     En `flex` avec `wrap` plutot qu'en trois colonnes `max-content` : le total
     des trois valeurs plus les ecarts frole la largeur disponible vers 700px, et
     un retour a la ligne est toujours preferable a un debordement. Ici c'est
     structurellement impossible de deborder. */
  /* Pas de filet noir : ce trait marque ailleurs le DEBUT d'un chapitre
     numerote (01, 02...), et les reperes ne sont pas un chapitre, ils
     appartiennent a l'ouverture — meme groupe de reveal que le titre et le
     sous-titre. Le filet les faisait lire comme une section a part alors
     qu'ils prolongent l'en-tete. Rapprocher (pas-8 + filet -> pas-6, sans
     rien) les rattache visuellement au bloc du haut ; le vrai chapitre
     suivant garde son filet et ses pas-10 de marge, donc la coupure reste
     lisible la ou elle compte. */
  .reperes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: clamp(28px, 5vw, 80px);
    row-gap: var(--pas-3);
    margin-top: var(--pas-6);
    padding: 0 var(--edge);
  }
  .reperes .repere {
    text-align: center;
  }
  .repere {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .repere-k {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .repere-v {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* --------------------------------------------------------------- outils ---
     La toile a gauche, calee sur le bord comme tout le reste de la page, et la
     liste en face. L'element courant s'allume : le morphing sert alors a lire
     la liste au lieu de decorer un coin. */
  .outils {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--pas-6);
    align-items: center;
    padding: var(--pas-3) var(--edge) 0;
  }
  .outils-bloc {
    margin: 0;
  }
  #outils-scene {
    display: block;
  }
  .outils-liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .outils-liste li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 7px 0;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-55);
    transition: color var(--duree) var(--sortie),
      border-top-color var(--duree) var(--sortie);
  }
  .outils-liste li:first-child {
    border-top-color: var(--ink);
  }
  .outils-liste li.actif {
    color: var(--ink);
    border-top-color: var(--ink);
  }
  .outils-role {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    /* Pas --rule : #c9c9c4 sur le papier ne donne que 1,51:1 de contraste, et
       ce libelle fait 10px. #6e6e68 monte a 4,67:1 tout en restant plus clair
       que --ink-55, donc la hierarchie nom / role tient sans sacrifier la
       lisibilite. */
    color: #6e6e68;
    transition: color var(--duree) var(--sortie);
  }
  .outils-liste li.actif .outils-role {
    color: var(--ink);
  }

  /* La barre du haut est fixe sur 64px : sans cette marge, une ancre depose le
     titre du chapitre DERRIERE elle. Le lien « Voir les missions » atterrissait
     sur un « 03 Missions » a moitie masque. */
  #outils,
  #missions {
    scroll-margin-top: 88px;
  }

  /* ------------------------------------------------------- ce que j'apporte --- */
  .apport,
  .missions,
  .certifs {
    padding: var(--pas-3) var(--edge) 0;
  }
  .colonnes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: var(--pas-6);
  }
  .bloc {
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .bloc h3 {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .bloc p {
    margin: 0 0 12px;
    font-size: 15px;
