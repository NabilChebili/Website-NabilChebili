---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import Colophon from "../components/Colophon.astro";
import { getImage, Image } from "astro:assets";
import photoPro from "../assets/nabil-ishane.jpg";
import logoAzure from "../assets/devops/azure.png";
import logoTerraform from "../assets/devops/terraform.png";
import logoKube from "../assets/devops/kube.png";
import logoDocker from "../assets/devops/docker.png";
import logoGit from "../assets/devops/git.png";
import logoAdo from "../assets/devops/ado.png";
import logoVscode from "../assets/devops/vscode.png";

const profile = {
  title: "Cloud DevOps",
  subtitle:
    "Ingénieur Cloud / DevOps spécialisé Azure, IaC et DevSecOps — j’aide les équipes à livrer plus vite, plus proprement, et avec une posture sécurité solide.",
  stats: [
    { k: "Expérience", v: "+4/5 ans" },
    { k: "Spécialités", v: "Azure · CI/CD · IaC" },
    { k: "Approche", v: "Agile (Scrum/SAFe)" },
  ],
};

const expertise = [
  {
    title: "Cloud Azure (IaaS/PaaS)",
    desc: "Landing zones, réseau, services applicatifs, observabilité et standards de déploiement.",
    tags: ["VNet", "Hub & Spoke", "Firewall", "APIM", "WebApp", "Log Analytics"],
  },
  {
    title: "DevOps & IaC",
    desc: "Industrialisation CI/CD, templates, gouvernance et infrastructure as code au service de la productivité.",
    tags: ["Terraform", "Azure DevOps", "GitHub Actions", "GitLab", "YAML"],
  },
  {
    title: "DevSecOps",
    desc: "Sécurisation de la supply chain: scan code/dépendances, secrets, contrôles d’accès et politiques.",
    tags: ["GHAS", "CodeQL", "Secret scanning", "Azure Policy", "Entra ID"],
  },
  {
    title: "Scripting & automatisation",
    desc: "Automatisation pragmatique pour réduire le temps perdu sur les tâches répétitives et fiabiliser les opérations.",
    tags: ["PowerShell", "Bash", "ARM", "Python"],
  },
];

const certifications = [
  { name: "AZ-700", detail: "Designing and Implementing Microsoft Azure Networking Solutions (2025)" },
  { name: "GitHub Actions", detail: "GitHub Actions Certification (2025)" },
  { name: "AZ-400", detail: "Designing and Implementing Microsoft DevOps Solutions (2021)" },
  { name: "AZ-104", detail: "Azure Administrator Associate (2021)" },
  { name: "AZ-900", detail: "Azure Fundamentals (2021)" },
];

const missions = [
  {
    period: "2025 · 1 mois (mission active)",
    client: "RTE",
    clientLogo: "/company_logo/RTE.png",
    role: "Cloud Engineer DevOps — Azure DevOps & Azure",
    summary:
      "Conception, sécurisation et industrialisation d’environnements Azure: landing zones via AVM/Terraform, gouvernance Azure Policy et structuration AZDO.",
    bullets: [
      "Participation à la mise en place de landing zones (Terraform + Azure Verified Modules)",
      "Structuration de projets Azure DevOps: bonnes pratiques CI/CD, permissions, templates",
      "Déploiement/ajustement d’Azure Policies pour sécurité et conformité",
    ],
    stack: ["Azure", "Terraform", "AVM", "Azure DevOps", "Azure Policy", "DevSecOps"],
  },
  {
    period: "2025 · 5 mois",
    client: "Ardian",
    clientLogo: "/company_logo/Ardian.png",
    role: "Cloud Engineer DevOps — GitHub & Azure",
    summary:
      "Modernisation DevOps autour de GitHub Advanced Security et migration progressive d’Azure DevOps vers GitHub Actions, avec un focus DevSecOps.",
    bullets: [
      "Mise en place & exploitation GHAS (CodeQL, secret scanning, dépendances, alerting)",
      "Migration de pipelines Azure DevOps vers GitHub Actions + accompagnement des équipes",
      "Standards et mécanismes de sécurité intégrés aux workflows CI/CD",
    ],
    stack: ["GitHub", "GitHub Actions", "GHAS", "Azure", "Azure DevOps", "Agile"],
  },
  {
    period: "2025 · 7 mois",
    client: "Lemonway",
    clientLogo: "/company_logo/Lemonway.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Déploiement d’une infra data (incl. Databricks) via Terraform, durcissement CI/CD et conformité (PCI DSS), refonte de composants legacy.",
    bullets: [
      "Déploiement infrastructure data sur Azure (Databricks) en IaC",
      "Architecture réseau Hub & Spoke + firewall Azure (IaC)",
      "Sécurisation GitLab: runners, permissions, stratégies de branches, pipelines complexes",
    ],
    stack: ["Azure", "AWS", "GitLab", "Terraform", "Databricks", "Réseau Cloud"],
  },
  {
    period: "2024–2025 · 9 mois",
    client: "SUEZ (One Forge)",
    clientLogo: "/company_logo/Suez.png",
    role: "Consultant Cloud Engineer & DevOps — Azure",
    summary:
      "Expertise Azure DevOps pour livrer des projets ADO prêts à l’emploi: standardisation, automatisation, support et amélioration continue.",
    bullets: [
      "Livraison automatisée de projets Azure DevOps adaptés aux clients",
      "Support/formation, accompagnement des équipes et amélioration continue du produit",
      "Mise en place/optimisation de pipelines CI/CD avec contraintes sécurité",
    ],
    stack: ["Azure", "Azure DevOps", "Terraform", "PowerShell", "Kubernetes", "ServiceNow"],
  },
  {
    period: "2022–2024 · 2 ans",
    client: "Société Générale (Skynet)",
    clientLogo: "/company_logo/SG.png",
    role: "Cloud & DevOps Engineer — Team Lead & PO",
    summary:
      "Pilotage produit et delivery d’un socle de sécurité Azure: gouvernance, automatisation, conformité et exploitation.",
    bullets: [
      "Gestion d’équipe (développement PowerShell), organisation et suivi",
      "Déploiement des règles de sécurité Azure (Policy, Entra ID, Automation Account, Log Analytics…)",
      "Supervision/optimisation de l’infrastructure et gestion Agile",
    ],
    stack: ["Azure", "PowerShell", "Terraform", "Jenkins", "JIRA", "CMMI"],
  },
  {
    period: "2021–2022 · 6 mois",
    client: "Devoteam (Alfun)",
    role: "Cloud & DevOps Engineer — Azure",
    summary:
      "Automatisation de tâches récurrentes (gain de temps, fiabilité), intégration des contraintes sécurité et pont M365 ↔ Azure.",
    bullets: [
      "Scripts/outils d’automatisation (réduction des tâches manuelles)",
      "Sécurité dès la conception + conformité aux politiques internes",
      "Intégration M365 (SharePoint, Teams, OneDrive) avec Azure",
    ],
    stack: ["Azure", "PowerShell", "Azure DevOps", "JIRA", "Git", "M365"],
  },
  {
    period: "2020–2021 · 5 mois",
    client: "Bouygues Telecom",
    clientLogo: "/company_logo/Bouygues.png",
    role: "Designer UX & Développeur FullStack",
    summary:
      "Création d’un outil pour aider une équipe à piloter l’agilité et améliorer la gestion des offres mobiles/box, avec une vision globale de l’avancement.",
    bullets: [
      "Définition et analyse des besoins utilisateurs en contexte Agile",
      "Traduction des besoins en spécifications fonctionnelles claires",
      "Mise en place de réunions d’idéation et animation de sessions de brainstorming",
      "Conception de maquettes et prototypes (itérations selon retours utilisateurs/équipe)",
      "Développement d’un dashboard (front Angular, back Node) et intégration de sources de données",
    ],
    stack: ["TypeScript", "Angular", "Node.js", "Figma", "Adobe XD", "JIRA"],
  },
];

// Les logos de la pile technique. Ils passent par astro:assets : sortis en WebP
// de 256px au lieu des PNG d'origine, ou azure.png pesait a lui seul 698 Ko pour
// 1,1 Mo au total. 256px suffit largement, le morphing echantillonne a ~202px.
const brut = [
  { src: logoAzure, nom: "Azure", role: "Cloud" },
  { src: logoTerraform, nom: "Terraform", role: "Infra as code" },
  { src: logoKube, nom: "Kubernetes", role: "Orchestration" },
  { src: logoDocker, nom: "Docker", role: "Conteneurs" },
  { src: logoGit, nom: "GitHub", role: "Sources" },
  { src: logoAdo, nom: "Azure DevOps", role: "CI / CD" },
  { src: logoVscode, nom: "VS Code", role: "Poste de travail" },
];
const outils = await Promise.all(
  brut.map(async (o) => ({
    nom: o.nom,
    role: o.role,
    src: (await getImage({ src: o.src, width: 256, format: "webp" })).src,
  }))
);

const other = {
  languages: [{ k: "Anglais", v: "Courant (TOEIC 830)" }],
  // Reperes DERIVES des donnees deja presentes plus haut dans ce fichier, pas
  // ajoutes de nulle part : le nombre de clients vient de `missions`, les roles
  // sont ceux qui figurent deja dans les missions (Team Lead & PO sur Societe
  // Generale, Designer UX & Developpeur FullStack sur Bouygues), et 2020 est
  // l'annee de la mission la plus ancienne. Les secteurs sont la seule
  // inference : ils qualifient les clients listes, ils ne sont ecrits nulle
  // part ailleurs.
  reperes: [
    { k: "Clients", v: `${missions.length} depuis 2020` },
    { k: "Rôles", v: "Ingénieur · Team Lead · Product Owner" },
    { k: "Secteurs", v: "Énergie · Banque · Fintech · Télécom · Environnement" },
  ],
  notes: [
    "J’aime les environnements complexes et la qualité d’exécution (clarté, standards, sécurité).",
    "Je privilégie la documentation courte, utile, et des templates réutilisables pour accélérer les équipes.",
  ],
};
---

<Layout
  title={profile.title}
  description={profile.subtitle}
  mainClass="page editorial"
>
  {/* Ouverture au rythme de celle de l'accueil : de petits faits d'abord, qui
      donnent envie de lire, puis le titre bord a bord qui accroche l'oeil, puis
      une seule ligne — la phrase d'intention a gauche, le lien vers la suite a
      droite. Avant, la page ouvrait directement sur un mur d'information. */}
  <section class="ouverture">
    <div class="meta-row" data-reveal data-groupe="tete">
      <span>
        <b>{missions.length}</b> missions &middot; <b>{certifications.length}</b> certifications
      </span>
      <span>Ingénieur Cloud &amp; DevOps &middot; <b>+4</b> ans</span>
    </div>

    <h1 class="titre-geant" data-reveal data-groupe="tete">{profile.title}</h1>

    <div class="ouverture-pied" data-reveal data-groupe="tete">
      <div class="ouverture-texte">
        <p>{profile.subtitle}</p>
        <div class="reperes">
          {
            profile.stats.map((s) => (
              <div class="repere">
                <span class="repere-k">{s.k}</span>
                <span class="repere-v">{s.v}</span>
              </div>
            ))
          }
        </div>
        <a class="jump" href="#missions">Voir les missions &#8595;</a>
      </div>
      <figure class="ouverture-media">
        <Image src={photoPro} alt="Nabil Chebili" width={720} densities={[1, 2]} />
      </figure>
    </div>
  </section>

  <section>
    <div class="section-head grande" data-reveal data-groupe="apport">
      <span><i class="section-num">01</i> Ce que j’apporte</span>
      <span>({expertise.length})</span>
    </div>
    <div class="apport">
      <div class="prose" data-reveal data-groupe="apport">
        <p>
          Je conçois et j’industrialise des plateformes cloud sécurisées, en
          mettant l’accent sur la fiabilité, la gouvernance et la fluidité des
          livraisons. Mon objectif est simple&nbsp;: permettre aux équipes de
          construire et déployer en confiance, avec des standards clairs.
        </p>
      </div>
      <div class="colonnes">
        {
          expertise.map((x) => (
            <article class="bloc" data-reveal data-groupe="expertise">
              <h3>{x.title}</h3>
              <p>{x.desc}</p>
              <ul class="etiquettes" aria-label="Compétences">
                {x.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* L'animation a maintenant son chapitre, en face de la liste des outils dont
      l'element courant s'allume avec elle. Elle n'illustre plus rien de vague
      dans un coin : elle EST le contenu de ce chapitre, et elle sert a le lire. */}
  <section id="outils">
    <div class="section-head grande" data-reveal data-groupe="outils">
      <span><i class="section-num">02</i> Outils</span>
      <span>({outils.length})</span>
    </div>
    <div class="outils" data-reveal data-groupe="outils">
      <figure class="outils-bloc">
        <canvas id="outils-scene" data-outils={JSON.stringify(outils)} aria-hidden="true"
        ></canvas>
      </figure>
      <ul class="outils-liste" id="outils-liste">
        {
          outils.map((o) => (
            <li data-nom={o.nom}>
              <span>{o.nom}</span>
              <span class="outils-role">{o.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="missions">
    <div class="section-head grande" data-reveal data-groupe="missions">
      <span><i class="section-num">03</i> Missions</span>
      <span>({missions.length})</span>
    </div>
    <div class="missions">
      {
        missions.map((m) => (
          <article class="mission" data-reveal data-groupe="missions">
            <div class="mission-meta">
              <span class="mission-periode">{m.period.replace(" (mission active)", "")}</span>
              <span class="mission-client">{m.client}</span>
              {m.clientLogo ? (
                <img class="mission-logo" src={m.clientLogo} alt={"Logo " + m.client} loading="lazy" />
              ) : null}
              {m.period.includes("active") ? <span class="mission-encours">En cours</span> : null}
              <span class="rail-titre">Stack</span>
              <ul class="rail-liste">
                {m.stack.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <div class="mission-corps">
              <h3>{m.role}</h3>
              <p>{m.summary}</p>
              <ul class="puces">
                {m.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head grande" data-reveal data-groupe="certifs">
      <span><i class="section-num">04</i> Certifications</span>
      <span>({certifications.length})</span>
    </div>
    <div class="certifs">
      {
        certifications.map((c) => (
          <div class="certif" data-reveal data-groupe="certifs">
            <span class="certif-nom">{c.name}</span>
            <span class="certif-detail">{c.detail}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head grande" data-reveal data-groupe="reperes">
      <span><i class="section-num">05</i> Quelques repères</span>
      <span>({other.languages.length + other.reperes.length + 1})</span>
    </div>
    <div class="certifs">
      {
        [...other.languages, ...other.reperes].map((l) => (
          <div class="certif" data-reveal data-groupe="reperes">
            <span class="certif-nom">{l.k}</span>
            <span class="certif-detail">{l.v}</span>
          </div>
        ))
      }
      <div class="certif" data-reveal data-groupe="reperes">
        <span class="certif-nom">Approche</span>
        <div class="notes">
          {other.notes.map((n) => <p>{n}</p>)}
        </div>
      </div>
    </div>
  </section>

  <Colophon />

  <script>
    import { morphOutils } from "../scripts/morphOutils.js";

    const toile = document.getElementById("outils-scene");
    if (toile) {
      const outils = JSON.parse(toile.dataset.outils);
      const liste = document.getElementById("outils-liste");
      const chapitre = document.getElementById("outils");

      // L'element courant de la liste s'allume avec l'animation : c'est ce qui
      // relie le morphing au contenu au lieu d'en faire un ornement.
      const allumer = (nom) => {
        if (!liste) return;
        for (const li of liste.children) {
          li.classList.toggle("actif", li.dataset.nom === nom);
        }
      };

      // La toile epouse la largeur de sa piste de grille, plafonnee a 400px : la
      // composition est en O(L²) et au-dela la cadence tombait de 60 a 34
      // images/s. On lit la piste resolue et non la boite du bloc, dont la
      // largeur depend de la toile qu'elle contient — la mesure serait circulaire.
      const calculer = () => {
        // Depuis le viewport, PAS depuis la piste de grille : celle-ci est en
        // max-content, donc sa largeur est celle de la toile qu'elle contient.
        // La mesure serait circulaire et la toile resterait a sa taille par
        // defaut de 300px.
        const l = document.documentElement.clientWidth;
        return Math.round(Math.max(240, Math.min(400, l * 0.28)));
      };

      let taille = calculer();
      let arreter = null;

      // Le morphing ne demarre qu'a l'arrivee du chapitre dans la fenetre, pas
      // au chargement de la page. Avant, le premier logo se formait pendant que
      // le lecteur lisait encore l'ouverture, 1000px plus haut : ce premier
      // instant — le seul moment ou une forme nait du vide plutot que d'en
      // succeder une autre — se jouait toujours hors champ. Le declencher a
      // l'arrivee en fait un temps fort du defilement plutot qu'un minuteur
      // arbitraire, et economise le calcul tant que personne ne le voit — le
      // meme rootMargin que le systeme de revelation (header.astro) pour que le
      // chapitre s'anime au moment ou son contenu apparait, pas avant ni apres.
      const demarrer = async () => {
        if (arreter) return;
        arreter = (await morphOutils(toile, taille, outils, allumer)) || (() => {});
      };

      if (chapitre && "IntersectionObserver" in window) {
        const dio = new IntersectionObserver(
          (entrees) => {
            entrees.forEach((e) => {
              if (!e.isIntersecting) return;
              dio.unobserve(e.target);
              demarrer();
            });
          },
          { rootMargin: "0px 0px -120px 0px", threshold: 0 }
        );
        dio.observe(chapitre);
      } else {
        demarrer();
      }

      let minuteur = 0;
      addEventListener("resize", () => {
        clearTimeout(minuteur);
        minuteur = setTimeout(async () => {
          const t = calculer();
          if (Math.abs(t - taille) < 8) return;
          taille = t;
          // Pas encore demarre (chapitre jamais atteint) : la nouvelle taille
          // sera prise en compte au premier passage dans la fenetre.
          if (!arreter) return;
          arreter();
          arreter = (await morphOutils(toile, taille, outils, allumer)) || (() => {});
        }, 250);
      });
    }
  </script>
</Layout>

<style>
  /* ------------------------------------------------------------ ouverture ---
     Reprend le registre de l'accueil : le titre bord a bord est l'unique moment
     display de la page, sa taille pilotee par la largeur du viewport et non par
     l'echelle de pas. Les regles sont locales a cette page : celles de l'accueil
     vivent dans home-editorial.css et n'ont pas a etre partagees pour l'instant. */
  .ouverture {
    overflow: clip;
    padding: 8px var(--edge) 0;
  }
  .titre-geant {
    overflow: clip;
    margin: 26px 0 0;
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    /* Le 18,7vw de l'accueil coupait ce titre : « CLOUD DEVOPS » fait 5,356
       fois son corps en largeur contre 4,927 pour « NABIL CHEBILI » — des O, U
       et D contre des I et L. A 1440px, 82px depassaient et le S final etait
       rogne. On divise donc la largeur DISPONIBLE (viewport moins les deux
       retraits de bord) par ce rapport mesure : le titre tient exactement, a
       toute largeur.
       Diviseur porte de 5,4 a 7,8 pour suivre la meme reduction que le titre
       de l'accueil (18,7vw -> 13vw, environ -30%) : a 1440px le titre passe de
       252px a 174px. Le rapport texte/corps (5,356) ne change pas, donc la
       marge de non-rognage grandit d'autant — aucun risque de recoupe. */
    font-size: clamp(44px, calc((100vw - 2 * var(--edge)) / 7.8), 300px);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  /* La photo passe a droite, dans le meme dispositif que le bloc « qui je suis »
     de l'accueil : deux colonnes, la seconde fixe a 360px, le visuel dans un
     cadre a fond --block avec 20px de marge interieure.
     Pleine largeur, la photo etait inutilisable : le fichier source ne fait que
     800x408, donc a 1440 elle etait interpolee 1,8x et le flou se voyait sur les
     lattes de bois. Dans une colonne de 360px (soit 320px d'image), elle est
     rendue en dessous de sa resolution natale — nette, et le vide a droite de la
     phrase d'intention se remplit du meme coup. */
  .ouverture-pied {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 52px;
    /* `start` et non `center` comme sur l'accueil : la-bas le texte est un
       paragraphe entier, donc les deux colonnes ont des hauteurs comparables.
       Ici l'intro fait trois lignes contre 280px de photo — centre, le texte
       descendait au milieu de la rangee et creusait un vide sous le titre. */
    align-items: start;
    margin-top: 22px;
    padding-bottom: 4px;
  }
  .ouverture-texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--pas-3);
  }
  .ouverture-media {
    box-sizing: border-box;
    justify-self: end;
    width: 100%;
    max-width: 360px;
    margin: 0;
    /* Mat a l'encre plutot qu'en --block : le gris clair lisait comme un
       gabarit. Le noir donne au portrait le poids d'un tirage encadre, et il
       apporte a la page son premier aplat fonce — donc il repond aussi au
       « trop blanc », sans rien enfreindre : c'est un aplat de couleur, pas un
       degrade, pas une lueur, pas une ombre. */
    background: var(--ink);
    padding: 20px;
  }
  .ouverture-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .ouverture-pied p {
    margin: 0;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-55);
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
  }

  /* Le texte de LECTURE passe en Sofia Sans ; le mono reste aux ETIQUETTES.
     C'est la distinction qui rend le changement intentionnel plutot qu'une
     simple substitution de police : tout ce qui se lit en phrases (intro de
     chapitre, descriptions, resumes de mission, puces, details de
     certification, notes) prend la meme fonte que la phrase sous le titre, et
     tout ce qui sert de reperage (meta-row, libelles des reperes, STACK,
     periodes, numeros de chapitre, tags, roles des outils) garde le mono. */
  /* Le paragraphe d'ouverture du chapitre 01 est un CHAPEAU, pas du corps de
     texte : en typographie editoriale un chapeau se compose plus grand que le
     corps qu'il introduit. 19px au lieu de 15 le distingue des descriptions de
     colonne en dessous, qui restent a 15px — la taille de corps documentee
     dans DESIGN.md §1. 19px avait ete essaye d'abord : juge trop gros. Elargir les deux ensemble n'aurait rien hierarchise et
     aurait desaccorde ce chapitre du reste de la page, ou tout le corps de
     lecture (resumes de mission, puces, notes) tient a 15px.

     ATTENTION, mesure a corriger un jour : `max-width: 68ch` ne donne PAS 68
     caracteres par ligne. Le `ch` vaut la largeur du glyphe « 0 », bien plus
     large que l'avance moyenne d'un caractere en Sofia Sans (10,2px contre
     7,0px a 17px). Mesure reelle : 99 caracteres par ligne pour ce chapeau, et
     90 pour les resumes de mission — au-dela des 45-75 de Bringhurst cites en
     DESIGN.md §8 et des « moins de 90 » annonces en §1. Le defaut PRE-EXISTE
     et ne vient pas de la taille : `ch` suit la police, donc le nombre de
     caracteres par ligne est le meme a 15px qu'a 17px. Pour viser 72
     caracteres il faudrait environ `max-width: 50ch`. Non corrige ici : cela
     resserrerait la colonne de 694 a ~505px et change la mise en page, donc
     c'est une decision a prendre, pas un ajustement. */
  .prose {
    font-size: 17px;
    line-height: 1.45;
  }

  .prose p,
  .bloc p,
  .mission-corps h3,
  .mission-corps p,
  .puces,
  .certif-detail,
  .notes p {
    font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
  }

  /* Trois blocs pleins, pas des filets. Le dispositif precedent portait un
     `border-left` SUR LA BOITE, suivi de 48px de rembourrage interieur : le
     trait se collait donc au bloc precedent puis laissait un grand vide avant
     son propre texte. D'ou les deux defauts signales — « un gros espace » et
     « un trait bizarre » — qui n'en font qu'un : le trait n'etait pas au
     milieu de l'ecart, il etait tout au bord.

     Une grille de trois colonnes egales avec un ecart unique regle la
     repartition, et le fond --block remplace le trait : c'est le meme jeton que
     le cadre de la photo juste au-dessus, donc le bas de l'ouverture rime avec
     elle au lieu d'introduire un troisieme vocabulaire.

     Historique, pour ne pas y revenir : trois colonnes egales SANS fond
     donnaient l'air aligne a gauche sans l'etre (les valeurs font 103, 210 et
     227px, donc chacune se collait a gauche de son tiers) ; centrer en bloc
     reglait la symetrie mais ne formait pas un ensemble. Un fond resout les
     deux : la boite occupe tout son tiers, donc la repartition se voit meme
     quand le texte est court. */
  /* `auto-fit` plutot que trois colonnes fixes avec des seuils devines. Les
     reperes vivent dans la colonne de gauche, dont la largeur est le viewport
     MOINS la photo (360px), l'ecart (52px) et les deux bords (80px) : 948px a
     1440, mais seulement 408px a 900. Avec des seuils fixes, la mesure a montre
     du texte tronque entre 701 et 900px — deux colonnes n'y laissaient que
     154px utiles pour « AGILE (SCRUM/SAFE) » qui en fait 227.
     280px = 227px de texte le plus large + les 40px de rembourrage + du jeu.
     La grille compte elle-meme combien de colonnes tiennent, a toute largeur et
     quel que soit l'espace que prend la photo. `min(..., 100%)` evite le
     debordement quand le conteneur est plus etroit que le minimum. */
  .reperes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 20px;
    width: 100%;
  }
  .repere {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--block);
    padding: 18px 20px;
  }
  .repere-k {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .repere-v {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* --------------------------------------------------------------- outils ---
     La toile a gauche, calee sur le bord comme tout le reste de la page, et la
     liste en face. L'element courant s'allume : le morphing sert alors a lire
     la liste au lieu de decorer un coin. */
  .outils {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--pas-6);
    align-items: center;
    padding: var(--pas-3) var(--edge) 0;
  }
  .outils-bloc {
    margin: 0;
  }
  #outils-scene {
    display: block;
  }
  .outils-liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .outils-liste li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 7px 0;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-55);
    transition: color var(--duree) var(--sortie),
      border-top-color var(--duree) var(--sortie);
  }
  .outils-liste li:first-child {
    border-top-color: var(--ink);
  }
  .outils-liste li.actif {
    color: var(--ink);
    border-top-color: var(--ink);
  }
  .outils-role {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    /* Pas --rule : #c9c9c4 sur le papier ne donne que 1,51:1 de contraste, et
       ce libelle fait 10px. #6e6e68 monte a 4,67:1 tout en restant plus clair
       que --ink-55, donc la hierarchie nom / role tient sans sacrifier la
       lisibilite. */
    color: #6e6e68;
    transition: color var(--duree) var(--sortie);
  }
  .outils-liste li.actif .outils-role {
    color: var(--ink);
  }

  /* La barre du haut est fixe sur 64px : sans cette marge, une ancre depose le
     titre du chapitre DERRIERE elle. Le lien « Voir les missions » atterrissait
     sur un « 03 Missions » a moitie masque. */
  #outils,
  #missions {
    scroll-margin-top: 88px;
  }

  /* L'air avant le colophon etait porte par `.notes`, qui n'est plus un bloc
     pleine largeur mais le contenu d'une ligne du rail. Il passe donc sur le
     conteneur du chapitre.
     `:has(.notes)` et non `section:last-of-type` : le colophon est lui aussi
     une <section>, donc `last-of-type` visait le colophon et la regle ne
     s'appliquait nulle part — mesure a l'appui, il restait 14px avant le filet
     au lieu des 64 voulus. */
  .certifs:has(.notes) {
    padding-bottom: var(--pas-8);
  }

  /* ------------------------------------------------------- ce que j'apporte --- */
  .apport,
  .missions,
  .certifs {
    padding: var(--pas-3) var(--edge) 0;
  }
  .colonnes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: var(--pas-6);
  }
  .bloc {
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .bloc h3 {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .bloc p {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  /* Etiquettes : un filet, aucun rayon, aucun fond. */
  .etiquettes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .etiquettes li {
    padding: 3px 7px;
    border: 1px solid var(--rule);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  /* ------------------------------------------------------------- le rail ---
     Une seule mesure de colonne de gauche, 260px, partagee par les missions et
     les certifications : les deux sections s'alignent verticalement et la marge
     de droite devient constante. */
  .rail-titre {
    margin-top: var(--pas-3);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  /* Les outils de la mission passent en etiquettes qui s'enroulent, au lieu
     d'une liste verticale. La grille etire les deux colonnes a la meme hauteur,
     et six items empiles rendaient le rail gauche systematiquement plus long
     que le corps : mesure, cela laissait 107px de vide moyen sous le texte de
     droite, jusqu'a 153px.

     Piege evite au passage : deplacer STACK dans la colonne de droite semblait
     supprimer le vide (0px mesure), mais la premiere metrique ne regardait que
     le cote droit. En mesurant les DEUX colonnes, ce deplacement creusait en
     fait 151px de vide a GAUCHE — il ne supprimait rien, il deplacait. Les
     etiquettes, elles, raccourcissent reellement le rail : 57px a droite, 2px a
     gauche, et la page perd 334px. */
  .rail-liste {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--ink);
  }
  .rail-liste li {
    border: 1px solid var(--rule);
    padding: 3px 8px;
  }

  /* Missions : la periode et le client a gauche, le detail a droite, un filet
     par entree. C'est la mise en page d'un CV imprime. */
  .mission {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--pas-6);
    padding: var(--pas-3) 0 var(--pas-8);
    border-top: 1px solid var(--rule);
  }
  /* La premiere entree n'a pas de filet : celui de l'en-tete de section est
     juste au-dessus, les deux se lisaient comme un doublon. */
  .mission:first-of-type,
  .certif:first-of-type {
    border-top: 0;
  }
  .mission-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .mission-periode {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-55);
  }
  .mission-client {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }
  /* Un seul point d'accroche dans une liste de sept blocs identiques : l'oeil a
     besoin d'un endroit ou se poser. */
  .mission-encours {
    margin-top: 4px;
    padding: 3px 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  /* Boite bornee plutot que fente fixe. Un creneau de 84x20 en `contain`
     ramenait le logo RTE, presque carre, a 20px de cote : il se lisait comme un
     point. En bornant les deux dimensions et en laissant le ratio naturel, un
     logo large est plafonne en largeur et un logo carre garde sa hauteur — les
     deux restent lisibles sans qu'aucun ecrase l'autre. */
  .mission-logo {
    display: block;
    width: auto;
    height: auto;
    max-width: 108px;
    max-height: 30px;
    margin-top: 10px;
  }
  :global(.reveal-ok) .mission-logo {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--duree-longue) var(--sortie),
      transform var(--duree-longue) var(--sortie);
    transition-delay: 260ms;
  }
  :global(.reveal-ok) [data-reveal].vu .mission-logo {
    opacity: 1;
    transform: none;
  }
  .mission-corps h3 {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }
  .mission-corps p {
    margin: 0 0 12px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }
  .puces {
    margin: 0 0 14px;
    padding-left: 18px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }
  .puces li {
    margin-bottom: 4px;
  }
  .puces.large {
    margin: 0;
  }
  .puces strong {
    color: var(--ink);
    font-weight: 700;
  }

  /* Certifications : une liste sur le rail, pas une grille. Quatre codes courts
     et un libelle long ne tiennent pas dans une grille reguliere. */
  .certif {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--pas-6);
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .certif-nom {
    font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .certif-detail {
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-55);
  }

  /* Le chapitre 05 portait deux natures de contenu sous un seul en-tete, sans
     dire laquelle est laquelle : une competence mesurable (Anglais, TOEIC 830)
     et deux enonces de methode. Pire, « Anglais » heritait des classes des
     certifications du chapitre 04, donc une langue avait exactement l'allure
     d'une certification, et les deux phrases arrivaient derriere un filet sans
     etiquette.

     Les deux blocs sont maintenant des lignes du meme rail, chacune nommee par
     sa colonne de gauche : ANGLAIS d'un cote, APPROCHE de l'autre. La colonne
     de gauche devient une vraie colonne d'etiquettes et le lecteur sait a
     chaque ligne ce qu'il regarde. Aucun vocabulaire nouveau : c'est la grille
     `.certif` deja en place.

     Les notes s'empilent au lieu de tenir sur deux colonnes : elles occupent
     desormais la colonne de droite d'une ligne, pas la pleine largeur. */
  .notes {
    display: grid;
    gap: 10px;
  }
  .notes p {
    margin: 0;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-55);
  }

  /* Plus d'air entre les chapitres : la page donnait l'impression d'etre
     compactee, sans respiration entre les blocs d'information. */
  .section-head.grande {
    margin-top: var(--pas-10);
  }

  @media (max-width: 1100px) {
    .outils {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: var(--pas-3);
    }
    .outils-liste {
      width: 100%;
      max-width: 400px;
    }
  }
  @media (max-width: 1100px) {
    .colonnes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 800px) {
    .mission,
    .certif {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pas-3);
    }
    .certif {
      gap: 4px;
    }
  }
  /* Les blocs peuvent retrecir sans deborder (le texte se replie a l'interieur),
     donc plus besoin du seuil de 780px qu'imposait la bande en une seule ligne.
     Deux colonnes des que trois deviennent trop etroites, puis une seule. */

  @media (max-width: 700px) {
    .colonnes {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pas-3);
    }
    .notes {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pas-3);
    }
    .ouverture-pied {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--pas-3);
    }
    .ouverture-media {
      justify-self: start;
    }
    .section-head.grande {
      margin-top: var(--pas-8);
    }
  }
</style>
