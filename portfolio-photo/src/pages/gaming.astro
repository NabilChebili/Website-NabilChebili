---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import Colophon from "../components/Colophon.astro";

/* Relevé local, arrêté au 25/08/2026 : localconfig.vdf et appmanifest_*.acf pour
   Steam, manifestes Epic, RiotClientInstalls.json, GOG, .minecraft, et la
   collection de scènes OBS pour ce qui touche au direct.

   La page vend la chaîne, pas le compteur d'heures : les chiffres ne sont là que
   pour appuyer une idée — on n'y joue jamais seul. */

const TWITCH = "https://www.twitch.tv/nabsland";

/* Le défilé du haut : tout ce qui est passé sur cette machine, sans hiérarchie.
   C'est le seul moment de la page — un mur de titres qui ne s'arrête pas. */
const defile = [
	[
		"League of Legends", "Rocket League", "Phasmophobia", "Counter-Strike 2",
		"Minecraft", "Lethal Company", "Among Us", "Valorant", "Fall Guys",
		"Satisfactory", "Garry's Mod", "Content Warning", "Halo Infinite",
		"Brawlhalla", "Overcooked! 2", "Escape the Backrooms", "PEAK",
		"Street Fighter 6", "Teamfight Tactics", "Golf With Your Friends",
		"Chained Together", "DEVOUR", "Portal 2", "Unrailed!", "Moving Out",
		"Demonologist", "Trackmania",
	],
	[
		"Escape Simulator", "The Escapists 2", "Labyrinthine", "Battlefield 6",
		"Ready or Not", "Destiny 2", "Warframe", "Paladins", "SMITE",
		"Lost Ark", "V Rising", "shapez 2", "Civilization VI", "Bendy and the Ink Machine",
		"Orcs Must Die! 3", "Escape Academy", "Doors – Paradox", "PANICORE",
		"Inside the Backrooms", "Backrooms : Escape Together", "Golf It!",
		"Fear the Spotlight", "Sonic Mania", "Toribash", "Besiege", "BroForce",
	],
	[
		"Half-Life: Alyx", "Death Stranding", "The Last of Us Part II",
		"Ghost of Tsushima", "Until Dawn", "A Plague Tale: Requiem",
		"Horizon Zero Dawn", "Kena: Bridge of Spirits", "Ghostrunner 2",
		"Crusader Kings III", "The Sims 4", "FIFA", "Rayman Legends",
		"Ghost Recon Wildlands", "Call of Duty: Modern Warfare", "Just Cause 3",
		"REANIMAL", "Escape Simulator 2", "CloverPit", "911 Operator",
		"Halo: Campaign Evolved", "Delta Force", "Throne and Liberty",
	],
];

const chaine = [
	{ k: "En direct depuis", v: "Avril 2020" },
	{ k: "Abonnés", v: "151" },
	{ k: "Scènes montées", v: "9" },
	{ k: "Dernier passage", v: "Halo" },
];

/* Ce qui tourne le plus en direct — l'ordre est celui du temps de jeu, mais la
   page ne l'affiche pas comme un palmarès. */
const auProgramme = [
	{ nom: "League of Legends", note: "Salé#9891 — la plus vieille habitude, jouée hier soir encore" },
	{ nom: "Rocket League", note: "2 440 h au compteur. Des voitures, une balle, aucun plafond" },
	{ nom: "Horreur coopérative", note: "Phasmophobia, Lethal Company, Content Warning — l'intérêt n'est pas d'avoir peur, c'est d'entendre les autres avoir peur" },
	{ nom: "Le reste", note: "Party games, salles d'énigmes, retours en arrière sur des jeux Xbox 360" },
];

const ensemble = [
	{ nom: "Phasmophobia", h: "177 h" },
	{ nom: "Among Us", h: "79 h" },
	{ nom: "Fall Guys", h: "72 h" },
	{ nom: "Lethal Company", h: "44 h" },
	{ nom: "Content Warning", h: "22 h" },
	{ nom: "Escape the Backrooms", h: "17 h" },
	{ nom: "PEAK", h: "17 h" },
	{ nom: "Escape Simulator", h: "14 h" },
	{ nom: "Portal 2", h: "11 h" },
	{ nom: "Unrailed!", h: "9,8 h" },
	{ nom: "Chained Together", h: "9,6 h" },
	{ nom: "Golf With Your Friends", h: "GOG" },
];

/* Compte tenu a partir du tableau, pas ecrit en dur : le libelle du bandeau
   suivait sinon a la main chaque titre ajoute au defile. */
const nbTitres = defile.flat().length;

const jalons = [
	{ an: "2015", fait: "Minecraft en 1.8.9, et les premières heures de Rocket League" },
	{ an: "2020", fait: "Ouverture de la chaîne Twitch, en avril" },
	{ an: "2024", fait: "Montage des VOD, passage au format vertical pour TikTok" },
	{ an: "2026", fait: "13 versions de Minecraft installées, jusqu'aux instantanés de la 26.3" },
];
---

<Layout
	title="Gaming"
	description="NabsLand sur Twitch : du League of Legends, du Rocket League et de l'horreur coopérative — en direct depuis 2020, et toujours à plusieurs."
	mainClass="page editorial"
>
	<section class="tete-page">
		{/* La chaine est annoncee avant le titre : c'est ce que la page vend, et
		    le mot « Gaming » seul ne le dit pas. */}
		<div class="meta-row meta-tete" data-reveal data-groupe="tete">
			<span>Twitch &middot; <b>NabsLand</b></span>
			<span><b>151</b> abonnés &middot; en direct depuis <b>2020</b></span>
		</div>
		<h1 class="titre-page" data-reveal data-groupe="tete">Gaming</h1>
		<div class="prose" data-reveal data-groupe="tete">
			<p>
				Je joue depuis toujours, mais ce n'est jamais vraiment le jeu qui m'a
				retenu — c'est les gens avec qui j'y joue. Des amis de longue date, et
				beaucoup d'autres croisés en chemin : une bonne partie des gens que je
				connais aujourd'hui, je les ai rencontrés dans une partie.
			</p>
			<p>
				Depuis avril 2020, ça se passe en direct sur Twitch, sous le nom de
				<b>NabsLand</b> : League of Legends, Rocket League, et beaucoup de jeux
				d'horreur à plusieurs.
			</p>
		</div>
		<a class="bouton bouton-tete" href={TWITCH} target="_blank" rel="noopener"
			data-reveal data-groupe="tete">Regarder la chaîne &#8599;</a>
	</section>

	{/* --------------------------------------------------------------- defile ---
	    Le moment de la page. Tout ce qui est passé sur cette machine défile en
	    continu, sans classement et sans chiffre : la quantité est le propos, pas
	    le palmarès. Trois rangs, deux sens, trois vitesses.

	    La bande sort du retrait --edge — c'est la seule rupture de gabarit de la
	    page, et elle est volontaire : un ruban qui s'arrête à 40px du bord montre
	    le truc au lieu de donner l'impression que ça continue. */}
	<section class="defile-bloc" data-reveal data-groupe="defile">
		<div class="defile-intitule">
			<span>Tout ce qui est passé par là</span>
			<span>{nbTitres} titres</span>
		</div>

		<div class="defile">
			{
				defile.map((rang, r) => (
					<div class="defile-rang" style={`--vitesse:${[72, 88, 64][r]}s`}>
						<ul class="defile-piste">
							{rang.map((j) => (
								<li><span>{j}</span><i aria-hidden="true"></i></li>
							))}
						</ul>
						<ul class="defile-piste" aria-hidden="true">
							{rang.map((j) => (
								<li><span>{j}</span><i></i></li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section>
		<div class="section-head grande" data-reveal data-groupe="chaine">
			<span><i class="section-num">01</i>La chaîne</span>
			<span>twitch.tv/nabsland</span>
		</div>

		<div class="duo bloc-chaine">
			<div class="prose" data-reveal data-groupe="chaine">
				<p>
					La chaîne a six ans. Elle n'a jamais eu de plan de carrière : c'était au
					départ un moyen de garder le contact quand on ne pouvait plus se voir.
					Depuis, elle sert surtout à agrandir la table — il y a toujours une place
					libre en vocal, et il n'a jamais fallu être bon pour la prendre.
				</p>
				<p>
					Il y a une scène montée pour deux caméras, parce que la moitié des
					streams se fait à deux. Une autre au format vertical, pour ce qui part
					sur TikTok. Le reste — alertes, compteur d'abonnés, mur d'émoticônes —
					c'est de la cuisine interne, mais elle dit assez bien que ce n'est pas
					improvisé.
				</p>
				<p>
					<a class="lien" href={TWITCH} target="_blank" rel="noopener">Passer sur la chaîne</a>
					— et s'il m'arrive d'y poser une guitare, ça se raconte plutôt du
					<a class="lien" href="/musique">côté musique</a>.
				</p>
			</div>

			<div class="cote" data-reveal data-groupe="chaine">
				<div class="reperes reperes-cote">
					{
						chaine.map((s) => (
							<div class="repere">
								<span class="repere-k">{s.k}</span>
								<span class="repere-v">{s.v}</span>
							</div>
						))
					}
				</div>
				<a class="bouton" href={TWITCH} target="_blank" rel="noopener">Suivre NabsLand &#8599;</a>
			</div>
		</div>

		<ul class="programme">
			{
				auProgramme.map((p) => (
					<li class="programme-ligne" data-reveal data-groupe="programme">
						<span class="programme-nom">{p.nom}</span>
						<span class="programme-note">{p.note}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head grande" data-reveal data-groupe="ensemble">
			<span><i class="section-num">02</i>On n'y joue jamais seul</span>
			<span>12 titres</span>
		</div>

		<div class="prose bloc-prose" data-reveal data-groupe="ensemble">
			<p>
				Le relevé est sans appel : les jeux solo de la bibliothèque sont presque
				tous abandonnés au bout de quelques heures, pendant que les jeux à
				plusieurs se comptent en centaines. Ce n'est pas un hasard de goût, c'est
				la raison d'allumer le PC.
			</p>
			<p>
				Derrière tout ça il y a un Discord qui tourne depuis des années, où les
				habitués croisent des gens arrivés la veille. Le jeu n'est souvent qu'un
				prétexte à la salle vocale : <b>Chained Together</b> attache littéralement
				les joueurs les uns aux autres — c'est à peu près l'idée.
			</p>
		</div>

		<ul class="jeux">
			{
				ensemble.map((j) => (
					<li class="jeu" data-reveal data-groupe="ensemble-liste">
						<span class="jeu-nom">{j.nom}</span>
						<span class="jeu-h">{j.h}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head grande" data-reveal data-groupe="jalons">
			<span><i class="section-num">03</i>Ça vient de loin</span>
			<span>2015 &rarr; 2026</span>
		</div>

		<div class="prose bloc-prose" data-reveal data-groupe="jalons">
			<p>
				Onze ans de relevé, <b>4 635 heures</b> sur une centaine de titres. Ce
				n'est pas un trophée : c'est le temps qu'il a fallu pour que jouer devienne
				surtout une façon de rencontrer du monde. Les jeux ont changé bien plus
				souvent que l'envie de s'y retrouver à plusieurs.
			</p>
		</div>

		<ol class="jalons">
			{
				jalons.map((j) => (
					<li class="jalon" data-reveal data-groupe="jalons-liste">
						<span class="jalon-an">{j.an}</span>
						<span class="jalon-fait">{j.fait}</span>
					</li>
				))
			}
		</ol>
	</section>

	<Colophon />
</Layout>

<style>
	/* Le bandeau porte son propre air : .tete-page cale le titre a --pas-6 du
	   haut, et le titre a un interlignage de 0,86 qui remonte deja les capitales. */
	.meta-tete {
		margin-bottom: 18px;
	}

	.bouton-tete {
		margin-top: var(--pas-3);
	}

	.bloc-prose {
		padding: var(--pas-3) var(--edge) 0;
		margin-top: 0;
	}

	.bloc-chaine {
		grid-template-columns: minmax(0, 1fr) 420px;
	}

	/* Meme respiration que /clouddevops : a --pas-6 les chapitres se collent au
	   bloc precedent et le squelette de la page disparait. */
	.section-head.grande {
		margin-top: var(--pas-10);
	}

	/* --------------------------------------------------------------- defile ---
	   Trois rangs de titres qui glissent en continu, en sens alternes. Aucun
	   degrade, aucune ombre, aucun rayon : de la typo a l'encre et un carre de
	   3px entre deux titres.

	   La boucle tient a la duplication : deux pistes identiques cote a cote, la
	   translation courant de 0 a -50 % de la paire. Le raccord est donc invisible
	   quelle que soit la vitesse. */
	.defile-bloc {
		margin-top: var(--pas-8);
	}

	.defile {
		overflow: hidden;
	}

	.defile-intitule {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 20px;
		padding: 0 var(--edge) 9px;
		border-bottom: 1px solid var(--ink);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.defile-intitule span:last-child {
		color: var(--ink-55);
		font-weight: 500;
	}

	.defile-rang {
		display: flex;
		width: max-content;
		border-bottom: 1px solid var(--rule);
		animation: glisse var(--vitesse, 72s) linear infinite;
	}

	/* Le rang du milieu part dans l'autre sens : trois bandes qui glissent du
	   meme cote se lisent comme un seul bloc qui derive. */
	.defile-rang:nth-child(2) {
		animation-direction: reverse;
	}

	.defile-rang:last-child {
		border-bottom: 0;
	}

	.defile-piste {
		display: flex;
		align-items: center;
		flex: none;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.defile-piste li {
		display: flex;
		align-items: center;
		gap: 22px;
		padding: 14px 0;
	}

	.defile-piste li span {
		font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
		font-size: clamp(26px, 3.4vw, 46px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: var(--ink);
		white-space: nowrap;
		transition: color var(--duree) var(--sortie);
	}

	.defile-piste li i {
		flex: none;
		width: 7px;
		height: 7px;
		margin: 0 22px;
		background: var(--rule);
		transition: background var(--duree) var(--sortie);
	}

	@keyframes glisse {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	/* Au survol la bande s'arrete : un mur de 76 titres qu'on ne peut pas lire
	   est un ornement, pas une information. */
	.defile:hover .defile-rang,
	.defile:focus-within .defile-rang {
		animation-play-state: paused;
	}

	.defile-piste li:hover span {
		color: var(--ink);
	}

	.defile-piste li:hover i {
		background: var(--ink);
	}

	/* --------------------------------------------------------------- cote --- */
	.cote {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--pas-3);
	}

	.reperes-cote {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	/* ---------------------------------------------------------- programme --- */
	.programme {
		list-style: none;
		margin: 0;
		padding: var(--pas-6) var(--edge) 0;
	}

	.programme-ligne {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr);
		gap: var(--pas-6);
		align-items: baseline;
		padding: 16px 0;
		border-bottom: 1px solid var(--rule);
	}

	.programme-ligne:first-child {
		border-top: 1px solid var(--ink);
	}

	.programme-nom {
		font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
		font-size: 26px;
		font-weight: 800;
		line-height: 1.05;
		text-transform: uppercase;
		color: var(--ink);
	}

	.programme-note {
		font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
		font-size: 15px;
		line-height: 1.45;
		color: var(--ink-55);
	}

	/* ------------------------------------------------------------- listes --- */
	.jeux {
		list-style: none;
		margin: 0;
		padding: var(--pas-3) var(--edge) 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0 var(--pas-6);
	}

	.jeu {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		padding: 12px 0;
		border-bottom: 1px solid var(--rule);
	}

	.jeu-nom {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.jeu-h {
		flex: none;
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.09em;
		color: var(--ink-55);
	}

	/* ------------------------------------------------------------- jalons --- */
	.jalons {
		list-style: none;
		margin: 0;
		padding: var(--pas-3) var(--edge) 0;
	}

	.jalon {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: var(--pas-6);
		align-items: baseline;
		padding: 16px 0;
		border-bottom: 1px solid var(--rule);
	}

	.jalon:first-child {
		border-top: 1px solid var(--ink);
	}

	.jalon-an {
		font-family: "Sofia Sans Condensed", "Arial Narrow", sans-serif;
		font-size: 30px;
		font-weight: 800;
		line-height: 1;
		color: var(--ink);
	}

	.jalon-fait {
		font-family: "Sofia Sans", "Helvetica Neue", Arial, sans-serif;
		font-size: 15px;
		line-height: 1.45;
		color: var(--ink-55);
	}

	@media (max-width: 1100px) {
		.jeux {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 var(--pas-3);
		}
	}

	@media (max-width: 900px) {
		.bloc-chaine {
			grid-template-columns: minmax(0, 1fr);
		}
		/* .duo fait passer le visuel avant le texte ; ici la colonne de droite
		   porte des donnees de second rang, le texte doit garder la main. */
		.cote {
			order: 0;
		}
		.programme-ligne {
			grid-template-columns: minmax(0, 1fr);
			gap: 6px;
		}
	}

	@media (max-width: 700px) {
		.jeux {
			grid-template-columns: minmax(0, 1fr);
		}
		.jalon {
			grid-template-columns: 76px minmax(0, 1fr);
			gap: var(--pas-3);
		}
		.jalon-an {
			font-size: 22px;
		}
		.reperes-cote {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.defile-piste li {
			gap: 14px;
			padding: 10px 0;
		}
		.defile-piste li i {
			margin: 0 14px;
		}
	}

	/* Mouvement reduit : la bande s'arrete et devient defilable a la main. Sans
	   ca, 76 titres immobiles hors cadre seraient simplement inaccessibles. */
	@media (prefers-reduced-motion: reduce) {
		.defile-rang {
			animation: none;
		}
		.defile {
			overflow-x: auto;
		}
	}
</style>
