---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import Colophon from "../components/Colophon.astro";
---

<Layout
	title="Gaming"
	description="Jeux vidéo, streaming et contenus gaming — en construction."
	mainClass="page editorial"
>
	<section class="tete-page">
		<h1 class="titre-page" data-reveal data-groupe="tete">Gaming</h1>
		<div class="prose" data-reveal data-groupe="tete">
			<p>
				Travail en cours — cette page est en construction. Bientôt des retours
				sur le streaming, mes jeux favoris et quelques captures.
			</p>
			<p>
				En attendant, la galerie <a class="lien" href="/photo">Photographie</a> est
				en ligne, et le bloc Contact plus bas permet de me joindre.
			</p>
		</div>
	</section>

	<Colophon />
</Layout>
