---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/index.css";
import "../styles/home-editorial.css";
import Layout from "../layouts/header.astro";

// Les quatre univers de la page d'origine : memes titres, memes descriptions,
// memes images, memes destinations. Seule la mise en page change.
const univers = [
  {
    titre: "Cloud & DevOps",
    note: "Projets, automatisation et expérimentations autour du Cloud et de l'infrastructure.",
    href: "/clouddevops",
    img: "/nabil-ishane.jpg",
    alt: "Nabil Chebili chez I-Shane",
    width: 800,
    height: 408,
  },
  {
    titre: "Photographie",
    note: "Galeries & séries photographiques : voyages, portraits et instantanés.",
    href: "/photo",
    img: "/A7401833.jpg",
    alt: "Photographie",
    width: 2062,
    height: 1430,
  },
  {
    titre: "Musique",
    note: "Petites avancées dans le monde la guitare (autodidacte)",
    href: "/musique",
    img: "/image.png",
    alt: "Musique",
    width: 1914,
    height: 1077,
  },
  {
    titre: "Gaming",
    note: "Twitch, streaming et jeux vidéo.",
    href: "/gaming",
    img: "/twitch.png",
    alt: "Gaming",
    width: 2544,
    height: 1435,
  },
];
---

<Layout
  title="Nabil Chebili"
  description="Site personnel de Nabil Chebili : Cloud & DevOps (Azure), photographie et musique. Projets, retours d’expérience et galeries."
  webfont={true}
>
  <main class="page home">
    <section class="opening">
      <div class="meta-row">
        <span><b>958</b> photographies &middot; <b>11</b> galeries</span>
        <span>Ingénieur Cloud &amp; DevOps</span>
      </div>

      <h1 class="mega">Nabil Chebili</h1>

      <div class="opening-body">
        <div class="slashes">
          {univers.map((u) => <a href={u.href}>{u.titre}</a>)}
        </div>

        <figure class="portrait">
          <img
            src="https://stnchvlqvproduction.blob.core.windows.net/photos/Indonesie/post/A7404480.jpg"
            alt="Portrait de Nabil Chebili"
            width="2200"
            height="1467"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>

        <div class="opening-aside">
          <p>
            Cloud &amp; DevOps, photographie et musique — projets, galeries et
            inspirations.
          </p>
          <a class="jump" href="#explorer">Explorer &#8595;</a>
        </div>
      </div>
    </section>

    <section id="explorer">
      <div class="section-head">
        <span>Explorer</span>
        <span>({univers.length})</span>
      </div>
      <div class="entries">
        {
          univers.map((u) => (
            <a class="entry" href={u.href}>
              <span class="entry-meta">
                {u.titre}
                <i aria-hidden="true">&#8594;</i>
              </span>
              <span class="entry-frame">
                <img
                  src={u.img}
                  alt={u.alt}
                  width={u.width}
                  height={u.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="entry-note">{u.note}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="colophon">
      <div>
        <h2>Vous vous demandez sûrement qui je suis ?</h2>
        <p>
          Je suis quelqu’un de curieux, attiré par les choses que l’on construit
          et que l’on comprend avec le temps. J’ai toujours aimé créer, démonter
          et reconstruire, d’abord avec des Lego, aujourd’hui avec des idées, des
          systèmes ou des images. Ce qui m’intéresse autant que le résultat,
          c’est le chemin pour y arriver : observer, tester, ajuster, simplifier,
          jusqu’à ce que tout fasse sens.
        </p>
      </div>

      <div>
        <h2>Contact</h2>
        <p class="fine">
          Pour toute question, collaboration ou prise de contact rapide —
          écrivez-moi.
        </p>
        <div class="colophon-links">
          <a href="mailto:nabilchebili1999@gmail.com">
            Envoyer un email
            <i aria-hidden="true">&#8594;</i>
          </a>
          <a
            href="https://www.linkedin.com/in/chebili-nabil/"
            target="_blank"
            rel="noopener"
          >
            LinkedIn
            <i aria-hidden="true">&#8599;</i>
          </a>
        </div>
        <p class="fine fine-after">
          Je réponds généralement sous quelques heures.
        </p>
      </div>
    </section>
  </main>
</Layout>
