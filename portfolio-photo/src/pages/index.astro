---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/index.css";
import "../styles/home-apple.css";
import Layout from "../layouts/header.astro";

const blob = "https://stnchvlqvproduction.blob.core.windows.net/photos";

// Deux bandeaux en plein cadre. Le premier est un panorama natif en 2.98:1,
// donc il tient dans le cadre 2.39:1 sans perdre grand-chose ; le second est un
// 3:2 recadre par object-fit.
const bandeaux = {
  batur: {
    src: `${blob}/Indonesie/batur/A7404548.jpg`,
    alt: "Nabil Chebili à l'heure bleue au-dessus du mont Batur, en Indonésie",
    width: 2200,
    height: 738,
  },
  lave: {
    src: `${blob}/Indonesie/black-lava/A7404598.jpg`,
    alt: "Champ de lave noire au pied du mont Batur, avec des 4x4 à l'arrêt",
    width: 2200,
    height: 1067,
  },
};

const universes = [
  {
    title: "Cloud & DevOps",
    text: "Projets, automatisation et expérimentations autour du Cloud et de l'infrastructure.",
    href: "/clouddevops",
    img: "/nabil-ishane.jpg",
    alt: "Nabil Chebili chez I-Shane",
    width: 800,
    height: 408,
  },
  {
    title: "Photographie",
    text: "Galeries & séries photographiques : voyages, portraits et instantanés.",
    href: "/photo",
    img: "/A7401833.jpg",
    alt: "Photographie",
    width: 2062,
    height: 1430,
  },
  {
    title: "Musique",
    text: "Petites avancées dans le monde la guitare (autodidacte)",
    href: "/musique",
    img: "/image.png",
    alt: "Musique",
    width: 1914,
    height: 1077,
  },
  {
    title: "Gaming",
    text: "Twitch, streaming et jeux vidéo.",
    href: "/gaming",
    img: "/twitch.png",
    alt: "Gaming",
    width: 2544,
    height: 1435,
  },
];
---

<Layout
  title="Nabil Chebili"
  description="Site personnel de Nabil Chebili : Cloud & DevOps (Azure), photographie et musique. Projets, retours d’expérience et galeries."
>
  <main class="page home">
    <section class="hero apple-hero">
      <div class="container">
        <p class="apple-eyebrow">Ingénieur Cloud &amp; DevOps</p>
        <h1 class="apple-title">Nabil Chebili</h1>
        <p class="apple-lead">
          Cloud &amp; DevOps, photographie et musique — projets, galeries et
          inspirations.
        </p>
        <div class="apple-links">
          <a class="apple-link" href="/clouddevops">Cloud DevOps</a>
          <a class="apple-link" href="/photo">Photographie</a>
          <a class="apple-link" href="/musique">Musique</a>
          <a class="apple-link" href="/gaming">Gaming</a>
        </div>
      </div>
    </section>

    <section class="section band-section">
      <figure class="band band-pano opens">
        <img
          src={bandeaux.batur.src}
          alt={bandeaux.batur.alt}
          width={bandeaux.batur.width}
          height={bandeaux.batur.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="section apple-section section-tinted two-col reverse">
      <div class="container two-col-inner">
        <div class="media">
          <img
            class="settle"
            src={`${blob}/Indonesie/post/A7404480.jpg`}
            alt="Portrait de Nabil Chebili"
            width="2200"
            height="1467"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="content rise">
          <h2 class="apple-h2">Vous vous demandez sûrement qui je suis ?</h2>
          <p class="apple-body">
            Je suis quelqu’un de curieux, attiré par les choses que l’on
            construit et que l’on comprend avec le temps. J’ai toujours aimé
            créer, démonter et reconstruire, d’abord avec des Lego, aujourd’hui
            avec des idées, des systèmes ou des images. Ce qui m’intéresse autant
            que le résultat, c’est le chemin pour y arriver : observer, tester,
            ajuster, simplifier, jusqu’à ce que tout fasse sens.
          </p>
        </div>
      </div>
    </section>

    <section class="section band-section">
      <figure class="band drift opens">
        <img
          src={bandeaux.lave.src}
          alt={bandeaux.lave.alt}
          width={bandeaux.lave.width}
          height={bandeaux.lave.height}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <section class="section apple-section cards-overview">
      <div class="container">
        <h2 class="apple-h2 rise">Explorer</h2>
        <div class="apple-tiles">
          {
            universes.map((u) => (
              <a class="apple-tile rise" href={u.href}>
                <img
                  src={u.img}
                  alt={u.alt}
                  width={u.width}
                  height={u.height}
                  loading="lazy"
                  decoding="async"
                />
                <div class="apple-tile-body">
                  <h3>{u.title}</h3>
                  <p>{u.text}</p>
                  <span class="apple-link">Voir</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section apple-section section-tinted contact apple-contact">
      <div class="container">
        <div class="contact-card rise">
          <h2 class="apple-h2">Contact</h2>
          <p class="contact-lead">
            Pour toute question, collaboration ou prise de contact rapide —
            écrivez-moi.
          </p>
          <div class="apple-ctas">
            <a class="btn" href="mailto:nabilchebili1999@gmail.com"
              >Envoyer un email</a
            >
            <a
              class="btn btn-outline"
              href="https://www.linkedin.com/in/chebili-nabil/"
              target="_blank"
              rel="noopener">LinkedIn</a
            >
          </div>
          <p class="contact-note">
            Je réponds généralement sous quelques heures.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
