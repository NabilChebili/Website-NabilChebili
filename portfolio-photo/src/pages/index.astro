---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/index.css";
import "../styles/home-editorial.css";
import Layout from "../layouts/header.astro";
import indonesie from "../data/indonesie.json";
import vietnam from "../data/vietnam.json";

// Les planches de l'index sont les series "post" : des photos deja
// selectionnees et legendees dans le repo. Rien n'est choisi ni redige ici.
const planches = [
  ...indonesie.post.map((p) => ({ ...p, origine: "Indonésie" })),
  ...vietnam.post.map((p) => ({ ...p, origine: "Vietnam" })),
];

// Les quatre univers, en liste a barres obliques.
const univers = [
  { titre: "Cloud & DevOps", href: "/clouddevops" },
  { titre: "Photographie", href: "/photo" },
  { titre: "Musique", href: "/musique" },
  { titre: "Gaming", href: "/gaming" },
];
---

<Layout
  title="Nabil Chebili"
  description="Site personnel de Nabil Chebili : Cloud & DevOps (Azure), photographie et musique. Projets, retours d’expérience et galeries."
  webfont={true}
>
  <main class="page home">
    <section class="opening">
      <div class="meta-row">
        <span><b>958</b> photographies &middot; <b>11</b> galeries</span>
        <span>Ingénieur Cloud &amp; DevOps</span>
      </div>

      <h1 class="mega">Nabil Chebili</h1>

      <div class="opening-body">
        <div class="slashes">
          {univers.map((u) => <a href={u.href}>{u.titre}</a>)}
        </div>

        <figure class="portrait">
          <img
            src="https://stnchvlqvproduction.blob.core.windows.net/photos/Indonesie/post/A7404480.jpg"
            alt="Portrait de Nabil Chebili"
            width="2200"
            height="1467"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>

        <div class="opening-aside">
          <p>
            Cloud &amp; DevOps, photographie et musique — projets, galeries et
            inspirations.
          </p>
          <a class="jump" href="#planches">Explorer &#8595;</a>
        </div>
      </div>
    </section>

    <section id="planches">
      <div class="plates-head">
        <span>Photographies</span>
        <span>({planches.length})</span>
      </div>
      <div class="plates">
        {
          planches.map((p) => (
            <figure class="plate">
              <span class="plate-frame">
                <img
                  src={p.url}
                  alt={p.caption}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <figcaption>
                <b>{p.origine}</b>
                {p.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="colophon">
      <div>
        <h2>Vous vous demandez sûrement qui je suis ?</h2>
        <p>
          Je suis quelqu’un de curieux, attiré par les choses que l’on construit
          et que l’on comprend avec le temps. J’ai toujours aimé créer, démonter
          et reconstruire, d’abord avec des Lego, aujourd’hui avec des idées, des
          systèmes ou des images. Ce qui m’intéresse autant que le résultat,
          c’est le chemin pour y arriver : observer, tester, ajuster, simplifier,
          jusqu’à ce que tout fasse sens.
        </p>
      </div>

      <div>
        <h2>Contact</h2>
        <p class="fine">
          Pour toute question, collaboration ou prise de contact rapide —
          écrivez-moi.
        </p>
        <div class="colophon-links">
          <a href="mailto:nabilchebili1999@gmail.com">
            Envoyer un email
            <i aria-hidden="true">&#8594;</i>
          </a>
          <a
            href="https://www.linkedin.com/in/chebili-nabil/"
            target="_blank"
            rel="noopener"
          >
            LinkedIn
            <i aria-hidden="true">&#8599;</i>
          </a>
        </div>
        <p class="fine fine-after">
          Je réponds généralement sous quelques heures.
        </p>
      </div>
    </section>
  </main>
</Layout>
