---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import AccordionSection from "../components/AccordionSection.astro";
import indonesie from "../data/indonesie.json";
import { listGalleries } from "../lib/blobList.js";

const fallback = [
  "/photos/A7401177.jpg",
  "/photos/A7401113.jpg",
  "/photos/A7401167.jpg",
  "/photos/A7401181.jpg",
];

const photosByKey = await listGalleries(indonesie.galleries, fallback);

const labels = {
  batur: "Batur",
  "black-lava": "Black Lava",
  "falaise-lombok": "Falaise Lombok",
  gwk: "GWK",
  jitawali: "Jatiluwih",
  "lombok-village": "Village Lombok",
  "lombok-paysage": "Paysages Lombok",
  "monkey-forest": "Monkey Forest",
  "spot-insta": "Spot Insta",
  ulluwatu: "Uluwatu",
  "water-temple": "Water Temple",
};
---

<Layout
  title="Indonésie"
  description="Récit photo d'un voyage à Bali et Lombok : temples, volcans, rizières et plages."
  mainClass="page editorial"
>
  <section class="tete-page">
    <a class="retour" href="/photo">← Toutes les galeries</a>
    <h1 class="titre-page" data-reveal data-groupe="tete">Indonésie</h1>
    <div class="prose" data-reveal data-groupe="tete">
      <p>
        Bali et Lombok : temples flottants, volcans noirs, rizières en terrasses et falaises
        face à l'océan.
      </p>
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="recit">
      <span>Le récit</span>
      <span>({indonesie.post.length})</span>
    </div>
    <div class="galerie">
      <PhotoGrid photos={indonesie.post} name="Indonesie" />
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="etapes">
      <span>Les étapes du voyage</span>
      <span>({Object.keys(indonesie.galleries).length})</span>
    </div>
    <div class="etapes">
      {
        Object.keys(indonesie.galleries).map((key) => (
          <AccordionSection id={key} title={labels[key] ?? key} photos={photosByKey[key]} />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .galerie,
  .etapes {
    padding: 0 var(--edge);
  }
  .etapes {
    padding-top: var(--pas-3);
  }
</style>
