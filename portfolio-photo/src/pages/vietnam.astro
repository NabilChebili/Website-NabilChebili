---
import "../styles/global.css";
import Layout from "../layouts/header.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import AccordionSection from "../components/AccordionSection.astro";
import vietnam from "../data/vietnam.json";
import { listGalleries } from "../lib/blobList.js";

const fallback = [
  "/photos/A7401177.jpg",
  "/photos/A7401113.jpg",
  "/photos/A7401167.jpg",
  "/photos/A7401181.jpg",
];

const photosByKey = await listGalleries(vietnam.galleries, fallback);

const labels = {
  "ba-na": "Bà Nà",
  "da-nang": "Đà Nẵng",
  "festival-saigon": "Festival Saigon",
  gaming: "Gaming",
  "nha-trang": "Nha Trang",
  "phu-yen": "Phú Yên",
  "quy-nhon": "Quy Nhơn",
  saigon: "Saigon",
  tet: "Têt",
};
---

<Layout
  title="Vietnam"
  description="Récit photo d'un voyage au Vietnam : Saigon, Đà Nẵng, Nha Trang, Phú Yên et plus."
  mainClass="page editorial"
>
  <section class="tete-page">
    <a class="retour" href="/photo">← Toutes les galeries</a>
    <h1 class="titre-page" data-reveal data-groupe="tete">Vietnam</h1>
    <div class="prose" data-reveal data-groupe="tete">
      <p>
        Un mois à travers le Vietnam, du sud au centre, entre grandes villes
        bouillonnantes, côtes sauvages et fêtes du Têt.
      </p>
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="recit">
      <span>Le récit</span>
      <span>({vietnam.post.length})</span>
    </div>
    <div class="galerie">
      <PhotoGrid photos={vietnam.post} name="Vietnam" />
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="video">
      <span>La vidéo</span>
      <span>(1)</span>
    </div>
    <div class="zone-video" data-reveal data-groupe="video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/4ds0mpAiWJw"
        title="VIETNAM - 2026"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      />
    </div>
  </section>

  <section>
    <div class="section-head" data-reveal data-groupe="etapes">
      <span>Les étapes du voyage</span>
      <span>({Object.keys(vietnam.galleries).length})</span>
    </div>
    <div class="etapes">
      {
        Object.keys(vietnam.galleries).map((key) => (
          <AccordionSection id={key} title={labels[key] ?? key} photos={photosByKey[key]} />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .galerie,
  .etapes {
    padding: 0 var(--edge);
  }
  .etapes {
    padding-top: var(--pas-3);
  }

  /* Le lecteur de /musique, sans le carrousel qui va avec : il n'y a qu'une
     video ici, donc pas de fleches — et pas la reserve de 68px que /musique
     menage de chaque cote pour les loger.

     Pas non plus le plafond de hauteur de /musique. La-bas le lecteur est le
     sujet de la page et flotte seul ; ici il s'intercale entre la grille de
     photos et les etapes du voyage, deux blocs qui courent de --edge a --edge.
     Plafonne, il rentrait de 129px en 1440 et de 209 en 1920 : plus etroit que
     tout ce qui l'entoure, pour un ecart que l'oeil attrape. Sur un bloc 16:9
     on ne peut pas a la fois aligner les bords et borner la hauteur — ici
     l'alignement gagne, et la video occupe une bonne part de l'ecran. */
  .zone-video {
    padding: var(--pas-3) var(--edge) 0;
  }
  .zone-video iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    background: var(--block);
  }
</style>
